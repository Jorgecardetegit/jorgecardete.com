# Copia a .env para desarrollo; en producción, variables del proyecto en Vercel.
# Sin estas variables la web funciona igual, solo que sin enviar datos.

# Google Tag Manager (contenedor web), p. ej. GTM-XXXXXXX
PUBLIC_GTM_ID=
# PostHog (región UE): Project settings → Project API key
PUBLIC_POSTHOG_KEY=
# Dominio público; si falta, se usa el de producción de Vercel
SITE_URL=

# Newsletter (solo en servidor), p. ej. https://jorgecardete.substack.com
SUBSTACK_URL=
