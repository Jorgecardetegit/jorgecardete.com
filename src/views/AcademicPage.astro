---
import Base from '../layouts/Base.astro';
import WorldBadge from '../components/WorldBadge.astro';
import { dateFormat, l, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const me = 'Jorge Cardete';

const papers = [
  {
    title: 'How well do different chatbots respond to multiple myeloma treatment guidelines?',
    journal: 'Leukemia',
    publisher: 'Nature Portfolio',
    date: new Date('2025-04-07'),
    authors: ['Edwin Uriel Suárez', 'Fabio Torres-Saavedra', 'Amalia Domingo-González', 'Jorge Cardete', 'Pilar Llamas-Sillero'],
    note: {
      es: 'Con Edwin Uriel Suárez (Fundación Jiménez Díaz).',
      en: 'With Edwin Uriel Suárez (Fundación Jiménez Díaz).',
    },
    doi: '10.1038/s41375-025-02604-8',
  },
];

const text = {
  es: {
    title: 'Académico',
    description: 'Publicaciones académicas: How well do different chatbots respond to multiple myeloma treatment guidelines? (Leukemia, 2025).',
    badge: 'MUNDO 6 — ACADÉMICO',
    lead: 'Publicaciones revisadas por pares en las que soy coautor.',
    papers: 'Artículos',
    read: 'Leer artículo',
  },
  en: {
    title: 'Academic',
    description: 'Academic publications: How well do different chatbots respond to multiple myeloma treatment guidelines? (Leukemia, 2025).',
    badge: 'WORLD 6 — ACADEMIC',
    lead: 'Peer-reviewed publications I have co-authored.',
    papers: 'Papers',
    read: 'Read paper',
  },
}[lang];
---
<Base title={text.title} description={text.description}>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,700;1,6..72,400&display=swap" />

  <WorldBadge house="academic" lang={lang}>{text.badge}</WorldBadge>
  <h1 class="hero">{text.title}</h1>
  <p class="lead">{text.lead}</p>

  <h2 class="ac-label">{text.papers} · {papers.length}</h2>
  <ol class="papers">
    {papers.map((p) => (
      <li class="paper">
        <time class="paper-year" datetime={p.date.toISOString().slice(0, 10)}>{p.date.getFullYear()}</time>
        <div class="paper-body">
          <div class="paper-meta">
            <span class="paper-journal">{p.journal}</span>
            <span class="paper-dot">·</span>
            <span>{p.publisher}</span>
            <span class="paper-dot">·</span>
            <span>{dateFormat(lang, { month: 'long', year: 'numeric' }).format(p.date)}</span>
          </div>
          <h3 class="paper-title"><a href={`https://doi.org/${p.doi}`}>{p.title}</a></h3>
          <p class="paper-authors">
            {p.authors.map((a, i) => (
              <>{i > 0 && ', '}{a === me ? <strong>{a}</strong> : a}</>
            ))}
          </p>
          <p class="paper-note">{l(p.note, lang)}</p>
          <div class="paper-links">
            <a href={`https://doi.org/${p.doi}`}>{text.read} ↗</a>
            <span class="paper-doi">DOI {p.doi}</span>
          </div>
        </div>
      </li>
    ))}
  </ol>
</Base>
