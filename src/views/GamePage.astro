---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { projects } from '../data/projects';
import { dateFormat, l, path, postPath, useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Mismo orden y colores que las casas del mapa de la barra lateral.
const houses = [
  { route: 'about', icon: 'sobre-mi', label: t('nav.about'), color: '#6b5ea8', shade: '#584c8f' },
  { route: 'blog', icon: 'blog', label: t('nav.blog'), color: '#b5623c', shade: '#984f2f' },
  { route: 'projects', icon: 'proyectos', label: t('nav.projects'), color: '#2b9476', shade: '#217a61' },
  { route: 'startups', icon: 'startups', label: t('nav.startups'), color: '#c9a227', shade: '#a8871d' },
  { route: 'academic', icon: 'academico', label: t('nav.academic'), color: '#b5553f', shade: '#984433' },
] as const;

// Lo que se ve al entrar en cada casa: un adelanto de la sección y el enlace a la página.
type Item = { meta: string; title: string; text?: string; href?: string };
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = dateFormat(lang, { day: 'numeric', month: 'short', year: 'numeric' });
const es = lang === 'es';

const to = (route: Parameters<typeof path>[0]) => path(route, lang);

// La presentación es la misma que en /sobre-mi (sin la línea de «contacto justo debajo»).
const aboutText = es
  ? [
      `¡Hola! Soy Jorge. Me gusta construir cosas, entender cómo funcionan y aprender por el camino. Este es el lugar donde voy reuniendo <a href="${to('projects')}">proyectos</a>, ideas y aprendizajes en el <a href="${to('blog')}">blog</a>, y algunas de las <a href="${to('startups')}">startups</a> en las que estoy trabajando.`,
      'Empecé a <a href="https://medium.com/thedeephub">escribir</a> casi como una forma de ordenar lo que iba aprendiendo. Con el tiempo me di cuenta de que, cuando quieres entender muy bien un tema, una de las mejores formas de hacerlo es intentar explicárselo a los demás. 👨‍🏫',
      'Ahora mismo trabajo como Growth Engineer en <a href="https://bit2me.com/es">Bit2Me</a>. Después de muchos años programando, quiero mejorar en la otra mitad del juego: la distribución.',
      'En mi tiempo libre me gusta hacer deporte, viajar y jugar al ajedrez. Ahora mismo me estoy preparando para correr la <a href="https://www.zurichmaratobarcelona.es/">Maratón de Barcelona</a> 🏃',
    ]
  : [
      `Hi! I'm Jorge. I like building things, understanding how they work and learning along the way. This is where I gather <a href="${to('projects')}">projects</a>, ideas and learnings on the <a href="${to('blog')}">blog</a>, along with some of the <a href="${to('startups')}">startups</a> I’m working on.`,
      'I started <a href="https://medium.com/thedeephub">writing</a> almost as a way to organise what I was learning. Over time I realised that, when you want to understand a subject really well, one of the best ways is to try to explain it to others. 👨‍🏫',
      'I currently work as a Growth Engineer at <a href="https://bit2me.com/">Bit2Me</a>. After many years of writing code, I want to get better at the other half of the game: distribution.',
      'In my free time I enjoy sports, travelling and playing chess. Right now I’m training to run the <a href="https://www.zurichmaratobarcelona.es/">Barcelona Marathon</a> 🏃',
    ];

const rooms: Record<(typeof houses)[number]['route'], { lead?: string; paragraphs?: string[]; items: Item[]; photo?: boolean }> = {
  about: { photo: true, paragraphs: aboutText, items: [] },
  blog: {
    lead: es ? `${posts.length} artículos sobre IA, visión por computador y programación. Los últimos:` : `${posts.length} articles on AI, computer vision and programming. The latest:`,
    items: posts.slice(0, 3).map((p) => ({ meta: fmt.format(p.data.date), title: p.data.title, text: p.data.description, href: postPath(p.id, lang) })),
  },
  projects: {
    lead: es ? `${projects.length} proyectos, de hackathons a IA en producción. Algunos recientes:` : `${projects.length} projects, from hackathons to AI in production. Some recent ones:`,
    items: projects.slice(0, 3).map((p) => ({ meta: p.soon ? (es ? 'Próximamente' : 'Coming soon') : p.year, title: l(p.name, lang), text: l(p.desc, lang) })),
  },
  startups: {
    lead: es ? 'Cosas que he fundado o ayudado a construir desde el principio.' : 'Things I founded or helped build from day one.',
    items: [
      { meta: es ? 'Cofundador y CTO' : 'Co-founder & CTO', title: 'Grupo Cardete Ventures' },
      { meta: es ? 'Cofundador' : 'Co-founder', title: 'Zapic' },
      { meta: 'Founding engineer', title: 'Fractal' },
      { meta: es ? 'Fundador' : 'Founder', title: 'The Deep Hub' },
    ],
  },
  academic: {
    lead: es ? 'Publicaciones revisadas por pares en las que soy coautor.' : "Peer-reviewed publications I've co-authored.",
    items: [
      {
        meta: 'Leukemia · Nature Portfolio · 2025',
        title: 'How well do different chatbots respond to multiple myeloma treatment guidelines?',
        href: 'https://doi.org/10.1038/s41375-025-02604-8',
      },
    ],
  },
};
---
<Base title={t('game.title')} description={t('game.description')} sidebar={false}>
  <div class="game" id="game">
    <canvas class="game-canvas" aria-hidden="true"></canvas>

    <div class="game-layer">
      <div class="game-board">
        <h1>{t('game.welcome')}</h1>
        <p class="help-keys">{t('game.help')}</p>
        <p class="help-touch">{t('game.helpTouch')}</p>
      </div>
      <nav aria-label={t('nav.label')}>
        {houses.map((h) => (
          <a class="game-sign" href={path(h.route, lang)} data-room={h.route} data-color={h.color} data-shade={h.shade} style={`--c:${h.color}`}>
            <span class="sign-icon"><PixelIcon name={h.icon} size={30} /></span>
            <span>{h.label}</span>
          </a>
        ))}
      </nav>
      <div class="game-prompt" hidden aria-hidden="true"><kbd>↑</kbd> {t('game.enter')}</div>
    </div>

    <header class="game-hud">
      <a class="game-exit" href={path('home', lang)}>{t('game.exit')}</a>
      <div class="game-coins" aria-label={t('game.coins')}>
        <span class="coin-icon" aria-hidden="true"></span>× <span class="game-coins-count">00</span>
      </div>
    </header>

    <div class="game-pad" aria-hidden="true">
      <div class="pad-move">
        <button type="button" tabindex="-1" data-action="left">◀</button>
        <button type="button" tabindex="-1" data-action="right">▶</button>
      </div>
      <div class="pad-act">
        <button type="button" tabindex="-1" data-action="enter" class="pad-enter">▲</button>
        <button type="button" tabindex="-1" data-action="jump" class="pad-jump">A</button>
      </div>
    </div>

    {houses.map((h, i) => (
      <dialog class="room" data-room={h.route} aria-labelledby={`room-${h.route}`} style={`--c:${h.color}`}>
        <div class="room-head">
          <span class="room-icon"><PixelIcon name={h.icon} size={40} /></span>
          <div>
            <div class="room-badge">{es ? 'CASA' : 'HOUSE'} {i + 1} — {h.label.toUpperCase()}</div>
            <h2 id={`room-${h.route}`}>{h.label}</h2>
          </div>
          <button type="button" class="room-close" data-close aria-label={t('game.keepPlaying')}>✕</button>
        </div>
        <div class="room-body">
          {rooms[h.route].photo && <img class="room-photo" src="/jorge.jpg" alt="Jorge Cardete" width="170" height="170" loading="lazy" />}
          {rooms[h.route].lead && <p class="room-lead">{rooms[h.route].lead}</p>}
          {rooms[h.route].paragraphs?.map((html) => <p class="room-text" set:html={html} />)}
          {rooms[h.route].items.length > 0 && <ul class="room-items">
            {rooms[h.route].items.map((item) => (
              <li>
                <div class="room-meta">{item.meta}</div>
                <div class="room-title">{item.href ? <a href={item.href}>{item.title}</a> : item.title}</div>
                {item.text && <p>{item.text}</p>}
              </li>
            ))}
          </ul>}
        </div>
        <div class="room-foot">
          <button type="button" class="room-back" data-close>{t('game.keepPlaying')}</button>
          <a class="room-go" href={path(h.route, lang)}>{t('game.visit').replace('{section}', h.label)}</a>
        </div>
      </dialog>
    ))}

    <div class="game-iris" aria-hidden="true"></div>
    <noscript>
      <style is:inline>
        .game-layer nav { position: absolute; left: 16px; right: 16px; top: 45%; display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
        .game-layer .game-sign { position: relative !important; visibility: visible !important; }
      </style>
      <p class="game-noscript">{t('game.noscript')}</p>
    </noscript>
  </div>
</Base>

<style>
  :global(body:has(.game)) { overflow: hidden; }
  /* clip y no hidden: enfocar un cartel fuera de pantalla no debe desplazar la capa. */
  .game { position: fixed; inset: 0; z-index: 10; overflow: clip; background: #cdecf6; user-select: none; -webkit-user-select: none; touch-action: none; }
  .game-canvas { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; opacity: 0; transition: opacity .3s; }
  .game.is-ready .game-canvas { opacity: 1; }

  .game-layer { position: absolute; inset: 0; overflow: clip; pointer-events: none; }
  .game-board, .game-sign, .game-prompt { position: absolute; left: 0; top: 0; pointer-events: auto; will-change: transform; }
  .game:not(.is-ready) .game-layer > *, .game:not(.is-ready) .game-sign { visibility: hidden; }

  .game-board { width: max-content; max-width: min(78vw, 360px); padding: 10px 14px; background: #d9a47c; border: 3px solid var(--ink); box-shadow: 4px 4px 0 var(--shadow); text-align: center; }
  .game-board h1 { margin: 0 0 8px; font-family: var(--pixel); font-size: clamp(9px, 1.4vw, 12px); line-height: 1.5; color: var(--ink); }
  .game-board p { margin: 0; font-family: var(--mono); font-size: 12px; color: #3a2a1c; }
  .help-touch { display: none; }
  @media (pointer: coarse) {
    .help-keys { display: none; }
    .help-touch { display: block; }
    .game-board { max-width: 220px; padding: 8px 10px; }
    .game-board h1 { font-size: 9px; margin-bottom: 6px; }
    .game-board p { font-size: 10.5px; }
  }

  /* Carteles grandes con el color de su casa, como un rótulo de tienda. */
  .game-sign { display: flex; align-items: center; gap: 12px; padding: 8px 16px 8px 8px; background: var(--c); border: 4px solid var(--ink); box-shadow: 5px 5px 0 var(--shadow); font-family: var(--pixel); font-size: clamp(11px, 1.5vw, 16px); color: var(--bg); text-shadow: 2px 2px 0 var(--ink); text-decoration: none; white-space: nowrap; transition: scale .15s; }
  /* Solo `scale`: el transform lo mueve el juego en cada frame para seguir a la cámara. */
  .game-sign:hover { color: var(--bg); scale: 1.06; }
  .sign-icon { display: grid; place-items: center; padding: 4px; background: var(--bg); border: 3px solid var(--ink); }
  .sign-icon :global(svg) { width: clamp(22px, 2.6vw, 30px); height: auto; }
  .game-sign::after { content: ''; position: absolute; left: 50%; bottom: -12px; width: 6px; height: 8px; margin-left: -3px; background: var(--ink); }
  .game-sign.is-near { animation: bob .6s ease-in-out infinite alternate; }
  .game-sign:focus-visible { outline: 3px solid var(--bg); outline-offset: 2px; }
  @keyframes bob { to { margin-top: -4px; } }

  .game-prompt { padding: 5px 8px; background: var(--ink); color: var(--bg); font-family: var(--pixel); font-size: 9px; white-space: nowrap; }
  .game-prompt kbd { font: inherit; color: #f7d046; }
  .game-prompt::after { content: ''; position: absolute; left: 50%; bottom: -5px; margin-left: -5px; border: 5px solid transparent; border-bottom: 0; border-top-color: var(--ink); }

  .game-hud { position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px; pointer-events: none; }
  .game-hud > * { pointer-events: auto; }
  .game-exit, .game-coins { padding: 8px 12px; background: var(--card); border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--shadow); font-family: var(--pixel); font-size: 10px; color: var(--ink); text-decoration: none; }
  .game-exit { display: flex; align-items: center; gap: 8px; }
  .game-exit::before { content: ''; border: 5px solid transparent; border-left: 0; border-right: 6px solid currentColor; }
  .game-exit:hover { background: var(--ink); color: var(--bg); }
  .game-coins { display: flex; align-items: center; gap: 6px; }
  .coin-icon { width: 10px; height: 12px; background: #f7d046; border: 2px solid var(--ink); border-radius: 50%; }

  .game-pad { display: none; position: absolute; left: 0; right: 0; bottom: 0; justify-content: space-between; align-items: flex-end; padding: 16px max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); pointer-events: none; }
  @media (pointer: coarse) { .game-pad { display: flex; } }
  .pad-move, .pad-act { display: flex; gap: 12px; align-items: flex-end; }
  .game-pad button { pointer-events: auto; width: 60px; height: 60px; display: grid; place-items: center; background: rgba(246, 241, 228, 0.85); border: 3px solid var(--ink); border-radius: 8px; box-shadow: 3px 3px 0 var(--shadow); font-family: var(--pixel); font-size: 16px; color: var(--ink); touch-action: none; -webkit-tap-highlight-color: transparent; }
  .game-pad button:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--shadow); }
  .game-pad .pad-jump { width: 68px; height: 68px; border-radius: 50%; background: #e8574c; color: var(--bg); }
  .game-pad .pad-enter { opacity: .35; transition: opacity .15s; }
  .game.can-enter .pad-enter { opacity: 1; background: #f7d046; }

  /* Transición de "iris" al entrar en una casa. */
  .game-iris { position: absolute; left: var(--iris-x, 50%); top: var(--iris-y, 50%); width: 300vmax; height: 300vmax; border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 0 300vmax var(--ink); pointer-events: none; opacity: 0; }
  .game.is-leaving .game-iris { opacity: 1; width: 0; height: 0; transition: width .45s ease-in, height .45s ease-in; }
  /* Interior de la casa: un modal con el estilo de las tarjetas de la web. */
  .room { width: min(760px, calc(100vw - 32px)); max-height: calc(100dvh - 40px); padding: 0; background: var(--bg); color: var(--ink); border: 4px solid var(--ink); box-shadow: 8px 8px 0 var(--shadow); overflow: hidden; flex-direction: column; }
  .room[open] { display: flex; animation: pop .22s ease-out; }
  .room::backdrop { background: rgba(31, 29, 26, 0.55); }
  @keyframes pop { from { transform: translateY(14px) scale(.97); opacity: 0; } }
  .room-head { position: relative; display: flex; align-items: center; gap: 14px; padding: 16px 52px 16px 18px; background: var(--c); border-bottom: 4px solid var(--ink); }
  .room-icon { flex: none; display: grid; place-items: center; padding: 5px; background: var(--bg); border: 3px solid var(--ink); }
  .room-badge { font-family: var(--pixel); font-size: 9px; line-height: 1.6; color: var(--bg); text-shadow: 1px 1px 0 var(--ink); }
  .room-head h2 { margin: 2px 0 0; font-family: var(--display); font-weight: 800; font-size: 30px; letter-spacing: -0.8px; color: var(--bg); text-shadow: 2px 2px 0 var(--ink); }
  .room-close { position: absolute; top: 12px; right: 12px; width: 32px; height: 32px; background: var(--bg); border: 3px solid var(--ink); font: 700 14px var(--mono); color: var(--ink); cursor: pointer; }
  .room-close:hover { background: var(--ink); color: var(--bg); }
  .room-body { padding: 24px 26px 8px; overflow-y: auto; }
  .room-body::after { content: ''; display: block; clear: both; }
  .room-photo { float: right; width: 170px; height: 170px; margin: 4px 0 14px 22px; object-fit: cover; border: 4px solid var(--ink); box-shadow: 5px 5px 0 var(--shadow); }
  .room-lead { margin: 0 0 18px; font-size: 16px; line-height: 1.6; color: var(--text-soft); text-wrap: pretty; }
  .room-text { margin: 0 0 16px; font-size: 16.5px; line-height: 1.7; text-wrap: pretty; }
  .room-items { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .room-items li { padding: 12px 14px; background: var(--card); border: 3px solid var(--ink); border-left-width: 8px; border-left-color: var(--c); box-shadow: 3px 3px 0 var(--shadow); }
  .room-meta { font-family: var(--mono); font-size: 11px; color: var(--muted); margin-bottom: 4px; }
  .room-title { font-family: var(--display); font-weight: 700; font-size: 17px; line-height: 1.3; }
  .room-title a { color: var(--ink); text-decoration: none; }
  .room-title a:hover { color: var(--green); text-decoration: underline; }
  .room-items p { margin: 6px 0 0; font-size: 14px; line-height: 1.55; color: var(--text-soft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .room-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 20px 18px; border-top: 1px solid var(--line); }
  .room-back { padding: 10px 14px; background: transparent; border: 3px solid var(--ink); font-family: var(--pixel); font-size: 10px; color: var(--ink); cursor: pointer; }
  .room-back:hover { background: var(--card); }
  .room-go { margin-left: auto; padding: 12px 16px; background: var(--c); border: 3px solid var(--ink); box-shadow: 4px 4px 0 var(--shadow); font-family: var(--pixel); font-size: 11px; color: var(--bg); text-shadow: 1px 1px 0 var(--ink); text-decoration: none; transition: transform .15s, box-shadow .15s; }
  .room-go { display: flex; align-items: center; justify-content: center; gap: 10px; }
  .room-go::after { content: ''; border: 5px solid transparent; border-right: 0; border-left: 6px solid currentColor; filter: drop-shadow(1px 1px 0 var(--ink)); }
  @media (max-width: 480px) {
    .room-photo { width: 104px; height: 104px; margin-left: 14px; }
    .room-body { padding: 18px 18px 4px; }
    .room-foot > * { flex: 1 1 100%; text-align: center; }
    .room-head h2 { font-size: 24px; }
  }
  .room-go:hover { color: var(--bg); transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--shadow); }

  @media (prefers-reduced-motion: reduce) {
    .room[open] { animation: none; }
    .game.is-leaving .game-iris { transition: none; }
    .game-sign.is-near { animation: none; }
  }

  .game-noscript { position: absolute; left: 50%; bottom: 24px; transform: translateX(-50%); margin: 0; padding: 10px 14px; background: var(--card); border: 3px solid var(--ink); font-family: var(--mono); font-size: 13px; }
</style>

<script>
  import { startGame } from '../game/game';

  const root = document.getElementById('game');
  if (root) startGame(root);
</script>
