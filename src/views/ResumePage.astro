---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { dateFormat, l, path, type Lang } from '../i18n';
import { education, experience } from '../data/resume';
import { projects, projectLinks } from '../data/projects';
import { me, papers } from '../data/papers';

interface Props { lang: Lang }
const { lang } = Astro.props;

// Experiencia y formación en data/resume.ts; proyectos, papers y el blog, de sus propios datos.
const postCount = (await getCollection('blog')).length;
const shipped = projects.filter((p) => !p.soon);
const fmt = dateFormat(lang, { month: 'long', year: 'numeric' });
const monthFmt = dateFormat(lang, { month: 'short', year: 'numeric' });
const month = (ym: string) => monthFmt.format(new Date(`${ym}-01`));

const text = {
  es: {
    title: 'Currículum',
    description: 'Experiencia, proyectos, publicaciones, habilidades y formación de Jorge Cardete.',
    role: 'Growth Engineer',
    experience: 'Experiencia',
    present: 'actualidad',
    education: 'Formación',
    projects: 'Proyectos y hackathons',
    skills: 'Habilidades',
    skillList: [
      ['Lenguajes', 'Python, Rust, TypeScript, C++, SQL'],
      ['Machine learning', 'PyTorch, TensorFlow y Keras, OpenCV, LightGBM, Azure ML, CNN, detección de objetos, OCR, speech-to-text'],
      ['IA generativa', 'LLM (GPT, Llama, Cohere) y agentes de IA, también on-chain en Solana'],
      ['Datos', 'Databricks, Grafana, Power BI, SAS Viya, SQL'],
      ['Backend e infraestructura', 'Flask, Docker, Azure, Terraform, RabbitMQ, MySQL'],
      ['Web', 'Astro, TypeScript, HTML y CSS'],
      ['Growth', 'Experimentación en embudos, tracking, automatización, personalización, Google Ads y Meta Ads'],
    ],
    writing: 'Escritura y publicaciones',
    blog: `${postCount} artículos sobre visión artificial, machine learning, IA y Python en este`,
    paper: 'Artículo científico',
  },
  en: {
    title: 'Resume',
    description: 'Experience, projects, publications, skills and education of Jorge Cardete.',
    role: 'Growth Engineer',
    experience: 'Experience',
    present: 'Present',
    education: 'Education',
    projects: 'Projects and hackathons',
    skills: 'Skills',
    skillList: [
      ['Languages', 'Python, Rust, TypeScript, C++, SQL'],
      ['Machine learning', 'PyTorch, TensorFlow and Keras, OpenCV, LightGBM, Azure ML, CNNs, object detection, OCR, speech-to-text'],
      ['Generative AI', 'LLMs (GPT, Llama, Cohere) and AI agents, including on-chain on Solana'],
      ['Data', 'Databricks, Grafana, Power BI, SAS Viya, SQL'],
      ['Backend and infrastructure', 'Flask, Docker, Azure, Terraform, RabbitMQ, MySQL'],
      ['Web', 'Astro, TypeScript, HTML and CSS'],
      ['Growth', 'Funnel experimentation, tracking, automation, personalization, Google Ads and Meta Ads'],
    ],
    writing: 'Writing and publications',
    blog: `${postCount} articles on computer vision, machine learning, AI and Python on this`,
    paper: 'Research paper',
  },
}[lang];
---
<Base title={text.title} description={text.description}>
  <div class="resume">
    <header>
      <h1 class="resume-name">Jorge Cardete</h1>
      <div class="resume-title">{text.role}</div>
    </header>

    <p class="resume-contact">
      <span><strong>Email</strong>: <a href="mailto:jorgecardete@gmail.com">jorgecardete@gmail.com</a></span> |{' '}
      <span><strong>LinkedIn</strong>: <a href="https://www.linkedin.com/in/jorgecardetellamas/">jorgecardetellamas</a></span>
    </p>

    <h2 id="experience">{text.experience}</h2>
    {experience.map((job) => (
      <>
        <h3>{job.url ? <a href={job.url}>{job.company}</a> : job.company}</h3>
        {job.roles.map((role) => (
          <>
            <div class="resume-role">
              <strong>{l(role.title, lang)}</strong>
              <span class="resume-date">{month(role.start)} – {role.end ? month(role.end) : text.present}</span>
            </div>
            {role.points.map((pt) => <p class="resume-p">{pt.lead && <><strong>{pt.lead}</strong>: </>}{l(pt.text, lang)}</p>)}
          </>
        ))}
      </>
    ))}

    <h2 id="skills">{text.skills}</h2>
    <ul>
      {text.skillList.map(([name, list]) => <li><strong>{name}</strong>: {list}</li>)}
    </ul>

    <h2 id="projects">{text.projects}</h2>
    <ul>
      {shipped.map((p) => {
        const links = projectLinks(p, lang);
        return (
          <li>
            <strong>{l(p.name, lang)} ({p.year})</strong>: {l(p.desc, lang)}
            {links.length > 0 && <> {links.map((link, i) => <>{i > 0 && ' · '}<a href={link.url}>{link.label}</a></>)}</>}
          </li>
        );
      })}
    </ul>

    <h2 id="writing">{text.writing}</h2>
    <ul>
      <li><strong>Blog</strong>: {text.blog} <a href={path('blog', lang)}>blog</a>.</li>
      {papers.map((paper) => (
        <li>
          <strong>{text.paper}</strong>: <a href={`https://doi.org/${paper.doi}`}>{paper.title}</a>{' '}
          <em>{paper.journal}</em> ({paper.publisher}, {fmt.format(paper.date)}).{' '}
          {paper.authors.map((a, i) => <>{i > 0 && ', '}{a === me ? <strong>{a}</strong> : a}</>)}.
        </li>
      ))}
    </ul>

    <h2 id="education">{text.education}</h2>
    {education.map((e) => (
      <>
        <h3><a href={e.url}>{e.school}</a></h3>
        <div class="resume-role">
          <strong>{l(e.degree, lang)}</strong>
          <span class="resume-date">{month(e.start)} – {month(e.end)}</span>
        </div>
      </>
    ))}
  </div>
</Base>

<style>
  .resume { max-width: 670px; font-size: 16px; line-height: 1.5; color: var(--ink); overflow-wrap: break-word; }
  .resume-name { margin: 0; font-size: clamp(34px, 5vw, 40px); font-weight: 700; line-height: 1.15; letter-spacing: -0.5px; }
  .resume-title { margin: 2px 0 0; font-size: 20px; color: var(--muted); }
  .resume-contact { margin: 28px 0 0; }
  .resume-contact span { white-space: nowrap; }
  .resume a { font-weight: 500; text-decoration-thickness: 1px; }
  .resume h2 { margin: 44px 0 20px; padding-bottom: 6px; border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: 12.5px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; color: var(--text-soft); }
  .resume h3 { margin: 26px 0 8px; font-size: 17px; font-weight: 500; }
  .resume h2 + h3 { margin-top: 0; }
  .resume-role + .resume-role, .resume-p + .resume-role { margin-top: 18px; }
  .resume-p { margin: 0 0 10px; }
  .resume-role { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 16px; margin-bottom: 16px; font-size: 16.5px; }
  .resume-date { font-family: var(--mono); font-size: 13px; color: var(--text-soft); }
  .resume ul { margin: 0; padding-left: 16px; }
  .resume li { margin-bottom: 8px; }
  .resume li::marker { color: var(--ink); }
  .resume strong { font-weight: 700; }
</style>
