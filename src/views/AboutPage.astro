---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import WorldBadge from '../components/WorldBadge.astro';
import { path, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const to = (route: Parameters<typeof path>[0]) => path(route, lang);
---
<Base
  title={lang === 'es' ? 'Sobre mí' : 'About me'}
  description={lang === 'es' ? 'Quién soy, cómo contactarme y en qué estoy trabajando ahora.' : 'Who I am, how to reach me and what I am working on now.'}
>
  <WorldBadge house="about" lang={lang}>{lang === 'es' ? 'MUNDO 5 — SOBRE MÍ' : 'WORLD 5 — ABOUT ME'}</WorldBadge>
  <h1 class="hero">{lang === 'es' ? 'Sobre mí' : 'About me'}</h1>

  <div class="about-top">
    <div class="about-photo"><img src="/jorge.jpg" alt="Jorge Cardete" /></div>
    {lang === 'es' ? (
      <div class="about-text">
        <p>¡Hola! Soy Jorge. Me gusta construir cosas, entender cómo funcionan y aprender por el camino. Este es el lugar donde voy reuniendo <a href={to('projects')}>proyectos</a>, ideas y aprendizajes en el <a href={to('blog')}>blog</a>, y algunas de las <a href={to('startups')}>startups</a> en las que estoy trabajando.</p>
        <p>Empecé a <a href="https://medium.com/thedeephub">escribir</a> casi como una forma de ordenar lo que iba aprendiendo. Con el tiempo me di cuenta de que, cuando quieres entender muy bien un tema, una de las mejores formas de hacerlo es intentar explicárselo a los demás. 👨‍🏫</p>
        <p>Ahora mismo trabajo como Growth Engineer en <a href="https://bit2me.com/es">Bit2Me</a>. Después de muchos años programando, quiero mejorar en la otra mitad del juego: la distribución.</p>
        <p>En mi tiempo libre me gusta hacer deporte, viajar y jugar al ajedrez. Ahora mismo me estoy preparando para correr la <a href="https://www.zurichmaratobarcelona.es/">Maratón de Barcelona</a> 🏃</p>
        <p>Si quieres seguir lo que publico, tienes mis datos de contacto y redes justo debajo.</p>
      </div>
    ) : (
      <div class="about-text">
        <p>Hi! I'm Jorge. I like building things, understanding how they work and learning along the way. This is where I gather <a href={to('projects')}>projects</a>, ideas and learnings on the <a href={to('blog')}>blog</a>, along with some of the <a href={to('startups')}>startups</a> I’m working on.</p>
        <p>I started <a href="https://medium.com/thedeephub">writing</a> almost as a way to organise what I was learning. Over time I realised that, when you want to understand a subject really well, one of the best ways is to try to explain it to others. 👨‍🏫</p>
        <p>I currently work as a Growth Engineer at <a href="https://bit2me.com/">Bit2Me</a>. After many years of writing code, I want to get better at the other half of the game: distribution.</p>
        <p>In my free time I enjoy sports, travelling and playing chess. Right now I’m training to run the <a href="https://www.zurichmaratobarcelona.es/">Barcelona Marathon</a> 🏃</p>
        <p>If you want to follow what I publish, my contact details and social links are just below.</p>
      </div>
    )}
  </div>

  <h2 class="about-h">{lang === 'es' ? 'Contacto' : 'Contact'}</h2>
  <p class="about-p2">{lang === 'es' ? 'Escríbeme un email para saludar o encuéntrame en las redes.' : 'Send me an email to say hi or find me on social media.'}</p>
  <ul class="about-list">
    <li><a href="mailto:jorgecardete@gmail.com">jorgecardete@gmail.com</a></li>
    <li><a href="https://www.linkedin.com/in/jorgecardetellamas/">LinkedIn</a></li>
    <li><a href="https://x.com/JorgeCardete">X (Twitter)</a></li>
    <li><a href="https://medium.com/@jorgecardete">Medium</a></li>
    <li><a href="https://github.com/Jorgecardetegit">GitHub</a></li>
  </ul>

  {lang === 'es' ? (
    <>
      <h2 class="about-h">Lo que hago ahora</h2>
      <p class="about-updated">Actualizado el 26 de septiembre de 2026</p>
      <ul class="about-list">
        <li>Trabajando como Growth Engineer en Bit2Me y aprendiendo distribución.</li>
        <li>Aprendiendo sobre Google Ads y Meta Ads.</li>
        <li>Ayudando a mi hermano con la tecnología y la distribución en <a href={to('startups')}>Grupo Cardete Ventures</a>.</li>
        <li>Trabajando en otros side projects. Stay tuned.</li>
        <li>Preparándome para una maratón.</li>
      </ul>
    </>
  ) : (
    <>
      <h2 class="about-h">What I'm doing now</h2>
      <p class="about-updated">Updated on 26 September 2026</p>
      <ul class="about-list">
        <li>Working as a Growth Engineer at Bit2Me and learning distribution.</li>
        <li>Learning about Google Ads and Meta Ads.</li>
        <li>Helping my brother with technology and distribution at <a href={to('startups')}>Grupo Cardete Ventures</a>.</li>
        <li>Working on other side projects. Stay tuned.</li>
        <li>Training for a marathon.</li>
      </ul>
    </>
  )}
  <Newsletter lang={lang} placement="about" />
</Base>
