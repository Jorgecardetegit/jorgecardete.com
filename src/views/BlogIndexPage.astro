---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { dateFormat, l, postPath, type Lang } from '../i18n';
import { topics, type Topic } from '../i18n/topics';

interface Props { lang: Lang }
const { lang } = Astro.props;

const posts = (await getCollection('blog')).sort(
  (a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity) || b.data.date.getTime() - a.data.date.getTime()
);
const sections = (Object.keys(topics) as Topic[])
  .map((key) => ({ key, ...topics[key], posts: posts.filter((p) => p.data.topic === key) }))
  .filter((s) => s.posts.length > 0);

const fmt = dateFormat(lang, { day: 'numeric', month: 'short', year: 'numeric' });
const text = {
  es: {
    description: 'Artículos sobre visión artificial, machine learning, Python y lo que voy aprendiendo.',
    badge: 'MUNDO 2 — BLOG', role: 'Visión artificial, machine learning y lo que voy aprendiendo',
    filters: 'Temáticas', all: 'Todos',
    placeholder: `Buscar entre ${posts.length} posts…`, searchLabel: 'Buscar posts', none: 'No hay posts que coincidan.',
  },
  en: {
    description: 'Articles on computer vision, machine learning, Python and whatever I am learning.',
    badge: 'WORLD 2 — BLOG', role: 'Computer vision, machine learning and whatever I am learning',
    filters: 'Topics', all: 'All',
    placeholder: `Search ${posts.length} posts…`, searchLabel: 'Search posts', none: 'No posts match.',
  },
}[lang];
---
<Base title="Blog" description={text.description}>
  <header class="head">
    <div class="photo"><img src="/jorge.jpg" alt="Jorge Cardete" /></div>
    <div class="intro-block">
      <div class="badge">{text.badge}</div>
      <h1 class="big">Blog</h1>
      <p class="role">{text.role}</p>
    </div>
  </header>

  <div class="blog-filters">
    <input type="search" class="psearch" id="q" placeholder={text.placeholder} aria-label={text.searchLabel} />
    <div class="pfilter-row" role="group" aria-label={text.filters}>
      <button type="button" class="pchip" data-topic="" aria-pressed="true">{text.all}</button>
      {sections.map((s) => (
        <button type="button" class="pchip" data-topic={s.key} aria-pressed="false">
          <span class="dot" style={`--c:${s.color}`} aria-hidden="true"></span>{l(s.label, lang)}
        </button>
      ))}
    </div>
  </div>

  {sections.map((s) => (
    <section class="topic" data-topic={s.key} style={`--c:${s.color}`}>
      <h2 class="topic-title">{l(s.label, lang)} <span class="topic-count">{s.posts.length}</span></h2>
      <div class="bgrid">
        {s.posts.map((post) => (
          <a
            class="bcard"
            href={postPath(post.id, lang)}
            data-text={[post.data.title, post.data.description, ...post.data.tags].join(' ').toLowerCase()}
            data-tags={post.data.tags.join(',')}
          >
            <div class="bcover">
              {post.data.cover ? <img src={post.data.cover} alt="" loading="lazy" decoding="async" /> : <span aria-hidden="true">{post.data.icon}</span>}
            </div>
            <div class="bbody">
              <span class="btopic">{l(s.label, lang)}</span>
              <h3 class="btitle">{post.data.title}</h3>
              <p class="bdesc">{post.data.description}</p>
              <time class="bdate" datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
  <p class="none" id="none" hidden>{text.none}</p>
</Base>

<style>
  .head { display: flex; flex-wrap: wrap; gap: 32px 48px; align-items: flex-start; margin-bottom: 40px; }
  .photo { flex: none; width: 205px; height: 205px; background: #e9e2d0; border: 4px solid var(--ink); box-shadow: 6px 6px 0 var(--shadow); overflow: hidden; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .intro-block { flex: 1 1 320px; min-width: 260px; }
  .big { margin: 0 0 20px; font-family: var(--display); font-weight: 800; font-size: clamp(56px, 9vw, 96px); line-height: 0.95; letter-spacing: -3px; color: var(--ink); text-shadow: 3px 3px 0 var(--gold), 6px 6px 0 var(--terracotta); }
  .role { margin: 0; font-size: 19px; line-height: 1.55; color: var(--text-soft); }

  .blog-filters { display: flex; flex-direction: column; gap: 14px; margin-bottom: 44px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--c); margin-right: 7px; display: inline-block; }
  .pchip { display: inline-flex; align-items: center; }
  .pchip[aria-pressed='true'] .dot { box-shadow: 0 0 0 2px var(--bg); }

  .topic { margin-bottom: 56px; }
  .topic[hidden] { display: none; }
  .topic-title { display: flex; align-items: center; gap: 10px; margin: 0 0 20px; padding-bottom: 10px; border-bottom: 3px solid var(--c); font-family: var(--display); font-weight: 800; font-size: 28px; letter-spacing: -0.6px; }
  .topic-count { font-family: var(--mono); font-size: 13px; font-weight: 500; color: var(--c); border: 1.5px solid var(--c); border-radius: 999px; padding: 1px 9px; letter-spacing: 0; }

  .bgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 22px; }
  .bcard { display: flex; flex-direction: column; overflow: hidden; background: var(--card); border: 3px solid var(--ink); border-radius: 4px; box-shadow: 4px 4px 0 var(--shadow); color: var(--ink); font-weight: 400; text-decoration: none; transition: transform .15s, box-shadow .15s; }
  .bcard[hidden] { display: none; }
  .bcard:hover, .bcard:focus-visible { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--shadow); color: var(--ink); }
  .bcard:hover .btitle { color: var(--green); }
  .bcover { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 3px solid var(--ink); background: #e9e2d0; display: grid; place-items: center; font-size: 40px; }
  .bcover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .bbody { flex: 1; display: flex; flex-direction: column; gap: 8px; padding: 16px 18px 18px; }
  .btopic { font-family: var(--pixel); font-size: 9px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--c); line-height: 1.5; }
  .btitle { margin: 0; font-family: var(--display); font-weight: 700; font-size: 19px; line-height: 1.25; letter-spacing: -0.3px; text-wrap: balance; transition: color .15s; }
  .bdesc { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--text-soft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .bdate { margin-top: auto; padding-top: 6px; font-family: var(--mono); font-size: 12px; color: var(--muted); }

  .none { padding: 16px 0 32px; color: var(--muted); font-family: var(--mono); font-size: 14px; }
</style>

<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.pchip[data-topic]')];
  const sections = [...document.querySelectorAll<HTMLElement>('.topic')];
  const none = document.getElementById('none')!;
  const topicKeys = new Set(sections.map((s) => s.dataset.topic!));
  let topic = '';
  let tag = '';

  function apply() {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const section of sections) {
      let inSection = 0;
      const topicOk = !topic || section.dataset.topic === topic;
      for (const card of section.querySelectorAll<HTMLElement>('.bcard')) {
        const ok = topicOk && (!q || card.dataset.text!.includes(q)) && (!tag || card.dataset.tags!.split(',').includes(tag));
        card.hidden = !ok;
        if (ok) inSection++;
      }
      section.hidden = inSection === 0;
      visible += inSection;
    }
    none.hidden = visible > 0;
  }

  function selectTopic(value: string) {
    topic = value;
    for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.topic === value));
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      tag = '';
      selectTopic(chip.dataset.topic!);
      apply();
    });
  }
  input.addEventListener('input', apply);

  // ?tema= admite una temática (vision, ml…) o una etiqueta (computer-vision, python…).
  const fromUrl = new URLSearchParams(location.search).get('tema');
  if (fromUrl) {
    if (topicKeys.has(fromUrl)) selectTopic(fromUrl);
    else tag = fromUrl;
    apply();
  }
</script>
