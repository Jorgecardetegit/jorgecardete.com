---
import Base from '../layouts/Base.astro';

const projects = [
  { name: 'Every System Is Broken', desc: 'Descripción del proyecto: qué es y qué hiciste tú. Dos frases bastan.', color: '#b5553f' },
  { name: 'Colisseum', desc: 'Descripción del proyecto: qué es y qué hiciste tú. Dos frases bastan.', color: '#3f6f52' },
  { name: 'Hackspain', desc: 'Descripción del proyecto: qué es y qué hiciste tú. Dos frases bastan.', color: '#6b5ea8' },
  { name: 'UFV Labs', desc: 'Descripción del proyecto: qué es y qué hiciste tú. Dos frases bastan.', color: '#c9a227' },
];
---
<Base title="Proyectos" description="Proyectos: Every System Is Broken, Colisseum, Hackspain y UFV Labs.">
  <div class="badge">MUNDO 3 — PROYECTOS</div>
  <h1 class="hero">Proyectos</h1>
  <p class="lead">Cosas que he construido, organizado o puesto en marcha.</p>

  <ul class="startups">
    {projects.map((p) => (
      <li class="startup">
        <div class="startup-body">
          <h2 class="startup-name">{p.name}</h2>
          <div class="startup-role">Proyecto</div>
          <p class="startup-desc">{p.desc}</p>
        </div>
        <div class="startup-img" style={`--c:${p.color}`} aria-hidden="true">
          <span>{p.name[0]}</span>
        </div>
      </li>
    ))}
  </ul>
</Base>
