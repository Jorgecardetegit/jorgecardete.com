---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---
<Base title="Proyectos" description="Proyectos: Every System Is Broken, Colisseum, Hackspain, UFV Labs, UFV Parking, Cell Vision, OCR Parser y Gather Simulator.">
  <div class="badge">MUNDO 3 — PROYECTOS</div>
  <h1 class="hero">Proyectos</h1>
  <p class="lead">Cosas que he construido, organizado o puesto en marcha.</p>

  <ul class="pgrid">
    {projects.map((p) => (
      <li class="pcard" style={`--c:${p.color}`}>
        <div class="pcard-top">
          <time class="pcard-year">{p.year}</time>
        </div>
        <h2 class="pcard-name">{p.name}</h2>
        <p class="pcard-desc">{p.desc}</p>
        <div class="tags">
          {p.tags.map((t) => <span class="tag">#{t}</span>)}
        </div>
        <div class="pcard-links">
          {p.links.map((l) => <a href={l.url}>{l.label}</a>)}
        </div>
      </li>
    ))}
  </ul>
</Base>
