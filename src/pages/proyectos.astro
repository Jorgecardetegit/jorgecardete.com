---
import Base from '../layouts/Base.astro';
import { categories, projects } from '../data/projects';

const usedCategories = Object.entries(categories).filter(([key]) => projects.some((p) => p.category === key));
const languages = [...new Set(projects.flatMap((p) => p.languages))].sort();
---
<Base title="Proyectos" description={`Proyectos: ${projects.map((p) => p.name).join(', ')}.`}>
  <div class="badge">MUNDO 3 — PROYECTOS</div>
  <h1 class="hero">Proyectos</h1>
  <p class="lead">Cosas que he construido, organizado o puesto en marcha.</p>

  <div class="pfilters">
    <label class="psearch">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="pq" placeholder="Buscar proyectos…" aria-label="Buscar proyectos" />
    </label>
    <select class="pselect" data-group="category" aria-label="Temática">
      <option value="">Todas las temáticas</option>
      {usedCategories.map(([key, c]) => <option value={key}>{c.label}</option>)}
    </select>
    <select class="pselect" data-group="language" aria-label="Lenguaje">
      <option value="">Todos los lenguajes</option>
      {languages.map((l) => <option value={l}>{l}</option>)}
    </select>
  </div>

  <ul class="pgrid">
    {projects.map((p) => (
      <li
        class="pcard"
        style={`--c:${categories[p.category].color}`}
        data-category={p.category}
        data-languages={p.languages.join('|')}
        data-text={[p.name, p.desc, ...p.tags, ...p.languages].join(' ').toLowerCase()}
      >
        <div class="pcard-top">
          <time class="pcard-year">{p.year}</time>
        </div>
        <h2 class="pcard-name">{p.name}</h2>
        <p class="pcard-desc">{p.desc}</p>
        <div class="tags">
          {p.tags.map((t) => <span class="tag">#{t}</span>)}
        </div>
        {p.links.length > 0 && (
          <div class="pcard-links">
            {p.links.map((l) => <a href={l.url}>{l.label}</a>)}
          </div>
        )}
      </li>
    ))}
  </ul>
  <p class="pnone" id="pnone" hidden>Ningún proyecto coincide con esos filtros.</p>
</Base>

<script>
  const input = document.getElementById('pq') as HTMLInputElement;
  const selects = [...document.querySelectorAll<HTMLSelectElement>('.pselect')];
  const cards = [...document.querySelectorAll<HTMLElement>('.pcard')];
  const none = document.getElementById('pnone')!;

  function apply() {
    const q = input.value.trim().toLowerCase();
    const [category, language] = selects.map((s) => s.value);
    let visible = 0;
    for (const card of cards) {
      const ok =
        (!category || card.dataset.category === category) &&
        (!language || card.dataset.languages!.split('|').includes(language)) &&
        (!q || card.dataset.text!.includes(q));
      card.hidden = !ok;
      if (ok) visible++;
    }
    none.hidden = visible > 0;
  }

  for (const s of selects) s.addEventListener('change', apply);
  input.addEventListener('input', apply);
</script>
