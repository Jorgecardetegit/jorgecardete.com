---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const tour = [
  { years: '2022', html: 'Community manager en FTT DAO. Mi primer contacto con blockchain y Solidity.' },
  { years: '2023–2024', html: 'Data analyst en Medtronic: análisis con Power BI y Python, y un <a href="/proyectos/">OCR</a> para automatizar la lectura de pliegos de licitación.' },
  { years: '2023–hoy', html: 'Fundo <a href="/startups/">The Deep Hub</a>, una publicación de data science y machine learning en Medium: 570+ artículos y ~100 autores. Escribo sobre todo de visión artificial.' },
  { years: '2024', html: 'Data scientist en Axpe Consulting: un chatbot con agentes de IA para normativa bancaria de BBVA, visión artificial para Cosentino y evaluación de modelos speech-to-text para Sabadell.' },
  { years: '2024–2025', html: 'Founding engineer en <a href="/startups/">xFractal</a>, primero en Rust y después liderando la parte de agentes de IA on-chain en Solana.' },
  { years: '2024–hoy', html: 'Founder &amp; CTO de <a href="/startups/">Grupo Cardete Ventures</a>: la plataforma de asistencia en carretera 24/7 y transporte urgente en Madrid y Barcelona.' },
  { years: '2025–2026', html: 'Fundo <a href="/startups/">Zapic</a>, asistentes de IA para gestionar redes sociales. Llevo producto, ingeniería y estrategia.' },
  { years: '2026–hoy', html: 'Growth Engineer en Bit2Me: experimentos de adquisición, activación y retención, y la infraestructura técnica detrás (tracking, automatización, personalización).' },
];

---
<Base title="Inicio">
  <div class="badge">MUNDO 1 — PORTFOLIO</div>
  <h1 class="hero">Hola, soy Jorge</h1>
  <p class="lead">Soy programador y ahora Growth Engineer en Bit2Me, aprendiendo a distribuir lo que construyo.</p>

  <div class="tour-wrap">
    <div class="tour">
      <h2 class="sub">Un breve recorrido</h2>
      <div class="tour-list">
        {tour.map((t) => (
          <div class="tour-item">
            <div class="tour-year">{t.years}</div>
            <p set:html={t.html} />
          </div>
        ))}
      </div>
    </div>

    <div class="side-card">
      <div class="portrait"><img src="/jorge.jpg" alt="Jorge Cardete" /></div>
      <div class="note">Y si prefieres el pueblo pixelado, <a href="/quest/">entra al mapa</a>.</div>
    </div>
  </div>

  <div class="divider"></div>

  <section id="posts">
    <div class="posts-head">
      <h2 class="section">Último</h2>
      <a class="pill" href="/blog/">Ver todo</a>
    </div>
    <PostList posts={posts} />
  </section>
</Base>
