---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const tour = [
  { years: '2014–2018', html: 'Estudiante de diseño, fanzines fotocopiados y demasiadas horas en foros.' },
  { years: '2018–2021', html: '<a href="/proyectos/">Primer estudio</a>: identidad, web y todo lo que hiciera falta. Aprendí a maquetar por necesidad.' },
  { years: '2021–2024', html: '<a href="/proyectos/">Diseño de producto</a> en una empresa pequeña: sistemas de diseño, prototipos y bastante investigación.' },
  { years: '2024–hoy', html: 'En solitario: proyectos propios, algo de consultoría y <a href="/blog/">escribir sobre el proceso</a>.' },
];

---
<Base title="Inicio">
  <div class="badge">MUNDO 1 — PORTFOLIO</div>
  <h1 class="hero">Hola, soy Jorge</h1>
  <p class="lead">Soy programador y ahora Growth Engineer en Bit2Me, aprendiendo a distribuir lo que construyo.</p>

  <div class="tour-wrap">
    <div class="tour">
      <h2 class="sub">Un breve recorrido</h2>
      <div class="tour-list">
        {tour.map((t) => (
          <div class="tour-item">
            <div class="tour-year">{t.years}</div>
            <p set:html={t.html} />
          </div>
        ))}
      </div>
    </div>

    <div class="side-card">
      <div class="portrait"><img src="/jorge.jpg" alt="Jorge Cardete" /></div>
      <div class="note">Y si prefieres el pueblo pixelado, <a href="/quest/">entra al mapa</a>.</div>
    </div>
  </div>

  <div class="divider"></div>

  <section id="posts">
    <div class="posts-head">
      <h2 class="section">Último</h2>
      <a class="pill" href="/blog/">Ver todo</a>
    </div>
    <PostList posts={posts} />
  </section>
</Base>
