---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { projectLinks, projects } from '../data/projects';

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = allPosts.slice(0, 4);
const countTag = (tag: string) => allPosts.filter((p) => p.data.tags.includes(tag)).length;
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const eras = [
  { years: '2022–2023', html: 'Primeros pasos: community manager en FTT DAO y <a href="/proyectos/">data analyst en Medtronic</a>, con Python, Power BI y un OCR para pliegos de licitación.' },
  { years: '2023–hoy', html: 'Fundo <a href="https://medium.com/thedeephub">The Deep Hub</a>, una publicación de machine learning en Medium: <a href="/blog/">570+ artículos</a> y ~100 autores.' },
  { years: '2024–2025', html: 'Data scientist en Axpe Consulting (BBVA, Cosentino, Sabadell) y AI engineer en <a href="/startups/">xFractal</a>, con Rust y agentes de IA en Solana.' },
  { years: '2024–hoy', html: 'Fundador: CTO de <a href="/startups/">Grupo Cardete Ventures</a> y creador de <a href="/startups/">Zapic</a>, asistentes de IA para redes sociales.' },
  { years: '2026–hoy', html: 'Growth Engineer en Bit2Me: experimentos de adquisición, activación y retención, y la infraestructura técnica detrás.' },
];

const shelves = [
  { title: 'Visión artificial', tag: 'computer-vision', desc: 'Mi tema favorito. De cómo se forma una imagen a detectar objetos con YOLO, pasando por la interpolación, HOG, Haar cascades y ConvNeXt.' },
  { title: 'Machine learning', tag: 'machine-learning', desc: 'Conceptos que me costó entender y quise explicar bien: teacher forcing, state space models, IA explicable y qué hay antes de las CNN.' },
  { title: 'Deep learning', tag: 'deep-learning', desc: 'Redes neuronales por dentro: una guía completa de CNNs, ConvNeXt y las tres formas de construir modelos en TensorFlow.' },
  { title: 'Python y herramientas', tag: 'python', desc: 'El lado práctico: por qué Python es lento, interfaces con Tkinter, scraping para crear datasets y un bot de Twitter con OpenAI.' },
].map((s) => ({ ...s, count: countTag(s.tag) }));

const series = [
  { icon: '🧭', title: '¿Qué había antes de las CNN?', url: '/blog/antes-de-las-cnn-parte-1/', desc: 'Dos partes sobre la visión artificial clásica: histogramas de gradientes orientados (HOG) y Haar cascades.' },
  { icon: '🅿️', title: 'Detector de plazas de parking', url: '/blog/parking-detector-parte-1/', desc: 'Un proyecto de principio a fin: entrenar el modelo de visión artificial y desplegarlo con Docker, Flask y Azure.' },
  { icon: '🧠', title: 'Visión artificial desde cero', url: '/blog/como-se-crean-las-imagenes/', desc: 'Un camino ordenado: cómo se crean las imágenes, interpolación, CNNs, ConvNeXt y YOLO.' },
  { icon: '📚', title: 'The Deep Hub', url: 'https://medium.com/thedeephub', desc: 'La publicación de data science y machine learning que fundé en Medium, con 570+ artículos de ~100 autores.' },
];

const featured = projects.slice(0, 6);
---
<Base title="Inicio">
  <div class="home">
    <header class="hero-index">
      <div class="hero-wrapper">
        <div>
          <h1>¡Hola, soy Jorge!</h1>
          <p class="hero-description hero-tagline">Programador, Growth Engineer y fundador de startups.</p>
          <h2 class="heading-small">Un breve recorrido</h2>
          <ul class="hero-eras">
            {eras.map((e) => (
              <li><span class="era-dates">{e.years}</span><span set:html={e.html} /></li>
            ))}
          </ul>
          <p class="hero-description"><a href="/sobre-mi/">También</a>: deportista, viajero y jugador de ajedrez.</p>
        </div>
        <div class="hero-image-container">
          <img src="/jorge.jpg" class="hero-image" alt="Jorge Cardete" />
          <aside class="hero-bubble">¿Prefieres el pueblo pixelado? <a href="/quest/">Entra al mapa</a>.</aside>
        </div>
      </div>
    </header>

    <section class="section-index">
      <div class="heading-row">
        <h2>Último</h2>
        <a class="button" href="/blog/">Todos los posts</a>
      </div>
      <div class="posts">
        {latest.map((post) => (
          <a class="post" href={`/blog/${post.id}/`}>
            <div class="post-thumbnail" aria-hidden="true">{post.data.icon}</div>
            <div class="post-info">
              <div class="post-title">{post.data.title}</div>
              <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
            </div>
            <div class="post-tags">
              {post.data.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section-index">
      <div class="heading-row">
        <h2>Estanterías</h2>
        <a class="button" href="/blog/">Todos los temas</a>
      </div>
      <p class="description">Caminos escogidos a mano entre todo lo que he escrito.</p>
      <div class="cards cards-half">
        {shelves.map((s) => (
          <a class="card card-shelf" href={`/blog/?tema=${s.tag}`}>
            <div class="card-head">
              <div class="card-title">{s.title}</div>
              <span class="chip">{s.count}</span>
            </div>
            <p>{s.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section-index">
      <div class="heading-row">
        <h2>Series</h2>
      </div>
      <p class="description">Algunas cosas que escribo tienen varias partes o siguen un orden.</p>
      <div class="posts">
        {series.map((s) => (
          <a class="post" href={s.url}>
            <div class="post-thumbnail" aria-hidden="true">{s.icon}</div>
            <div class="post-info">
              <div class="post-title">{s.title}</div>
              <p class="post-description">{s.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section-index">
      <div class="heading-row">
        <h2>Proyectos</h2>
        <a class="button" href="/proyectos/">Todos los proyectos</a>
      </div>
      <p class="description">Cosas que he construido por el camino.</p>
      <div class="cards">
        {featured.map((p) => (
          <div class="card">
            <time>{p.year}</time>
            {p.links.length > 0 ? <a class="card-title" href={projectLinks(p, 'es')[0].url}>{p.name.es}</a> : <span class="card-title">{p.name.es}</span>}
            <p>{p.desc.es}</p>
            {p.links.length > 0 && (
              <div class="card-links">
                {projectLinks(p, 'es').map((link) => <a href={link.url}>{link.label}</a>)}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .home {
    --c-text: #28282e;
    --c-strong: #1d1d22;
    --c-muted: #5a5a61;
    --c-border: #e5dcbd;
    --c-card: #f1ead5;
    --c-card-border: #ded4b2;
    --c-hover: #ece4ca;
    --c-primary: var(--green);
    --radius: 8px;
    --mono2: 'Google Sans Code', var(--mono);
    color: var(--c-text);
    max-width: 900px;
  }
  .home a { font-weight: 600; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--c-primary) 45%, transparent); text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .home a:hover { color: var(--c-primary); text-decoration-color: var(--c-primary); }
  .home h1, .home h2 { font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif; color: var(--c-strong); }

  /* Hero */
  .hero-index { border-bottom: 1px solid var(--c-border); margin: 0 0 3rem; padding-bottom: 2rem; }
  .hero-wrapper { display: flex; gap: 3rem; align-items: flex-start; }
  .hero-index h1 { font-size: 3rem; font-weight: 700; margin: 0 0 .5rem; line-height: 1.1; }
  .hero-description { font-size: 1.2rem; margin: 0 0 1.75rem; max-width: 600px; line-height: 1.5; }
  .hero-tagline { font-size: 1.3rem; line-height: 1.3; color: var(--c-text); }
  .heading-small { font-size: 1.3rem; margin: 0 0 1.25rem; }
  .hero-eras { list-style: none; margin: 0 0 1.25rem; padding: 0; max-width: 600px; font-size: 1.1rem; line-height: 1.5; }
  .hero-eras li { display: flex; gap: .75rem; align-items: baseline; margin-bottom: 1rem; }
  .hero-eras li > span:last-child { color: var(--c-strong); }
  .era-dates { flex: none; width: 90px; color: var(--c-muted); font-family: var(--mono2); font-size: .8rem; }
  .hero-image-container { position: relative; flex: none; margin-top: 4rem; }
  .hero-image-container::before { content: ''; position: absolute; left: 0; top: 1rem; width: 200px; height: 200px; border-radius: 50%; background: var(--c-primary); }
  .hero-image { position: relative; z-index: 1; display: block; width: 210px; height: 210px; object-fit: cover; border-radius: 50%; border: 3px solid var(--c-strong); margin-left: 16px; }
  .hero-bubble { position: relative; z-index: 1; max-width: 250px; margin-top: 1.25rem; padding: .6rem .9rem; background: var(--c-card); border: 1px solid var(--c-card-border); border-radius: var(--radius); font-size: .9rem; line-height: 1.5; text-align: center; }
  .hero-bubble::before { content: ''; position: absolute; top: -7px; left: 50%; width: 12px; height: 12px; background: var(--c-card); border-left: 1px solid var(--c-card-border); border-top: 1px solid var(--c-card-border); transform: translateX(-50%) rotate(45deg); }

  /* Secciones */
  .section-index { border-bottom: 1px solid var(--c-border); margin-bottom: 1.5rem; padding-bottom: 1.5rem; }
  .section-index:last-child { border-bottom: 0; }
  .heading-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .heading-row + .posts { margin-top: 1rem; }
  .heading-row h2 { margin: 0; font-size: 2rem; font-weight: 700; }
  .description { margin: 0 0 1.25rem; color: var(--c-muted); font-size: 1.05rem; max-width: 65ch; }
  .home a.button { display: inline-flex; align-items: center; padding: .4rem .65rem; font-size: 13px; font-weight: 600; line-height: 1.2; color: var(--c-text); background: var(--c-hover); border: 1.5px solid #c6ba93; border-radius: var(--radius); text-decoration: none; white-space: nowrap; }
  .home a.button:hover { background: var(--c-border); color: var(--c-text); }

  /* Listas de posts */
  .posts { display: flex; flex-direction: column; gap: .1rem; }
  .home a.post { display: flex; align-items: flex-start; gap: 1rem; margin-inline: -.625rem; padding: .5rem .625rem; border-radius: var(--radius); color: var(--c-strong); text-decoration: none; }
  .home a.post:hover { background: var(--c-hover); }
  .post-thumbnail { flex: none; width: 32px; display: flex; justify-content: center; font-size: 22px; line-height: 1.1; }
  .post-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .2rem; }
  .post-title { font-size: 1.1rem; font-weight: 600; line-height: 1.25; }
  .home a.post:hover .post-title { text-decoration: underline; text-decoration-color: var(--c-primary); text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .post-info time { font-family: var(--mono2); font-size: .85rem; font-weight: 400; color: var(--c-muted); }
  .post-description { margin: 0; color: var(--c-muted); font-weight: 400; line-height: 1.5; }
  .post-tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .35rem; max-width: 260px; }
  .tag { display: inline-flex; align-items: center; padding: .25rem .5rem; border: 1.5px solid var(--c-border); border-radius: var(--radius); font-family: var(--mono2); font-size: .8rem; font-weight: 500; line-height: 1; color: var(--c-text); background: transparent; }
  .tag::before { content: '#'; color: var(--c-primary); }

  /* Tarjetas */
  .cards { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); }
  .cards.cards-half { grid-template-columns: repeat(2, 1fr); }
  .card { background: var(--c-card); border: 2px solid var(--c-card-border); border-radius: var(--radius); padding: 1rem; box-shadow: none; }
  .home a.card { display: flex; flex-direction: column; gap: .4rem; color: var(--c-strong); text-decoration: none; line-height: 1.3; transition: border-color .15s; }
  .home a.card:hover { border-color: var(--c-primary); }
  .card-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .card-title { font-family: inherit; font-size: 1.1rem; font-weight: 600; margin: 0; color: var(--c-strong); }
  .home a.card-title { color: var(--c-primary); text-decoration: none; }
  .home a.card-title:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .chip { font-family: inherit; display: flex; align-items: center; justify-content: center; padding: 3px 6px; border: 1px solid var(--c-border); border-radius: 16px; font-size: .8rem; font-weight: 500; line-height: 1; color: var(--c-primary); background: none; box-shadow: none; }
  .card-shelf p { margin: 0; color: var(--c-muted); font-weight: 400; line-height: 1.5; }
  .card time { display: block; margin-bottom: .25rem; font-family: var(--mono2); font-size: 13px; color: var(--c-muted); }
  .card > p { margin: .35rem 0 .5rem; font-size: .95rem; line-height: 1.5; }
  .card-links { display: flex; gap: 1.25rem; }
  .card-links a { font-size: .9rem; color: var(--c-primary); text-underline-offset: 3px; }

  @media (max-width: 860px) {
    .hero-wrapper { flex-direction: column; gap: 1rem; }
    .hero-image-container { margin-top: 0; }
    .cards, .cards.cards-half { grid-template-columns: 1fr; }
    .post-tags { display: none; }
  }
</style>
