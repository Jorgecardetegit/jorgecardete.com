---
import BlogPostPage from '../../views/BlogPostPage.astro';
import { getBlogPosts, getBlogSlug } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getBlogPosts('es');
  return posts.map((post) => ({ params: { slug: getBlogSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
---
<BlogPostPage post={post} lang="es" />
