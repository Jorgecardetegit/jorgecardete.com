---
import Aprende from '../../../layouts/Aprende.astro';
import AfinidadMatriz from '../../../components/aprende/AfinidadMatriz.astro';
import CalendarioCard from '../../../components/aprende/CalendarioCard.astro';
import ComoVotar from '../../../components/aprende/ComoVotar.astro';
import MapaEspana from '../../../components/aprende/MapaEspana.astro';
import MapaFicha from '../../../components/aprende/MapaFicha.astro';
import EconomiaVista from '../../../components/aprende/EconomiaVista.astro';
import EventoFicha from '../../../components/aprende/EventoFicha.astro';
import GobiernosVista from '../../../components/aprende/GobiernosVista.astro';
import LineaTemporal from '../../../components/aprende/LineaTemporal.astro';
import TemasVista from '../../../components/aprende/TemasVista.astro';
import RankCard from '../../../components/aprende/RankCard.astro';
import { getArea } from '../../../data/learn';
import { elecciones, revisadoPartidos } from '../../../data/politica/partidos';
import { declaraciones, revisadoPactos, sinDeclaracion } from '../../../data/politica/pactos';
import { getLessons, learnPath } from '../../../lib/learn';
import {
  afinidadDe, diputadoPath, diputados, disputada, escanosActuales, fecha, partidoById, partidoPath, partidos, posicion, proponentes,
  resultadoTexto, tipos, tituloCorto, votaciones,
} from '../../../lib/politica';
import { breadcrumbs } from '../../../lib/seo';

const area = getArea('politica')!;
const lessons = await getLessons(area.id, area.sections.map((s) => s.id));

const porEscanos = [...partidos].sort((a, b) => escanosActuales(b.id) - escanosActuales(a.id) || (b.europa2024?.escanos ?? 0) - (a.europa2024?.escanos ?? 0));
const conDiputados = porEscanos.filter((p) => escanosActuales(p.id) > 0).map((p) => p.id);
const provincias = [...new Set(diputados.map((d) => d.provincia))].sort((a, b) => a.localeCompare(b, 'es'));
const stats = votaciones.diputados as Record<string, { presencia: number | null; conPartido: number | null }>;

// Votaciones clave y propuestas, de la más reciente a la más antigua.
const lista = [...votaciones.clave, ...votaciones.propuestas.map((p) => ({ ...p, votos: '' }))].sort(
  (a, b) => b.fecha.localeCompare(a.fecha),
);
const tiposFiltro = ['investidura', 'ley', 'decreto', 'totalidad', 'veto', 'propuesta'] as const;
const tipoLabel = (t: string) => (t === 'investidura' ? 'Investidura' : tipos[t as keyof typeof tipos]?.label ?? t);
const tipoPlural = (t: string) => (t === 'investidura' ? 'Investiduras' : tipos[t as keyof typeof tipos]?.plural ?? t);

// Resumen de una votación en una frase: qué partidos votaron sí, no y abstención (o «Todos» si
// coincidieron). En enmiendas y vetos, «sí» es apoyar la enmienda.
type Pos = 'S' | 'N' | 'A';
const posTexto = (tipo: string): Record<Pos, string> =>
  tipo === 'totalidad' ? { S: 'Apoyan la enmienda', N: 'En contra de la enmienda', A: 'Abstención' }
  : tipo === 'veto' ? { S: 'Apoyan el veto', N: 'En contra del veto', A: 'Abstención' }
  : { S: 'A favor', N: 'En contra', A: 'Abstención' };
function resumen(v: (typeof lista)[number]) {
  const grupos: Record<Pos, { id: string; div: boolean }[]> = { S: [], N: [], A: [] };
  for (const id of conDiputados) {
    const r = v.partidos?.[id as keyof typeof v.partidos] as number[] | undefined;
    const pos = posicion(r) as Pos | null;
    if (!pos || !r) continue;
    grupos[pos].push({ id, div: [r[0], r[1], r[2]].filter((x) => x > 0).length > 1 });
  }
  const orden = (['S', 'N', 'A'] as Pos[]).filter((p) => grupos[p].length);
  const mayor = [...orden].sort((a, b) => grupos[b].length - grupos[a].length)[0];
  return { grupos, mayor, orden, resto: orden.filter((p) => p !== mayor), textos: posTexto(v.tipo) };
}
// Votaciones clave (con desglose por partido) en que no todos los partidos votaron igual.
const disputadas = [...votaciones.clave, ...votaciones.propuestas].filter((v) => v.partidos && disputada(v, conDiputados));
const afinidadDisputadas = afinidadDe(disputadas, conDiputados);
const pctEsc = (n: number) => `${(n / 350) * 100}%`;

const leyes = votaciones.clave.filter((c) => c.tipo === 'ley');
const decretos = votaciones.clave.filter((c) => c.tipo === 'decreto');
const admitidas = votaciones.propuestas.filter((p) => p.resultado === 'aprobada').length;

const site = Astro.site!;
const jsonLd = [
  breadcrumbs([
    { name: 'Aprende', url: new URL(learnPath, site) },
    { name: area.title, url: new URL(Astro.url.pathname, site) },
  ]),
];
---
<Aprende title={area.title} description="Partidos, diputados y votaciones para entender las elecciones del 29 de noviembre de 2026, con datos oficiales del Congreso." jsonLd={jsonLd} area={area} lessons={lessons} mode="elecciones">
  <div class="ap-stage">
    <section class="ap-view ap-panel scroll" data-view-panel="partidos" aria-label="Partidos">
      <div class="pad">
        <header class="vhead vhead-row">
          <div>
            <h1 class="ap-view-title">Los partidos</h1>
            <p class="ap-view-sub" data-pv-sub="lista">Los que tenían escaño en el Congreso al disolverse las Cortes o eurodiputados. Misma ficha para todos.</p>
            <p class="ap-view-sub" data-pv-sub="mapa" hidden>Cada provincia es una circunscripción y reparte sus propios diputados. Cambia de capa y pulsa una provincia: su resultado de 2023 y quién la representaba aparecen a la derecha.</p>
          </div>
          <div class="pv-toggle" role="group" aria-label="Cómo ver los partidos">
            <button type="button" aria-pressed="true" data-pv="lista">Todos</button>
            <button type="button" aria-pressed="false" data-pv="mapa">Por comunidad</button>
          </div>
        </header>
        <div class="mapa-layout" data-pv-view="mapa" hidden>
          <MapaEspana />
        </div>
        <div data-pv-view="lista">
        <ul class="pgrid">
          {porEscanos.map((p) => {
            const max = Math.max(1, ...p.resultados.map((r) => r.escanos));
            const actuales = escanosActuales(p.id);
            return (
              <li>
                <a class="pcard" href={partidoPath(p.id)} style={`--pc: ${p.color}`}>
                  <span class="pcard-top">
                    <span class="pcard-siglas">{p.siglas}</span>
                    <span class="pcard-seats"><strong>{actuales || '—'}</strong>{actuales === 1 ? ' diputado' : actuales ? ' diputados' : ' sin diputados'}</span>
                  </span>
                  <span class="pcard-name">{p.nombre !== p.siglas ? p.nombre : p.ambito}</span>
                  <span class="pcard-meta">{p.lider.nombre} · {p.lider.cargo.split(' (')[0]}</span>
                  <span class="pcard-spark" aria-label={`Escaños: ${p.resultados.map((r) => `${r.eleccion} ${r.escanos}`).join(', ') || 'sin resultados en el Congreso'}`}>
                    {elecciones.map((e) => {
                      const r = p.resultados.find((x) => x.eleccion === e.id);
                      return (
                        <span class="spark-col" title={r ? `${e.label}: ${r.escanos} escaños${r.como ? ` (${r.como})` : ''}` : `${e.label}: no se presentó con estas siglas`}>
                          <i style={`height: ${r ? Math.max(4, (r.escanos / max) * 100) : 0}%`} class:list={{ none: !r }} />
                          <small>{e.label.replace('abr. ', 'A').replace('nov. ', 'N').replace('20', '’')}</small>
                        </span>
                      );
                    })}
                  </span>
                  <span class="pcard-foot">
                    <span class="pcard-chip">{p.ambito}</span>
                    <span class:list={['pcard-chip', `is-${p.candidatura.estado.replace(' ', '-')}`]}>
                      {p.candidatura.estado === 'por confirmar' ? 'Candidatura por confirmar' : `Candidato/a: ${p.candidatura.texto.split(',')[0]}`}
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="note">Líderes y candidaturas revisados el {fecha(revisadoPartidos, { day: 'numeric', month: 'long' })}. Las candidaturas oficiales se publican en el BOE a principios de noviembre; hasta entonces es lo anunciado por cada partido.</p>

        <h2 class="ap-view-title sub">Qué han dicho sobre los pactos</h2>
        <p class="ap-view-sub">Para ser investido hacen falta 176 votos en la primera votación, o más síes que noes en la segunda. Esto es lo que ha dicho cada partido sobre a quién apoyaría, con sus palabras y su fecha.</p>
        <ul class="pacto-list">
          {declaraciones.map((d) => {
            const p = partidoById.get(d.partido)!;
            return (
              <li class="pacto">
                <span class="pacto-head"><a class="pt" style={`--pc: ${p.color}`} href={partidoPath(p.id)}>{p.siglas}</a> <span class="pacto-who">{d.quien} · {fecha(d.fecha, { day: 'numeric', month: 'short' })}</span></span>
                <p>{d.texto}</p>
                {d.cita && <blockquote>«{d.cita}»</blockquote>}
                <a class="pacto-src" href={d.fuente.url}>{d.fuente.titulo}</a>
              </li>
            );
          })}
        </ul>
        <p class="note">Sin una declaración clara sobre a quién apoyarían: {sinDeclaracion.map((id) => partidoById.get(id)!.siglas).join(', ')}. Revisado el {fecha(revisadoPactos, { day: 'numeric', month: 'long' })}; en campaña las posturas cambian, y lo que digan antes de votar no obliga después.</p>

        <h2 class="ap-view-title sub">Con quién vota cada partido</h2>
        <div class="vhead-row afi-head">
          <p class="ap-view-sub">Lo que han hecho, más allá de lo que dicen: coincidencias en las votaciones de esta legislatura.</p>
          <div class="pv-toggle" role="group" aria-label="Qué votaciones contar">
            <button type="button" aria-pressed="true" data-afi="disputadas">Solo las disputadas</button>
            <button type="button" aria-pressed="false" data-afi="todas">Todas</button>
          </div>
        </div>
        <div data-afi-view="disputadas">
          <AfinidadMatriz
            orden={conDiputados}
            datos={afinidadDisputadas}
            pie={`Porcentaje de las ${disputadas.length} votaciones clave de la legislatura (leyes, decretos, investiduras, enmiendas a la totalidad, vetos y propuestas de los grupos) en que no todos los partidos votaron igual y la mayoría de dos partidos votó lo mismo.`}
          />
        </div>
        <div data-afi-view="todas" hidden>
          <AfinidadMatriz orden={conDiputados} />
        </div>
        </div>
      </div>
    </section>

    <section class="ap-view ap-panel scroll" data-view-panel="temas" aria-label="Temas" hidden>
      <div class="pad">
        <header class="vhead">
          <h2 class="ap-view-title">Tema a tema</h2>
          <p class="ap-view-sub">Elige un tema: quién decide sobre él, qué han votado los partidos en esta legislatura y con quién coincide cada uno.</p>
        </header>
        <TemasVista />
      </div>
    </section>

    <section class="ap-view ap-panel scroll" data-view-panel="historia" aria-label="Historia" hidden>
      <div class="pad">
        <header class="vhead vhead-row">
          <div>
            <h2 class="ap-view-title" data-hv-sub="hechos">Qué ha pasado desde 1975</h2>
            <h2 class="ap-view-title" data-hv-sub="gobiernos" hidden>Qué ha hecho cada gobierno</h2>
            <p class="ap-view-sub" data-hv-sub="hechos">Desde la muerte de Franco, los hechos que cambiaron quién gobierna, qué leyes rigen o el contexto en que vamos a votar, contados sin adjetivos y con fuente. Pulsa uno para ver el detalle.</p>
            <p class="ap-view-sub" data-hv-sub="gobiernos" hidden>Todos los gobiernos desde la muerte de Franco, uno por investidura: si un presidente repite, cada mandato va por separado. Pulsa uno para leer cómo llegó, con quién gobernó, qué hizo y cómo terminó.</p>
          </div>
          <div class="pv-toggle" role="group" aria-label="Cómo ver la historia">
            <button type="button" aria-pressed="true" data-hv="hechos">Qué ha pasado</button>
            <button type="button" aria-pressed="false" data-hv="gobiernos">Gobiernos</button>
          </div>
        </header>
        <div data-hv-view="hechos"><LineaTemporal /></div>
        <div data-hv-view="gobiernos" hidden><GobiernosVista /></div>
      </div>
    </section>

    <section class="ap-view ap-panel scroll" data-view-panel="economia" aria-label="Economía" hidden>
      <div class="pad">
        <header class="vhead">
          <h2 class="ap-view-title">Cómo ha ido la economía</h2>
          <p class="ap-view-sub">Las preguntas que se hace cualquiera, respondidas con datos oficiales desde 2004 y con Europa al lado. Elige un tema.</p>
        </header>
        <EconomiaVista />
      </div>
    </section>

    <section class="ap-view ap-panel scroll" data-view-panel="votar" aria-label="Cómo votar" hidden>
      <div class="pad">
        <header class="vhead">
          <h2 class="ap-view-title">Cómo votar el 29 de noviembre</h2>
          <p class="ap-view-sub">Lo práctico, en el orden en que lo vas a necesitar: el censo, el voto por correo, el voto desde fuera y el día de la votación.</p>
        </header>
        <ComoVotar />
      </div>
    </section>

    <section class="ap-view ap-panel scroll" data-view-panel="diputados" aria-label="Diputados" hidden>
      <div class="pad">
        <header class="vhead">
          <h2 class="ap-view-title">Los 350 diputados</h2>
          <p class="ap-view-sub">Los de la legislatura que termina, con su biografía oficial, su asistencia y cuánto votan con su partido.</p>
        </header>
        <div class="filters" data-dip-filters>
          <input type="search" class="finput" placeholder="Nombre" aria-label="Buscar diputado por nombre" data-f-nombre />
          <select class="fselect" aria-label="Partido" data-f-partido>
            <option value="">Todos los partidos</option>
            {conDiputados.map((id) => <option value={id}>{partidoById.get(id)!.siglas}</option>)}
            <option value="otro">Otros (Grupo Mixto)</option>
          </select>
          <select class="fselect" aria-label="Provincia" data-f-provincia>
            <option value="">Todas las provincias</option>
            {provincias.map((p) => <option value={p}>{p}</option>)}
          </select>
          <select class="fselect" aria-label="Ordenar" data-f-orden>
            <option value="nombre">Orden: apellido</option>
            <option value="legs">Más legislaturas</option>
            <option value="presencia">Más asistencia</option>
            <option value="presencia-asc">Menos asistencia</option>
            <option value="partido-asc">Menos votan con su partido</option>
          </select>
          <span class="fcount"><strong data-f-count>350</strong> diputados</span>
        </div>
        <div class="dtable" role="table" aria-label="Diputados">
          <div class="drow dhead" role="row">
            <span role="columnheader">Diputado</span>
            <span role="columnheader">Provincia</span>
            <span role="columnheader" title="Legislaturas como diputado">Leg.</span>
            <span role="columnheader" title="Votaciones en que votó, sobre las que pudo votar">Asistencia</span>
            <span role="columnheader" title="Votaciones en que votó lo mismo que la mayoría de su partido">Con su partido</span>
          </div>
          {diputados.map((d) => {
            const p = d.partido ? partidoById.get(d.partido) : undefined;
            const s = stats[d.id];
            return (
              <a class="drow" role="row" href={diputadoPath(d.id)} data-nombre={d.nombre.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase()} data-partido={d.partido ?? 'otro'} data-provincia={d.provincia} data-legs={d.legislaturas.length} data-presencia={s?.presencia ?? -1} data-conpartido={s?.conPartido ?? 101} data-clave={d.clave}>
                <span role="cell" class="dname"><span class="pt" style={`--pc: ${p?.color ?? 'var(--muted)'}`}>{p?.siglas ?? 'Mixto'}</span>{d.nombre}</span>
                <span role="cell" class="dmuted">{d.provincia}</span>
                <span role="cell" class="dnum">{d.legislaturas.length}</span>
                <span role="cell" class="dnum">{s?.presencia != null ? `${Math.round(s.presencia)} %` : '—'}</span>
                <span role="cell" class="dnum">{s?.conPartido != null ? `${Math.round(s.conPartido)} %` : '—'}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="ap-view ap-panel scroll" data-view-panel="votaciones" aria-label="Votaciones" hidden>
      <div class="pad">
        <header class="vhead">
          <h2 class="ap-view-title">Qué se ha votado</h2>
          <p class="ap-view-sub">Investiduras, aprobación de leyes, decretos del Gobierno, enmiendas a la totalidad, vetos del Senado y las leyes que propuso cada grupo. Y cómo votó cada partido. Ojo: en una enmienda a la totalidad, votar «sí» es querer tumbar el texto.</p>
        </header>
        <div class="filters" data-vot-filters>
          <input type="search" class="finput" placeholder="Busca: vivienda, amnistía, pensiones..." aria-label="Buscar votación" data-v-texto />
          <div class="chips" role="group" aria-label="Tipo de votación">
            <button type="button" class="pchip" aria-pressed="true" data-v-tipo="">Todas</button>
            {tiposFiltro.map((t) => <button type="button" class="pchip" aria-pressed="false" data-v-tipo={t}>{tipoPlural(t)}</button>)}
          </div>
          <span class="fcount"><strong data-v-count>{lista.length}</strong> votaciones</span>
        </div>
        <div class="vlegend" aria-hidden="true">
          <span class="vlegend-bar">Barra: los 350 escaños</span>
          <span><i class="vsw vs-S"></i> sí</span><span><i class="vsw vs-N"></i> no</span><span><i class="vsw vs-A"></i> abstención</span><span><i class="vsw vs-nv"></i> no votan</span>
          <span class="vlegend-tip">Despliega una votación para ver el voto de cada partido</span>
        </div>
        <ol class="vlist">
          {lista.map((v) => (
            <li data-tipo={v.tipo} data-texto={`${v.titulo} ${v.detalle ?? ''}`.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase()}>
              <details class="vitem">
                <summary>
                  <span class="vdate">{fecha(v.fecha)}</span>
                  <span class="vbody">
                    <span class="vtags">
                      <span class="vtype">{tipoLabel(v.tipo)}</span>
                      <span class:list={['vres', v.resultado === 'aprobada' ? 'ok' : 'ko']}>{resultadoTexto(v.tipo, v.resultado)}</span>
                      {v.tipo === 'propuesta' && <span class="vprop">Propone: {proponentes(v).texto}</span>}
                    </span>
                    <span class="vtitle">{tituloCorto(v)}</span>
                    {(() => {
                      if (!v.partidos) return <span class="vwho muted">Sin desglose por partido</span>;
                      const { grupos, mayor, resto, orden, textos } = resumen(v);
                      // Los dos partidos con más escaños de cada grupo; el resto, tras el botón «+N» (si son
                      // tres, se ven los tres: un «+1» no ahorra nada).
                      const nombres = (p: Pos) => {
                        const visibles = grupos[p].length <= 3 ? 3 : 2;
                        const items = grupos[p].map((x, k) => <span class:list={{ 'vwho-extra': k >= visibles }}>{k > 0 && ', '}<span class="pt" style={`--pc: ${partidoById.get(x.id)!.color}`}>{partidoById.get(x.id)!.siglas}{x.div && <em> (dividido)</em>}</span></span>);
                        const extra = grupos[p].length - visibles;
                        return <>{items}{extra > 0 && <button type="button" class="vwho-more" data-who-more aria-expanded="false" aria-label={`Ver ${extra} partidos más`}>+{extra}</button>}</>;
                      };
                      return (
                        <span class="vwho">
                          {resto.length === 0 ? <span class={`c-${mayor}`}>Todos: {textos[mayor].toLowerCase()}</span>
                            : orden.map((p) => <span class="vwho-g"><b class={`c-${p}`}>{textos[p]}:</b> {nombres(p)}</span>)}
                        </span>
                      );
                    })()}
                  </span>
                  <span class="vbar-wrap">
                    <span class="vbar" role="img" aria-label={`${v.totales.si} sí, ${v.totales.no} no, ${v.totales.abs} abstenciones, ${v.totales.nv} no votan`}>
                      <i class="vs-S" style={`width: ${pctEsc(v.totales.si)}`} />
                      <i class="vs-N" style={`width: ${pctEsc(v.totales.no)}`} />
                      <i class="vs-A" style={`width: ${pctEsc(v.totales.abs)}`} />
                    </span>
                    <span class="vbar-num"><b class="c-S">{v.totales.si}</b> sí · <b class="c-N">{v.totales.no}</b> no{v.totales.abs > 0 && <> · <b class="c-A">{v.totales.abs}</b> abst.</>}</span>
                  </span>
                </summary>
                <div class="vdetail">
                  {v.partidos && (
                    <ul class="vgrid">
                      {conDiputados.map((id) => {
                        const r = v.partidos?.[id as keyof typeof v.partidos] as number[] | undefined;
                        const pos = posicion(r);
                        const div = r && [r[0], r[1], r[2]].filter((x) => x > 0).length > 1;
                        return (
                          <li title={r ? `${r[0]} sí, ${r[1]} no, ${r[2]} abst.` : 'sin desglose'}>
                            <i class:list={['vt', pos ? `vt-${pos}` : 'vt-x']}>{pos ? (div ? '½' : pos) : '·'}</i>
                            <span class="pt" style={`--pc: ${partidoById.get(id)!.color}`}>{partidoById.get(id)!.siglas}</span>
                            {r && div && <small>{r[0]}/{r[1]}/{r[2]}</small>}
                          </li>
                        );
                      })}
                    </ul>
                  )}
                  <p class="vfull"><span class="vfull-l">Título oficial:</span> {v.titulo}{v.detalle && <span> · {v.detalle}</span>}</p>
                  <p class="vtot"><strong>{v.totales.si}</strong> sí · <strong>{v.totales.no}</strong> no · <strong>{v.totales.abs}</strong> abstenciones · {v.totales.nv} no votan</p>
                  {'nota' in v && v.nota && <p class="vnote">{v.nota}</p>}
                  {!v.partidos && <p class="vnote">El Congreso no publica el desglose por diputado de esta votación en sus datos abiertos.</p>}
                  {'fuente' in v && v.fuente && <p class="vnote"><a href={v.fuente as string}>Fuente</a></p>}
                </div>
              </details>
            </li>
          ))}
        </ol>
        <p class="vempty" hidden data-v-empty>No hay votaciones con esos filtros.</p>
      </div>
    </section>
  </div>

  <Fragment slot="aside">
    <MapaFicha />
    <EventoFicha />
    <CalendarioCard />

    <section class="ap-card ap-panel">
      <header class="ap-card-head">
        <h2 class="ap-card-title">El Congreso que se disuelve</h2>
        <span class="ap-card-count">· 350</span>
      </header>
      <div class="hemi-bar" aria-hidden="true">
        {porEscanos.filter((p) => escanosActuales(p.id) > 0).map((p) => <i style={`flex: ${escanosActuales(p.id)}; background: ${p.color}`} title={`${p.siglas}: ${escanosActuales(p.id)}`} />)}
        <i style={`flex: ${diputados.filter((d) => !d.partido).length}; background: var(--muted)`} title="Otros en el Grupo Mixto" />
      </div>
      <div class="hemi-mark" aria-hidden="true"><span>176 = mayoría absoluta</span></div>
      <ul class="hemi-legend">
        {porEscanos.filter((p) => escanosActuales(p.id) > 0).map((p) => <li><span class="pt" style={`--pc: ${p.color}`}>{p.siglas}</span> {escanosActuales(p.id)}</li>)}
        <li><span class="pt">Otros</span> {diputados.filter((d) => !d.partido).length}</li>
      </ul>
    </section>

    <section class="ap-card ap-panel">
      <header class="ap-card-head">
        <h2 class="ap-card-title">El Senado saliente</h2>
        <a class="ap-card-link" href="/aprende/politica/cortes/">Lección</a>
      </header>
      <p>El PP tenía mayoría absoluta: <strong>143</strong> de 266 senadores (la mitad más uno es 134). El 29-N se eligen 208; el resto los designan después los parlamentos autonómicos.</p>
      <p class="sen-note">Puede enmendar o vetar las leyes, aunque el Congreso puede levantar el veto. Su voto es imprescindible para reformar la Constitución o aplicar el artículo 155. <a href="https://www.senado.es/web/composicionorganizacion/senadores/composicionsenado/consultagrupoparlamentario/index.html">Fuente: Senado</a></p>
    </section>

    <RankCard
      titulo="La legislatura en cifras"
      filas={[
        { label: 'Votaciones nominales', valor: votaciones.total, texto: votaciones.total.toLocaleString('es-ES') },
        { label: 'Leyes aprobadas en el Congreso', valor: leyes.filter((c) => c.resultado === 'aprobada').length },
        { label: 'Leyes rechazadas en la votación final', valor: leyes.filter((c) => c.resultado === 'rechazada').length },
        { label: 'Decretos-ley convalidados', valor: decretos.filter((c) => c.resultado === 'aprobada').length },
        { label: 'Decretos-ley derogados', valor: decretos.filter((c) => c.resultado === 'rechazada').length },
        { label: 'Propuestas de ley admitidas a trámite', valor: admitidas },
      ]}
      max={60}
      limite={6}
      nota={`Del ${fecha(votaciones.desde!)} a la disolución. Fuente: datos abiertos del Congreso.`}
    />

    <section class="ap-card ap-panel">
      <header class="ap-card-head"><h2 class="ap-card-title">Cómo está hecho</h2></header>
      <p>Diputados y votaciones salen de los datos abiertos del Congreso, procesados sin seleccionar a mano: se incluyen todas las votaciones de cada tipo. Las pocas que el Congreso solo publica como imagen se añadieron a mano con su fuente.</p>
      <p class="sen-note"><strong>Sin encuestas.</strong> Aquí solo hay hechos: lo que se ha votado, lo que se ha dicho y lo que se ha medido. Las encuestas estiman lo que pasará, difieren mucho entre empresas y métodos, y pueden influir en el propio voto. Se pueden publicar hasta el 23 de noviembre.</p>
    </section>
  </Fragment>
</Aprende>

<script>
  // «+N» en el resumen de una votación: muestra el resto de partidos sin abrir el desplegable.
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-who-more]');
    if (!b) return;
    e.preventDefault();
    e.stopPropagation();
    const g = b.closest('.vwho-g')!;
    const open = g.classList.toggle('open');
    b.setAttribute('aria-expanded', String(open));
    b.textContent = open ? '−' : `+${g.querySelectorAll('.vwho-extra').length}`;
  });
  // Pestañas: cambian de vista sin recargar y lo recuerdan en la URL.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-view-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-view-panel]')];
  // En Partidos, «Todos» (las fichas) o «Por comunidad» (el mapa). #mapa abre el mapa.
  const pvBotones = [...document.querySelectorAll<HTMLButtonElement>('[data-pv]')];
  const verPartidos = (como: string) => {
    for (const b of pvBotones) b.setAttribute('aria-pressed', String(b.dataset.pv === como));
    for (const el of document.querySelectorAll<HTMLElement>('[data-pv-view]')) el.hidden = el.dataset.pvView !== como;
    for (const el of document.querySelectorAll<HTMLElement>('[data-pv-sub]')) el.hidden = el.dataset.pvSub !== como;
  };
  // En Historia, «Qué ha pasado» (la línea temporal) o «Gobiernos». #gobiernos abre los gobiernos.
  const hvBotones = [...document.querySelectorAll<HTMLButtonElement>('[data-hv]')];
  const verHistoria = (como: string) => {
    for (const b of hvBotones) b.setAttribute('aria-pressed', String(b.dataset.hv === como));
    for (const el of document.querySelectorAll<HTMLElement>('[data-hv-view]')) el.hidden = el.dataset.hvView !== como;
    for (const el of document.querySelectorAll<HTMLElement>('[data-hv-sub]')) el.hidden = el.dataset.hvSub !== como;
  };
  const open = (view: string) => {
    verPartidos(view === 'mapa' ? 'mapa' : 'lista');
    verHistoria(view === 'gobiernos' ? 'gobiernos' : 'hechos');
    if (view === 'gobiernos') view = 'historia';
    if (view === 'mapa' || !panels.some((p) => p.dataset.viewPanel === view)) view = 'partidos';
    for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.viewTab === view));
    for (const p of panels) p.hidden = p.dataset.viewPanel !== view;
    document.dispatchEvent(new Event('ap:reset'));
  };
  for (const b of pvBotones) {
    b.addEventListener('click', () => {
      verPartidos(b.dataset.pv!);
      document.dispatchEvent(new Event('ap:reset'));
      history.replaceState(null, '', b.dataset.pv === 'mapa' ? '#mapa' : location.pathname);
    });
  }
  for (const b of hvBotones) {
    b.addEventListener('click', () => {
      verHistoria(b.dataset.hv!);
      document.dispatchEvent(new Event('ap:reset'));
      history.replaceState(null, '', b.dataset.hv === 'gobiernos' ? '#gobiernos' : '#historia');
    });
  }
  for (const t of tabs) {
    t.addEventListener('click', () => {
      open(t.dataset.viewTab!);
      history.replaceState(null, '', t.dataset.viewTab === 'partidos' ? location.pathname : `#${t.dataset.viewTab}`);
    });
  }
  open(location.hash.slice(1));
  addEventListener('hashchange', () => open(location.hash.slice(1)));

  // Con quién vota cada partido: solo las votaciones disputadas o todas.
  const afiBotones = [...document.querySelectorAll<HTMLButtonElement>('[data-afi]')];
  for (const b of afiBotones) {
    b.addEventListener('click', () => {
      for (const o of afiBotones) o.setAttribute('aria-pressed', String(o === b));
      for (const el of document.querySelectorAll<HTMLElement>('[data-afi-view]')) el.hidden = el.dataset.afiView !== b.dataset.afi;
    });
  }

  const norm = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();

  // Diputados: filtros y orden.
  const table = document.querySelector<HTMLElement>('.dtable')!;
  const rows = [...table.querySelectorAll<HTMLElement>('a.drow')];
  const fNombre = document.querySelector<HTMLInputElement>('[data-f-nombre]')!;
  const fPartido = document.querySelector<HTMLSelectElement>('[data-f-partido]')!;
  const fProvincia = document.querySelector<HTMLSelectElement>('[data-f-provincia]')!;
  const fOrden = document.querySelector<HTMLSelectElement>('[data-f-orden]')!;
  const fCount = document.querySelector('[data-f-count]')!;
  const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    nombre: (a, b) => a.dataset.clave!.localeCompare(b.dataset.clave!, 'es'),
    legs: (a, b) => Number(b.dataset.legs) - Number(a.dataset.legs),
    presencia: (a, b) => Number(b.dataset.presencia) - Number(a.dataset.presencia),
    'presencia-asc': (a, b) => Number(a.dataset.presencia) - Number(b.dataset.presencia),
    'partido-asc': (a, b) => Number(a.dataset.conpartido) - Number(b.dataset.conpartido),
  };
  const filterDip = () => {
    const q = norm(fNombre.value);
    let n = 0;
    for (const r of rows) {
      const ok = (!q || r.dataset.nombre!.includes(q)) && (!fPartido.value || r.dataset.partido === fPartido.value) && (!fProvincia.value || r.dataset.provincia === fProvincia.value);
      r.hidden = !ok;
      if (ok) n++;
    }
    fCount.textContent = String(n);
  };
  const sortDip = () => {
    const sorted = [...rows].sort(sorters[fOrden.value]);
    for (const r of sorted) table.append(r);
  };
  fNombre.addEventListener('input', filterDip);
  fPartido.addEventListener('change', filterDip);
  fProvincia.addEventListener('change', filterDip);
  fOrden.addEventListener('change', sortDip);

  // Votaciones: tipo y texto.
  const items = [...document.querySelectorAll<HTMLElement>('.vlist > li')];
  const vTexto = document.querySelector<HTMLInputElement>('[data-v-texto]')!;
  const vTipos = [...document.querySelectorAll<HTMLButtonElement>('[data-v-tipo]')];
  const vCount = document.querySelector('[data-v-count]')!;
  const vEmpty = document.querySelector<HTMLElement>('[data-v-empty]')!;
  let tipo = '';
  const filterVot = () => {
    const q = norm(vTexto.value);
    let n = 0;
    for (const li of items) {
      const ok = (!tipo || li.dataset.tipo === tipo) && (!q || li.dataset.texto!.includes(q));
      li.hidden = !ok;
      if (ok) n++;
    }
    vCount.textContent = String(n);
    vEmpty.hidden = n > 0;
  };
  vTexto.addEventListener('input', filterVot);
  for (const b of vTipos) {
    b.addEventListener('click', () => {
      tipo = b.dataset.vTipo!;
      for (const x of vTipos) x.setAttribute('aria-pressed', String(x === b));
      filterVot();
    });
  }
</script>

