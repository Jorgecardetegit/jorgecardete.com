---
import Aprende from '../../../layouts/Aprende.astro';
import CalendarioCard from '../../../components/aprende/CalendarioCard.astro';
import PoderesLienzo from '../../../components/aprende/PoderesLienzo.astro';
import RankCard from '../../../components/aprende/RankCard.astro';
import { getArea } from '../../../data/learn';
import { competencias, niveles, type Nivel } from '../../../data/politica/competencias';
import { escanosFuente, escanosPorProvincia } from '../../../data/politica/escanos';
import { instituciones } from '../../../data/politica/poderes';
import { areaPath, getLessons, learnPath, lessonPath, lessonSlug } from '../../../lib/learn';
import { breadcrumbs } from '../../../lib/seo';

const area = getArea('politica')!;
const lessons = await getLessons(area.id, area.sections.map((s) => s.id));
const bySlug = new Map(lessons.map((l) => [lessonSlug(l), l]));
const lessonsFor = (slugs: string[]) => slugs.map((s) => bySlug.get(s)!).filter(Boolean);


const porNivel = (Object.keys(niveles) as Nivel[])
  .map((n) => ({ label: niveles[n].label, valor: competencias.filter((c) => c.quien.includes(n)).length, href: `${learnPath}politica/territorio/#quién-se-encarga-de-qué` }))
  .sort((a, b) => b.valor - a.valor);

const site = Astro.site!;
const jsonLd = [
  breadcrumbs([
    { name: 'Aprende', url: new URL(learnPath, site) },
    { name: area.title, url: new URL(areaPath(area.id), site) },
    { name: 'Cómo funciona', url: new URL(Astro.url.pathname, site) },
  ]),
];
---
<Aprende title={`Cómo funciona · ${area.title}`} description="Cómo funciona el sistema político español: quién elige a quién y 14 lecciones desde cero." jsonLd={jsonLd} area={area} lessons={lessons} mode="como-funciona">
  <div class="ap-stage">
    <section class="ap-view ap-panel" aria-label="Quién elige a quién">
      <header class="ap-view-head">
        <div>
          <h1 class="ap-view-title">Quién elige a quién</h1>
          <p class="ap-view-sub">Pulsa una institución para ver qué hace y con quién se conecta.</p>
        </div>
      </header>
      <PoderesLienzo />
    </section>

    <section class="ap-detail ap-panel" aria-live="polite" data-detail-panel>
      <div data-detail="intro">
        <div class="ap-detail-head">
          <span class="ap-detail-icon" aria-hidden="true">🧭</span>
          <h2 class="ap-detail-title">Empieza aquí</h2>
          <span class="ap-detail-meta">{lessons.length} lecciones · de 3 a 5 minutos cada una</span>
        </div>
        <p>Todo lo que hace falta para entender cómo funciona España antes de votar, explicado desde cero y con fuentes oficiales. Pulsa las piezas del esquema o entra directamente en una lección.</p>
        <div class="ap-chips">
          {lessons.map((l) => <a class="ap-chip" href={lessonPath(l)} data-lesson-chip={l.id}><span aria-hidden="true">{l.data.icon}</span>{l.data.title}</a>)}
        </div>
      </div>

      {instituciones.map((inst) => (
        <div data-detail={`inst:${inst.id}`} hidden>
          <div class="ap-detail-head">
            <span class="ap-detail-icon" aria-hidden="true">{inst.icono}</span>
            <h2 class="ap-detail-title">{inst.nombre}</h2>
            <span class="ap-detail-meta">{inst.etiqueta}</span>
            <button type="button" class="ap-detail-close" data-reset>✕ Cerrar</button>
          </div>
          <p>{inst.resumen}</p>
          <ul class="ap-facts">{inst.hechos.map((h) => <li>{h}</li>)}</ul>
          <div class="ap-chips">
            {lessonsFor(inst.lecciones).map((l) => <a class="ap-chip" href={lessonPath(l)} data-lesson-chip={l.id}><span aria-hidden="true">{l.data.icon}</span>Lección: {l.data.title}</a>)}
          </div>
        </div>
      ))}

    </section>
  </div>

  <Fragment slot="aside">
    <CalendarioCard />

    <RankCard
      titulo="Diputados por provincia"
      cuenta="52"
      filas={escanosPorProvincia.map(([label, valor]) => ({ label, valor }))}
      nota={`Reparto oficial de 2026. Fuente: ${escanosFuente.title}.`}
    />

    <RankCard
      titulo="Mayorías del Congreso"
      cuenta="350"
      max={350}
      filas={[
        { label: 'Absoluta: investidura, leyes orgánicas', valor: 176, href: lessonPath(bySlug.get('cortes')!) },
        { label: '3/5: CGPJ, Tribunal Constitucional', valor: 210, href: lessonPath(bySlug.get('cortes')!) },
        { label: '2/3: reforma agravada', valor: 234, href: lessonPath(bySlug.get('constitucion')!) },
      ]}
    />

    <RankCard
      titulo="Senado"
      cuenta="266"
      max={266}
      filas={[
        { label: 'Elegidos en las urnas', valor: 208, href: lessonPath(bySlug.get('elecciones')!) },
        { label: 'Designados por las comunidades', valor: 58, href: lessonPath(bySlug.get('territorio')!) },
      ]}
    />

    <RankCard
      titulo="Quién se encarga"
      cuenta={`${competencias.length} temas`}
      max={competencias.length}
      filas={porNivel}
      nota="En cuántos de los grandes temas (sanidad, vivienda, policía...) interviene cada administración."
    />
  </Fragment>
</Aprende>

<script>
  for (const b of document.querySelectorAll('[data-reset]')) {
    b.addEventListener('click', () => document.dispatchEvent(new Event('ap:reset')));
  }
</script>

