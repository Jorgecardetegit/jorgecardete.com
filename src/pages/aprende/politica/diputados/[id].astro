---
import Aprende from '../../../../layouts/Aprende.astro';
import { getArea } from '../../../../data/learn';
import { getLessons, learnPath } from '../../../../lib/learn';
import {
  diputadoPath, diputados, fecha, fechaCongreso, partidoById, partidoPath, posicion, resultadoTexto, tipos, tituloCorto,
  votaciones, votoTexto, type Diputado,
} from '../../../../lib/politica';
import { breadcrumbs } from '../../../../lib/seo';

export function getStaticPaths() {
  return diputados.map((d, i) => ({ params: { id: d.id }, props: { diputado: d, indice: i } }));
}

interface Props { diputado: Diputado; indice: number }
const { diputado: d, indice } = Astro.props;
const area = getArea('politica')!;
const lessons = await getLessons(area.id, area.sections.map((s) => s.id));
const p = d.partido ? partidoById.get(d.partido) : undefined;
const s = (votaciones.diputados as Record<string, { votaciones: number; presencia: number | null; conPartido: number | null }>)[d.id];

const romanos = ['Constituyente', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII', 'XIV', 'XV'];
const tipoLabel = (t: string) => (t === 'investidura' ? 'Investidura' : tipos[t as keyof typeof tipos]?.label ?? t);

// Su voto en cada votación clave en la que era diputado, frente a la posición de su partido.
const suyas = [...votaciones.clave]
  .reverse()
  .map((v) => {
    const voto = v.votos[indice] ?? '·';
    const r = d.partido ? (v.partidos as Record<string, number[]> | null)?.[d.partido] : undefined;
    const delPartido = posicion(r);
    return { v, voto, delPartido, distinto: !!delPartido && ['S', 'N', 'A'].includes(voto) && voto !== delPartido };
  })
  .filter((x) => x.voto !== '·');
const distintas = suyas.filter((x) => x.distinto);
const companeros = diputados.filter((x) => x.provincia === d.provincia && x.id !== d.id);

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: d.nombre,
    jobTitle: 'Diputado en el Congreso de los Diputados (XV legislatura)',
    ...(p && { affiliation: { '@type': 'PoliticalParty', name: p.nombre } }),
  },
  breadcrumbs([
    { name: 'Aprende', url: new URL(learnPath, site) },
    { name: area.title, url: new URL('/aprende/politica/', site) },
    { name: d.nombre, url: new URL(Astro.url.pathname, site) },
  ]),
];
---
<Aprende title={d.nombre} description={`${d.nombre}, diputado por ${d.provincia} (${d.formacion}) en la XV legislatura: biografía oficial, asistencia, cómo ha votado y cuándo votó distinto a su partido.`} jsonLd={jsonLd} area={area} lessons={lessons} section="diputados">
  <article class="ap-panel page" style={`--pc: ${p?.color ?? 'var(--muted)'}`}>
    <header class="phead">
      <div class="phead-band" aria-hidden="true"></div>
      <p class="kicker"><a href="/aprende/politica/#diputados">Diputados</a> · {d.provincia}</p>
      <h1>{d.nombre}</h1>
      <p class="sub">
        {p ? <a class="pt" style={`--pc: ${p.color}`} href={partidoPath(p.id)}>{p.siglas}</a> : <span class="pt">Grupo Mixto</span>}
        <span>Elegido/a en la lista de {d.formacion} · Grupo {d.grupo}</span>
        <span>Diputado/a desde el {fechaCongreso(d.alta)}</span>
      </p>
      <div class="stats">
        <div><strong>{s?.presencia != null ? `${Math.round(s.presencia)} %` : '—'}</strong><span>asistencia a las votaciones</span></div>
        <div><strong>{s?.conPartido != null ? `${Math.round(s.conPartido)} %` : '—'}</strong><span>de veces vota como su partido</span></div>
        <div><strong>{d.legislaturas.length}</strong><span>{d.legislaturas.length === 1 ? 'legislatura (la primera)' : 'legislaturas como diputado/a'}</span></div>
        <div><strong>{distintas.length}</strong><span>votaciones clave en que votó distinto a su partido</span></div>
      </div>
    </header>

    <section class="block">
      <h2>Biografía oficial</h2>
      {d.bio.length > 0 ? (
        <p class="bio">{d.bio.join(' · ')}</p>
      ) : (
        <p class="muted">El Congreso no publica biografía de este diputado.</p>
      )}
      <p class="muted small">Texto que el propio Congreso publica en su ficha, sin editar.</p>
    </section>

    <section class="block">
      <h2>Trayectoria en el Congreso</h2>
      <ol class="legs" aria-label="Legislaturas">
        {romanos.slice(1).map((r) => <li class:list={{ on: d.legislaturas.includes(r) }} title={`${r} legislatura`}>{r}</li>)}
      </ol>
      <p class="muted small">Legislaturas en las que ha sido diputado/a, desde la I (1979) hasta la XV (2023-2026).</p>
    </section>

    {distintas.length > 0 && (
      <section class="block">
        <h2>Cuando votó distinto a su partido</h2>
        <ol class="plist">
          {distintas.map(({ v, voto, delPartido }) => (
            <li>
              <span class:list={['vt', `vt-${voto}`]}>{voto}</span>
              <span class="plist-body">
                <span class="plist-meta">{fecha(v.fecha)} · {tipoLabel(v.tipo)} · su partido votó «{votoTexto[delPartido!]}»</span>
                <span class="plist-title">{tituloCorto(v)}</span>
              </span>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="block">
      <h2>Sus votos en las votaciones clave</h2>
      {suyas.length > 0 ? (
        <>
          <ol class="plist" data-more-list>
            {suyas.map(({ v, voto, distinto }, i) => (
              <li hidden={i >= 15} class:list={{ distinto }}>
                <span class:list={['vt', ['S', 'N', 'A'].includes(voto) ? `vt-${voto}` : 'vt-x']}>{['S', 'N', 'A'].includes(voto) ? voto : '·'}</span>
                <span class="plist-body">
                  <span class="plist-meta">{fecha(v.fecha)} · {tipoLabel(v.tipo)} · <b class:list={[v.resultado === 'aprobada' ? 'ok' : 'ko']}>{resultadoTexto(v.tipo, v.resultado)}</b></span>
                  <span class="plist-title">{tituloCorto(v)}</span>
                </span>
                <span class="plist-vote">{votoTexto[voto]}</span>
              </li>
            ))}
          </ol>
          {suyas.length > 15 && <button type="button" class="more" data-more>Ver las {suyas.length}</button>}
        </>
      ) : (
        <p class="muted">No hay votaciones clave con su voto registrado.</p>
      )}
    </section>
  </article>

  <Fragment slot="aside">
    {p && (
      <section class="ap-card ap-panel">
        <div class="side-label">Su partido</div>
        <a class="pside" href={partidoPath(p.id)} style={`--pc: ${p.color}`}>
          <strong>{p.siglas}</strong>
          <span>{p.nombre}</span>
          <small>Ver qué ha votado y propuesto →</small>
        </a>
      </section>
    )}
    <section class="ap-card ap-panel">
      <div class="side-label">Otros diputados por {d.provincia}</div>
      <ul class="mates">
        {companeros.map((c) => {
          const cp = c.partido ? partidoById.get(c.partido) : undefined;
          return <li><a href={diputadoPath(c.id)}><span class="pt" style={`--pc: ${cp?.color ?? 'var(--muted)'}`}>{cp?.siglas ?? 'Mixto'}</span> {c.nombre}</a></li>;
        })}
      </ul>
    </section>
    <section class="ap-card ap-panel">
      <div class="side-label">Fuente</div>
      <p class="tiny">Ficha, biografía y votaciones: <a href="https://www.congreso.es/es/opendata/diputados">datos abiertos del Congreso</a>. Asistencia y coincidencia, calculadas sobre {s?.votaciones ?? 0} votaciones nominales en las que podía votar.</p>
    </section>
  </Fragment>
</Aprende>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-more]')) {
    const list = button.previousElementSibling as HTMLElement;
    button.addEventListener('click', () => {
      for (const li of list.querySelectorAll<HTMLElement>('li[hidden]')) li.hidden = false;
      button.remove();
    });
  }
</script>

<style>
  .page { flex: 1; min-height: 0; overflow-y: auto; padding: 0 0 30px; }
  .phead { position: relative; padding: 30px 32px 22px; border-bottom: 1px solid var(--panel-line); }
  .phead-band { position: absolute; inset: 0 0 auto; height: 6px; background: var(--pc); border-radius: 16px 16px 0 0; }
  .kicker { margin: 0 0 8px; font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .kicker a { font-weight: 500; text-decoration: none; }
  h1 { margin: 0 0 10px; font-family: var(--display); font-size: clamp(30px, 3.6vw, 42px); font-weight: 800; line-height: 1.05; letter-spacing: -1px; }
  .sub { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; margin: 0 0 18px; font-size: 14px; color: var(--text-soft); }
  .sub a.pt { color: var(--ink); text-decoration: none; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
  .stats > div { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; background: var(--bg); border: 1px solid var(--panel-line); border-radius: 10px; }
  .stats strong { font-family: var(--display); font-size: 26px; font-weight: 800; line-height: 1; color: var(--pc); }
  .stats span { font-size: 12.5px; line-height: 1.35; color: var(--muted); }
  .block { padding: 22px 32px 6px; }
  .block h2 { margin: 0 0 10px; font-family: var(--display); font-size: 20px; font-weight: 800; letter-spacing: -0.3px; }
  .bio { max-width: 760px; margin: 0; font-size: 15px; line-height: 1.7; }
  .muted { margin: 0; font-size: 14px; color: var(--muted); }
  .small { margin-top: 8px; font-size: 12.5px; }
  .legs { display: flex; flex-wrap: wrap; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .legs li { min-width: 40px; padding: 5px 8px; font-family: var(--mono); font-size: 12px; text-align: center; color: var(--muted); border: 1px dashed var(--line); border-radius: 6px; }
  .legs li.on { color: #fff; background: var(--pc); border: 1px solid var(--pc); font-weight: 700; }
  .plist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .plist li { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--panel-line); }
  .plist li[hidden] { display: none; }
  .plist li.distinto { background: color-mix(in srgb, var(--gold) 12%, transparent); }
  .plist-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .plist-meta { font-size: 11.5px; color: var(--muted); }
  .ok { color: var(--green); }
  .ko { color: var(--red); }
  .plist-title { font-size: 14px; line-height: 1.35; }
  .plist-vote { font-family: var(--mono); font-size: 12px; color: var(--muted); white-space: nowrap; }
  .more { margin-top: 10px; padding: 6px 14px; font: inherit; font-size: 13px; font-weight: 600; color: var(--accent); background: var(--panel-2); border: 0; border-radius: 999px; cursor: pointer; }
  .side-label { margin-bottom: 8px; font-family: var(--mono); font-size: 11.5px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; color: var(--accent); }
  .pside { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border-left: 5px solid var(--pc); background: var(--bg); border-radius: 8px; color: var(--ink); font-weight: 400; text-decoration: none; }
  .pside strong { font-family: var(--display); font-size: 20px; font-weight: 800; }
  .pside span { font-size: 13px; color: var(--text-soft); }
  .pside small { margin-top: 4px; font-size: 12px; color: var(--accent); }
  .mates { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 3px; font-size: 13px; max-height: 320px; overflow-y: auto; }
  .mates a { display: flex; gap: 8px; color: var(--ink); font-weight: 400; text-decoration: none; }
  .mates a:hover { color: var(--accent); }
  .mates .pt { flex: none; width: 70px; font-size: 11.5px; color: var(--muted); font-weight: 500; }
  .tiny { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--muted); }
  @media (max-width: 820px) {
    .page { overflow: visible; }
    .phead, .block { padding-left: 18px; padding-right: 18px; }
  }
</style>
