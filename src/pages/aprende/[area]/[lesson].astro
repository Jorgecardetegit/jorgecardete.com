---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { lessonComponents } from '../../../components/learn';
import { areas, type LearnArea } from '../../../data/learn';
import { dateFormat } from '../../../i18n';
import { areaPath, getLessons, learnPath, lessonPath, lessonSlug, readingMinutes, type Lesson } from '../../../lib/learn';
import { breadcrumbs } from '../../../lib/seo';

export async function getStaticPaths() {
  const paths = [];
  for (const area of areas) {
    const lessons = await getLessons(area.id, area.sections.map((s) => s.id));
    for (const [index, lesson] of lessons.entries()) {
      paths.push({ params: { area: area.id, lesson: lessonSlug(lesson) }, props: { area, lesson, lessons, index } });
    }
  }
  return paths;
}

interface Props { area: LearnArea; lesson: Lesson; lessons: Lesson[]; index: number }
const { area, lesson, lessons, index } = Astro.props;
const { Content, headings } = await render(lesson);
const toc = headings.filter((h) => h.depth === 2);
const prev = lessons[index - 1];
const next = lessons[index + 1];
const number = String(index + 1).padStart(2, '0');
const updated = dateFormat('es', { day: 'numeric', month: 'long', year: 'numeric' }).format(lesson.data.updated);

const site = Astro.site!;
const url = new URL(Astro.url.pathname, site);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: lesson.data.title,
    description: lesson.data.description,
    inLanguage: 'es-ES',
    dateModified: lesson.data.updated.toISOString(),
    url: url.href,
    author: { '@id': new URL('/#person', site).href, '@type': 'Person', name: 'Jorge Cardete' },
  },
  breadcrumbs([
    { name: 'Aprende', url: new URL(learnPath, site) },
    { name: area.title, url: new URL(areaPath(area.id), site) },
    { name: lesson.data.title, url },
  ]),
];
---
<Base title={lesson.data.title} description={lesson.data.description} type="article" translated={false} jsonLd={jsonLd}>
  <article class="lesson" style={`--area: ${area.color}`} data-lesson={lesson.id}>
    <nav class="crumbs" aria-label="Estás en">
      <a href={learnPath}>Aprende</a><span aria-hidden="true">/</span><a href={areaPath(area.id)}>{area.title}</a>
    </nav>

    <ol class="track" aria-label={`Lección ${index + 1} de ${lessons.length}`}>
      {lessons.map((l, i) => (
        <li>
          <a href={lessonPath(l)} title={`${i + 1}. ${l.data.title}`} aria-label={`${i + 1}. ${l.data.title}`} aria-current={i === index ? 'step' : undefined} data-lesson-dot={l.id} />
        </li>
      ))}
    </ol>

    <div class="lesson-meta">
      <span class="lesson-number">LECCIÓN {number}</span>
      <span>{readingMinutes(lesson)} min de lectura</span>
    </div>
    <h1 class="hero lesson-title"><span aria-hidden="true">{lesson.data.icon}</span> {lesson.data.title}</h1>
    <p class="lead lesson-lead">{lesson.data.description}</p>

    <div class="lesson-intro">
      <section class="frase">
        <div class="label-pixel">EN UNA FRASE</div>
        <p>{lesson.data.summary}</p>
      </section>
      <section class="esencial">
        <div class="label-pixel">LO ESENCIAL</div>
        <ul>{lesson.data.keyPoints.map((point) => <li>{point}</li>)}</ul>
      </section>
    </div>

    <div class="post-body">
      <div class="prose"><Content components={lessonComponents} /></div>
      {toc.length > 1 && (
        <aside class="toc" aria-label="Índice de la lección">
          <div class="label-pixel">ÍNDICE</div>
          <nav>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        </aside>
      )}
    </div>

    <footer class="lesson-foot" data-lesson-end>
      {lesson.data.sources.length > 0 && (
        <section class="sources">
          <h2 class="sub">Fuentes</h2>
          <ul>{lesson.data.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}</ul>
        </section>
      )}
      <p class="lesson-updated">
        Revisado el {updated}. ¿Has visto un error o algo que no se entiende? <a href="mailto:jorgecardete@gmail.com?subject=Aprende%3A%20">Escríbeme</a> y lo corrijo.
      </p>

      <nav class="lesson-nav" aria-label="Otras lecciones">
        {prev ? (
          <a class="lesson-nav-card" href={lessonPath(prev)}>
            <span class="lesson-nav-dir">← Anterior</span>
            <span class="lesson-nav-title">{prev.data.icon} {prev.data.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="lesson-nav-card is-next" href={lessonPath(next)}>
            <span class="lesson-nav-dir">Siguiente →</span>
            <span class="lesson-nav-title">{next.data.icon} {next.data.title}</span>
          </a>
        ) : (
          <a class="lesson-nav-card is-next" href={areaPath(area.id)}>
            <span class="lesson-nav-dir">Has terminado ✓</span>
            <span class="lesson-nav-title">Volver a {area.title}</span>
          </a>
        )}
      </nav>
    </footer>
  </article>
</Base>

<script>
  import { markRead, readLessons } from '../../../lib/learn-progress';

  const article = document.querySelector<HTMLElement>('[data-lesson]');
  const end = document.querySelector('[data-lesson-end]');
  const paintTrack = () => {
    const read = readLessons();
    for (const dot of document.querySelectorAll<HTMLElement>('[data-lesson-dot]')) {
      dot.classList.toggle('is-read', read.has(dot.dataset.lessonDot!));
    }
  };
  paintTrack();

  // Leída cuando se llega al final (fuentes y navegación).
  if (article && end) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      markRead(article.dataset.lesson!);
      paintTrack();
      observer.disconnect();
    });
    observer.observe(end);
  }

  // Índice: resalta la sección que se está leyendo, como en los posts.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const byId = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
  const tocObserver = new IntersectionObserver(
    (entries) => {
      const visible = entries.find((e) => e.isIntersecting);
      if (visible) for (const a of links) a.classList.toggle('active', a === byId.get(visible.target.id));
    },
    { rootMargin: '-15% 0px -70% 0px' },
  );
  for (const id of byId.keys()) {
    const el = document.getElementById(id);
    if (el) tocObserver.observe(el);
  }
</script>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .crumbs a { font-weight: 500; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  /* Una casilla por lección: la actual rellena del color del área, las leídas en verde. */
  .track { display: flex; flex-wrap: wrap; gap: 5px; list-style: none; margin: 0 0 22px; padding: 0; }
  .track a { display: block; width: 22px; height: 12px; background: var(--card); border: 2px solid var(--ink); transition: transform .15s; }
  .track a:hover { transform: translateY(-2px); }
  .track a.is-read { background: var(--green); }
  .track a[aria-current] { background: var(--area); box-shadow: 2px 2px 0 var(--shadow); }

  .lesson-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-bottom: 14px; font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .lesson-number { font-family: var(--pixel); font-size: 10px; color: var(--bg); background: var(--area); border: 3px solid var(--ink); padding: 6px 9px; box-shadow: 3px 3px 0 var(--shadow); }
  .lesson-title { font-size: clamp(34px, 5vw, 50px); text-wrap: balance; }
  .lesson-lead { max-width: 680px; margin-bottom: 30px; }

  .lesson-intro { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; max-width: 936px; margin-bottom: 44px; }
  .frase, .esencial { margin: 0; padding: 18px 20px; border: 3px solid var(--ink); border-radius: 4px; box-shadow: 5px 5px 0 var(--shadow); }
  .frase { background: var(--card); border-left: 10px solid var(--area); }
  .frase p { margin: 0; font-family: var(--display); font-size: 21px; font-weight: 600; line-height: 1.35; letter-spacing: -0.3px; text-wrap: pretty; }
  .esencial { background: var(--bg); }
  .esencial ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .esencial li { position: relative; padding-left: 28px; font-size: 15.5px; line-height: 1.5; }
  .esencial li::before { content: '✓'; position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 19px; height: 19px; font-size: 12px; font-weight: 700; color: var(--bg); background: var(--green); border: 2px solid var(--ink); }

  .lesson-foot { max-width: 680px; margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  .sources { margin-bottom: 20px; }
  .sources ul { margin: 0; padding-left: 20px; font-size: 15px; line-height: 1.8; }
  .sources a { font-weight: 500; }
  .lesson-updated { margin: 0 0 28px; font-size: 14px; line-height: 1.6; color: var(--muted); }
  .lesson-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .lesson-nav-card { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; background: var(--card); border: 3px solid var(--ink); border-radius: 4px; box-shadow: 4px 4px 0 var(--shadow); color: var(--ink); text-decoration: none; transition: transform .15s, box-shadow .15s; }
  .lesson-nav-card:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--shadow); color: var(--ink); }
  .lesson-nav-card.is-next { text-align: right; }
  .lesson-nav-dir { font-family: var(--mono); font-size: 12px; font-weight: 500; color: var(--green); }
  .lesson-nav-title { font-family: var(--display); font-size: 17px; font-weight: 700; line-height: 1.3; }
  @media (max-width: 560px) {
    .lesson-nav { grid-template-columns: 1fr; }
    .lesson-nav > span { display: none; }
  }
</style>
