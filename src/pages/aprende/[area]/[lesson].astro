---
import { render } from 'astro:content';
import Aprende from '../../../layouts/Aprende.astro';
import { lessonComponents } from '../../../components/learn';
import { areas, type LearnArea } from '../../../data/learn';
import { dateFormat } from '../../../i18n';
import { areaPath, getLessons, learnPath, lessonPath, lessonSlug, readingMinutes, type Lesson } from '../../../lib/learn';
import { breadcrumbs } from '../../../lib/seo';

export async function getStaticPaths() {
  const paths = [];
  for (const area of areas) {
    const lessons = await getLessons(area.id, area.sections.map((s) => s.id));
    for (const [index, lesson] of lessons.entries()) {
      paths.push({ params: { area: area.id, lesson: lessonSlug(lesson) }, props: { area, lesson, lessons, index } });
    }
  }
  return paths;
}

interface Props { area: LearnArea; lesson: Lesson; lessons: Lesson[]; index: number }
const { area, lesson, lessons, index } = Astro.props;
const { Content, headings } = await render(lesson);
const toc = headings.filter((h) => h.depth === 2);
const prev = lessons[index - 1];
const next = lessons[index + 1];
const updated = dateFormat('es', { day: 'numeric', month: 'long', year: 'numeric' }).format(lesson.data.updated);

const site = Astro.site!;
const url = new URL(Astro.url.pathname, site);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: lesson.data.title,
    description: lesson.data.description,
    inLanguage: 'es-ES',
    dateModified: lesson.data.updated.toISOString(),
    url: url.href,
    author: { '@id': new URL('/#person', site).href, '@type': 'Person', name: 'Jorge Cardete' },
  },
  breadcrumbs([
    { name: 'Aprende', url: new URL(learnPath, site) },
    { name: area.title, url: new URL(areaPath(area.id), site) },
    { name: lesson.data.title, url },
  ]),
];
---
<Aprende title={lesson.data.title} description={lesson.data.description} jsonLd={jsonLd} area={area} lessons={lessons} current={lesson.id}>
  <article class="reader ap-panel" data-lesson={lesson.id} data-reader>
    <header class="reader-head">
      <div class="reader-meta">
        <span class="reader-num">Lección {index + 1} de {lessons.length}</span>
        <span>{readingMinutes(lesson)} min de lectura</span>
      </div>
      <h1 class="reader-title"><span aria-hidden="true">{lesson.data.icon}</span> {lesson.data.title}</h1>
      <p class="reader-lead">{lesson.data.description}</p>
    </header>

    <div class="prose reader-body"><Content components={lessonComponents} /></div>

    <footer class="reader-foot" data-lesson-end>
      <p class="reader-updated">
        Revisado el {updated}. ¿Has visto un error o algo que no se entiende? <a href="mailto:jorgecardete@gmail.com?subject=Aprende%3A%20">Escríbeme</a> y lo corrijo.
      </p>
      <nav class="reader-nav" aria-label="Otras lecciones">
        {prev ? (
          <a href={lessonPath(prev)}><span>← Anterior</span><strong>{prev.data.icon} {prev.data.title}</strong></a>
        ) : <span />}
        {next ? (
          <a class="is-next" href={lessonPath(next)}><span>Siguiente →</span><strong>{next.data.icon} {next.data.title}</strong></a>
        ) : (
          <a class="is-next" href={areaPath(area.id)}><span>Has terminado ✓</span><strong>Volver al panel</strong></a>
        )}
      </nav>
    </footer>
  </article>

  <Fragment slot="aside">
    <section class="ap-card ap-panel frase">
      <div class="side-label">En una frase</div>
      <p>{lesson.data.summary}</p>
    </section>

    <section class="ap-card ap-panel">
      <div class="side-label">Lo esencial</div>
      <ul class="esencial">{lesson.data.keyPoints.map((p) => <li>{p}</li>)}</ul>
    </section>

    {toc.length > 1 && (
      <section class="ap-card ap-panel toc-card">
        <div class="side-label">Índice</div>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc>{h.text}</a></li>)}</ol>
      </section>
    )}

    {lesson.data.sources.length > 0 && (
      <section class="ap-card ap-panel sources">
        <div class="side-label">Fuentes</div>
        <ul>{lesson.data.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}</ul>
      </section>
    )}
  </Fragment>
</Aprende>

<script>
  import { markRead } from '../../../lib/learn-progress';

  const article = document.querySelector<HTMLElement>('[data-lesson]');
  const end = document.querySelector('[data-lesson-end]');

  // Leída cuando se llega al final.
  if (article && end) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      markRead(article.dataset.lesson!);
      document.querySelector(`[data-lesson-link="${article.dataset.lesson}"]`)?.classList.add('is-read');
      observer.disconnect();
    });
    observer.observe(end);
  }

  // Índice: resalta la sección que se está leyendo.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  const tocObserver = new IntersectionObserver(
    (entries) => {
      const visible = entries.find((e) => e.isIntersecting);
      if (visible) for (const a of links) a.classList.toggle('active', a === byId.get(visible.target.id));
    },
    { rootMargin: '-10% 0px -75% 0px' },
  );
  for (const id of byId.keys()) {
    const el = document.getElementById(id);
    if (el) tocObserver.observe(el);
  }
</script>

<style>
  .reader { flex: 1; min-height: 0; overflow-y: auto; padding: 34px 40px 40px; scroll-behavior: smooth; }
  .reader-head, .reader-body, .reader-foot { max-width: 720px; margin-inline: auto; }
  .reader-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-bottom: 12px; font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
  .reader-num { color: var(--accent); font-weight: 600; }
  .reader-title { margin: 0 0 10px; font-family: var(--display); font-size: clamp(30px, 3.6vw, 44px); font-weight: 800; line-height: 1.05; letter-spacing: -1.2px; text-wrap: balance; }
  .reader-lead { margin: 0 0 30px; font-size: 18px; line-height: 1.55; color: var(--text-soft); }
  .reader-body { max-width: 720px; }
  .reader-body :global(h2) { scroll-margin-top: 20px; }
  .reader-foot { margin-top: 44px; padding-top: 22px; border-top: 1px solid var(--panel-line); }
  .reader-updated { margin: 0 0 20px; font-size: 14px; line-height: 1.6; color: var(--muted); }
  .reader-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .reader-nav a { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; background: var(--bg); border: 1px solid var(--panel-line); border-radius: 12px; color: var(--ink); font-weight: 400; text-decoration: none; transition: border-color .15s, transform .15s; }
  .reader-nav a:hover { color: var(--ink); border-color: var(--accent); transform: translateY(-2px); }
  .reader-nav a.is-next { text-align: right; }
  .reader-nav span { font-family: var(--mono); font-size: 12px; color: var(--accent); }
  .reader-nav strong { font-family: var(--display); font-size: 16px; line-height: 1.3; }

  .side-label { margin-bottom: 8px; font-family: var(--mono); font-size: 11.5px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; color: var(--accent); }
  .frase p { font-family: var(--display); font-size: 17px; font-weight: 600; line-height: 1.4; letter-spacing: -0.2px; color: var(--ink); }
  .esencial { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .esencial li { position: relative; padding-left: 22px; font-size: 13.5px; line-height: 1.5; color: var(--text-soft); }
  .esencial li::before { content: '✓'; position: absolute; left: 0; top: 0; font-weight: 700; color: var(--green); }
  .toc-card ol { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--panel-line); }
  .toc-card a { display: block; margin-left: -2px; padding: 5px 0 5px 12px; border-left: 2px solid transparent; font-size: 13.5px; font-weight: 500; line-height: 1.35; color: var(--muted); text-decoration: none; }
  .toc-card a:hover { color: var(--ink); }
  .toc-card a.active { color: var(--accent); border-left-color: var(--accent); }
  .sources ul { margin: 0; padding-left: 16px; display: flex; flex-direction: column; gap: 6px; font-size: 13px; line-height: 1.45; }
  .sources a { font-weight: 500; text-decoration-thickness: 1px; }

  @media (max-width: 820px) {
    .reader { padding: 24px 18px 30px; overflow: visible; }
    .reader-nav { grid-template-columns: 1fr; }
    .reader-nav > span { display: none; }
  }
</style>
