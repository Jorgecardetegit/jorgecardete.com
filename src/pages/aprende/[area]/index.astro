---
import Base from '../../../layouts/Base.astro';
import { areas, type LearnArea } from '../../../data/learn';
import { getLessons, learnPath, lessonPath, readingMinutes, type Lesson } from '../../../lib/learn';
import { breadcrumbs } from '../../../lib/seo';

export async function getStaticPaths() {
  return Promise.all(
    areas.map(async (area) => ({
      params: { area: area.id },
      props: { area, lessons: await getLessons(area.id, area.sections.map((s) => s.id)) },
    })),
  );
}

interface Props { area: LearnArea; lessons: Lesson[] }
const { area, lessons } = Astro.props;
const totalMinutes = lessons.reduce((sum, l) => sum + readingMinutes(l), 0);
const site = Astro.site!;
const jsonLd = [
  breadcrumbs([
    { name: 'Aprende', url: new URL(learnPath, site) },
    { name: area.title, url: new URL(Astro.url.pathname, site) },
  ]),
];
---
<Base title={area.title} description={area.description} translated={false} jsonLd={jsonLd}>
  <div style={`--area: ${area.color}`}>
    <nav class="crumbs" aria-label="Estás en"><a href={learnPath}>← Aprende</a></nav>
    <h1 class="hero"><span aria-hidden="true">{area.icon}</span> {area.title}</h1>
    <p class="lead area-lead">{area.description}</p>

    <div class="area-stats">
      <span><strong>{lessons.length}</strong> {lessons.length === 1 ? 'lección' : 'lecciones'}</span>
      <span><strong>~{Math.round(totalMinutes / 5) * 5}</strong> min en total</span>
      <span data-progress hidden><strong data-progress-count>0</strong> de {lessons.length} leídas</span>
    </div>

    {area.sections.map((section, s) => {
      const items = lessons.filter((l) => l.data.section === section.id);
      return (
        <section class="block">
          <header class="block-head">
            <span class="block-num">{s + 1}</span>
            <div>
              <h2 class="block-title">
                {section.title}
                {section.status === 'soon' && <span class="soon">Próximamente</span>}
              </h2>
              <p class="block-desc">{section.description}</p>
            </div>
          </header>

          {items.length > 0 && (
            <ol class="path">
              {items.map((lesson) => (
                <li>
                  <a class="step" href={lessonPath(lesson)} data-lesson-card={lesson.id}>
                    <span class="step-num">{String(lessons.indexOf(lesson) + 1).padStart(2, '0')}</span>
                    <span class="step-icon" aria-hidden="true">{lesson.data.icon}</span>
                    <span class="step-text">
                      <span class="step-title">{lesson.data.title}</span>
                      <span class="step-desc">{lesson.data.description}</span>
                    </span>
                    <span class="step-time">{readingMinutes(lesson)} min</span>
                    <span class="step-check" aria-label="Leída" title="Leída">✓</span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </section>
      );
    })}

    <section class="method">
      <div class="label-pixel">CÓMO ESTÁ HECHO</div>
      <ul>
        <li><strong>Para entender, no para convencer.</strong> Aquí no se dice a quién votar. Se explica cómo funciona el país para que decidas tú.</li>
        <li><strong>Todo con fuente.</strong> Cada lección enlaza a la Constitución, las leyes del BOE o la web oficial de cada institución.</li>
        <li><strong>Simplificado, no falseado.</strong> Cuando algo tiene excepciones, se dice. Si encuentras un error, cada lección tiene un enlace para avisar.</li>
      </ul>
    </section>
  </div>
</Base>

<script>
  import { readLessons } from '../../../lib/learn-progress';

  const read = readLessons();
  const cards = [...document.querySelectorAll<HTMLElement>('[data-lesson-card]')];
  let count = 0;
  for (const card of cards) {
    const done = read.has(card.dataset.lessonCard!);
    card.classList.toggle('is-read', done);
    if (done) count++;
  }
  const progress = document.querySelector<HTMLElement>('[data-progress]');
  if (progress && count > 0) {
    progress.hidden = false;
    progress.querySelector('[data-progress-count]')!.textContent = String(count);
  }
</script>

<style>
  .crumbs { margin-bottom: 18px; font-family: var(--mono); font-size: 13px; }
  .crumbs a { font-weight: 500; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .area-lead { max-width: 680px; margin-bottom: 20px; }
  .area-stats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 48px; }
  .area-stats span { font-family: var(--mono); font-size: 13px; color: var(--muted); border: 1.5px solid var(--line); border-radius: 999px; padding: 4px 12px; }
  .area-stats strong { color: var(--green); font-weight: 600; }
  .area-stats span[hidden] { display: none; }

  .block { margin-bottom: 52px; }
  .block-head { display: flex; gap: 16px; align-items: flex-start; margin-bottom: 20px; }
  .block-num { flex: none; display: grid; place-items: center; width: 40px; height: 40px; font-family: var(--pixel); font-size: 14px; color: var(--bg); background: var(--area); border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--shadow); }
  .block-title { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin: 2px 0 6px; font-family: var(--display); font-size: 28px; font-weight: 800; letter-spacing: -0.6px; }
  .block-desc { margin: 0; max-width: 620px; font-size: 16px; line-height: 1.6; color: var(--text-soft); }
  .soon { font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: 0; color: var(--terracotta); border: 1.5px dashed currentColor; border-radius: 999px; padding: 2px 10px; }

  /* El camino: una tarjeta por lección unidas por una línea de puntos, como un mapa de niveles. */
  .path { list-style: none; margin: 0; padding: 0 0 0 19px; display: flex; flex-direction: column; gap: 12px; border-left: 3px dotted var(--line); max-width: 860px; }
  .step { position: relative; display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; align-items: center; gap: 14px; margin-left: 22px; padding: 14px 18px; background: var(--card); border: 3px solid var(--ink); border-radius: 4px; box-shadow: 4px 4px 0 var(--shadow); color: var(--ink); font-weight: 400; text-decoration: none; transition: transform .15s, box-shadow .15s; }
  .step::before { content: ''; position: absolute; left: -36px; top: 50%; width: 12px; height: 12px; margin-top: -6px; background: var(--bg); border: 3px solid var(--ink); }
  .step:hover, .step:focus-visible { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--shadow); color: var(--ink); }
  .step:hover .step-title { color: var(--green); }
  .step-num { font-family: var(--pixel); font-size: 11px; color: var(--muted); }
  .step-icon { font-size: 26px; line-height: 1; }
  .step-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .step-title { font-family: var(--display); font-size: 18px; font-weight: 700; letter-spacing: -0.2px; line-height: 1.25; }
  .step-desc { font-size: 14.5px; line-height: 1.5; color: var(--text-soft); }
  .step-time { font-family: var(--mono); font-size: 12px; color: var(--muted); white-space: nowrap; }
  .step-check { display: none; position: absolute; top: -10px; right: -10px; place-items: center; width: 24px; height: 24px; font-size: 13px; font-weight: 700; color: var(--bg); background: var(--green); border: 2px solid var(--ink); }
  .step.is-read::before { background: var(--green); }
  .step.is-read .step-check { display: grid; }

  .method { max-width: 860px; padding: 20px 22px; background: var(--card); border: 3px dashed var(--line); border-radius: 4px; }
  .method ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; font-size: 15.5px; line-height: 1.6; color: var(--text-soft); }
  .method strong { color: var(--ink); }

  @media (max-width: 640px) {
    .path { padding-left: 0; border-left: 0; }
    .step { margin-left: 0; grid-template-columns: auto minmax(0, 1fr); gap: 6px 12px; }
    .step::before { display: none; }
    .step-num { grid-column: 1; grid-row: 1; }
    .step-icon { grid-column: 1; grid-row: 2; }
    .step-text { grid-column: 2; grid-row: 1 / span 2; }
    .step-time { grid-column: 2; }
  }
</style>
