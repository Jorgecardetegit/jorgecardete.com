---
import Base from '../layouts/Base.astro';

const startups = [
  { name: 'Grupo Cardete Ventures', role: 'Cofundador y CTO', desc: 'Asistencia urgente 24/7 en carretera y transporte exprés en Madrid y Barcelona, en menos de 30 minutos. Me encargo de la tecnología.', url: 'https://grupocardeteventures.es', label: 'grupocardeteventures.es', color: '#b5623c' },
  { name: 'Zapic', role: 'Cofundador', desc: 'Agentes de IA para redes sociales. Marketing que suena a ti.', url: 'https://zapic.ai', label: 'zapic.ai', color: '#6b5ea8' },
  { name: 'Fractal', role: 'Founding engineer y AI engineer', desc: 'Una red de agentes especializados sobre Solana que analizan el mercado en tiempo real y convierten esa información en decisiones de trading.', url: 'https://www.youtube.com/watch?v=7CRCodieh1g', label: 'xfractal.com', color: '#2b9476' },
  { name: 'The Deep Hub', role: 'Fundador', desc: 'Una publicación técnica en Medium sobre data science y machine learning, abierta a ingenieros e investigadores. Suma más de 570 artículos de unos 100 autores; edito cada envío y escribo sobre todo de visión artificial.', url: 'https://medium.com/thedeephub', label: 'thedeephub.com', color: '#c9a227' },
];
---
<Base title="Startups" description="Startups que he fundado o en las que he trabajado: Grupo Cardete Ventures, Zapic, Fractal y The Deep Hub.">
  <div class="badge">MUNDO 4 — STARTUPS</div>
  <h1 class="hero">Startups</h1>
  <p class="lead">Cosas que he fundado o ayudado a construir desde el principio.</p>

  <ul class="startups">
    {startups.map((s) => (
      <li class="startup">
        <div class="startup-body">
          <h2 class="startup-name"><a href={s.url}>{s.name}</a></h2>
          <div class="startup-role">{s.role}</div>
          <p class="startup-desc">{s.desc}</p>
          <a class="startup-url" href={s.url}>{s.label} ↗</a>
        </div>
        <a class="startup-img" href={s.url} aria-label={s.name} style={`--c:${s.color}`}>
          <span>{s.name[0]}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
