---
import Base from '../layouts/Base.astro';

const startups = [
  { name: 'Zapic', role: 'Co-founder', desc: 'AI agents for social media management.', url: 'https://zapic.ai', label: 'zapic.ai', color: '#6b5ea8' },
  { name: 'Fractal', role: 'Founding engineer', desc: 'AI agents for Solana. We raised a €300K pre-seed and scaled to 20.', url: 'https://www.youtube.com/watch?v=7CRCodieh1g', label: 'youtube.com', color: '#3f6f52' },
  { name: 'Grupo Cardete Ventures', role: 'Co-founder & CTO', desc: 'Roadside assistance and express transport in Madrid and Barcelona.', url: 'https://grupocardete.com', label: 'grupocardete.com', color: '#b5623c' },
  { name: 'The Deep Hub', role: 'Founder', desc: 'A paid ML publication: 570+ articles, ~100 contributors.', url: 'https://medium.com/thedeephub', label: 'medium.com/thedeephub', color: '#c9a227' },
];
---
<Base title="Startups" description="Startups que he fundado o en las que he trabajado: Zapic, Fractal, Grupo Cardete Ventures y The Deep Hub.">
  <div class="badge">MUNDO 4 — STARTUPS</div>
  <h1 class="hero">Startups</h1>
  <p class="lead">Cosas que he fundado o ayudado a construir desde el principio.</p>

  <ul class="startups">
    {startups.map((s) => (
      <li class="startup">
        <div class="startup-body">
          <h2 class="startup-name"><a href={s.url}>{s.name}</a></h2>
          <div class="startup-role">{s.role}</div>
          <p class="startup-desc">{s.desc}</p>
          <a class="startup-url" href={s.url}>{s.label} ↗</a>
        </div>
        <a class="startup-img" href={s.url} aria-label={s.name} style={`--c:${s.color}`}>
          <span>{s.name[0]}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
