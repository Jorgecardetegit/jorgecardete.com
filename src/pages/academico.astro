---
import Base from '../layouts/Base.astro';

const papers = [
  {
    title: 'How well do different chatbots respond to multiple myeloma treatment guidelines?',
    journal: 'Leukemia',
    publisher: 'Nature Portfolio',
    date: 'Abril 2025',
    authors: ['[Tu nombre]', 'Edwin Uriel Suárez', 'Fabio Torres-Saavedra', 'Amalia Domingo-González', 'Pilar Llamas-Sillero'],
    note: 'Con Edwin Uriel Suárez (Fundación Jiménez Díaz).',
    doi: '10.1038/s41375-025-02604-8',
  },
];
---
<Base title="Académico" description="Publicaciones académicas: How well do different chatbots respond to multiple myeloma treatment guidelines? (Leukemia, 2025).">
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,700;1,6..72,400&display=swap" />

  <div class="badge">MUNDO 6 — ACADÉMICO</div>
  <h1 class="hero">Académico</h1>
  <p class="lead">Publicaciones revisadas por pares en las que soy coautor.</p>

  <h2 class="ac-label">Artículos · {papers.length}</h2>
  <ol class="papers">
    {papers.map((p) => (
      <li class="paper">
        <div class="paper-meta">
          <span class="paper-journal">{p.journal}</span>
          <span class="paper-dot">·</span>
          <span>{p.publisher}</span>
          <span class="paper-dot">·</span>
          <time>{p.date}</time>
        </div>
        <h2 class="paper-title"><a href={`https://doi.org/${p.doi}`}>{p.title}</a></h2>
        <p class="paper-authors">{p.authors.join(', ')}</p>
        <p class="paper-note">{p.note}</p>
        <div class="paper-links">
          <a class="paper-btn" href={`https://doi.org/${p.doi}`}>Leer artículo ↗</a>
          <span class="paper-doi">DOI {p.doi}</span>
        </div>
      </li>
    ))}
  </ol>
</Base>
