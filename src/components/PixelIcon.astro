// Agrupa píxeles contiguos del mismo color en un solo rect por fila.
const rects: { x: number; y: number; w: number; fill: string }[] = [];
icons[name].forEach((row, y) => {
  for (let x = 0; x < row.length; ) {
    const c = row[x];
    let w = 1;
    while (row[x + w] === c) w++;
    if (c !== '.') rects.push({ x, y, w, fill: palette[c] });
    x += w;
  }
});
---
<svg class="nav-icon" viewBox="0 0 20 20" width={size} height={size} shape-rendering="crispEdges" aria-hidden="true">
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}
</svg>
