---
// Cuántos diputados elige cada provincia: un cuadradito por escaño.
import { escanosFuente, escanosPorProvincia } from '../../data/politica/escanos';

const tier = (n: number) => (n >= 10 ? 'big' : n >= 5 ? 'mid' : 'small');
---
<figure class="escanos">
  <div class="escanos-legend">
    <span class="big">10 o más</span><span class="mid">de 5 a 9</span><span class="small">4 o menos</span>
  </div>
  <ul class="escanos-grid">
    {escanosPorProvincia.map(([provincia, n]) => (
      <li class={tier(n)}>
        <span class="escanos-head"><span class="escanos-name">{provincia}</span><strong>{n}</strong></span>
        <span class="escanos-dots" aria-hidden="true">{Array.from({ length: n }, () => <i />)}</span>
      </li>
    ))}
  </ul>
  <figcaption>
    Diputados por provincia en las elecciones generales de 2026, 350 en total. Fuente: <a href={escanosFuente.url}>{escanosFuente.title}</a>.
  </figcaption>
</figure>

<style>
  .escanos { margin: 32px 0; padding: 20px; background: var(--card); border: 3px solid var(--ink); border-radius: 4px; box-shadow: 5px 5px 0 var(--shadow); }
  .escanos-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-bottom: 14px; font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .escanos-legend span::before { content: ''; display: inline-block; width: 10px; height: 10px; margin-right: 6px; background: var(--c); border: 1.5px solid var(--ink); vertical-align: -1px; }
  .big { --c: var(--green); }
  .mid { --c: var(--purple); }
  .small { --c: var(--terracotta); }
  .escanos-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .escanos-grid li { margin: 0; padding: 7px 9px; background: var(--bg); border: 2px solid var(--ink); border-radius: 3px; }
  .escanos-head { display: flex; justify-content: space-between; gap: 6px; font-size: 13px; line-height: 1.3; }
  .escanos-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .escanos-head strong { font-family: var(--mono); color: var(--c); }
  .escanos-dots { display: flex; flex-wrap: wrap; gap: 2px; margin-top: 5px; }
  .escanos-dots i { width: 7px; height: 7px; background: var(--c); }
  .escanos figcaption { margin-top: 14px; font-size: 13.5px; line-height: 1.55; color: var(--muted); }
  .escanos figcaption a { font-weight: 500; }
</style>
