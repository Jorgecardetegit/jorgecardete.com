---
// Tabla filtrable de competencias: qué administración se encarga de cada cosa.
import { competencias, niveles, type Nivel } from '../../data/politica/competencias';

const order = Object.keys(niveles) as Nivel[];
---
<figure class="qhq" data-qhq>
  <div class="qhq-filters" role="group" aria-label="Filtrar por administración">
    <span class="qhq-label">Ver lo que toca a</span>
    <button type="button" class="pchip" data-level="" aria-pressed="true">Todas</button>
    {order.map((n) => <button type="button" class="pchip" data-level={n} aria-pressed="false">{niveles[n].label}</button>)}
  </div>
  <ul class="qhq-list">
    {competencias.map((c) => (
      <li data-levels={c.quien.join(' ')}>
        <div class="qhq-head">
          <span class="qhq-icon" aria-hidden="true">{c.icono}</span>
          <strong>{c.tema}</strong>
          <span class="qhq-pills">
            {order.map((n) => (
              <span class:list={['qhq-pill', { on: c.quien.includes(n) }]} style={`--c: ${niveles[n].color}; --t: ${niveles[n].text}`} aria-hidden={c.quien.includes(n) ? undefined : 'true'}>
                {niveles[n].label}
              </span>
            ))}
          </span>
        </div>
        <p>{c.detalle}</p>
      </li>
    ))}
  </ul>
  <figcaption>Simplificado: muchas competencias tienen excepciones según la comunidad. Ante la duda, lo que manda es el Estatuto de autonomía de cada una y los artículos 148 y 149 de la Constitución.</figcaption>
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-qhq]')) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-level]')];
    const rows = [...root.querySelectorAll<HTMLElement>('[data-levels]')];
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const level = button.dataset.level!;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        for (const row of rows) row.hidden = level !== '' && !row.dataset.levels!.split(' ').includes(level);
      });
    }
  }
</script>

<style>
  .qhq { margin: 32px 0; padding: 20px; background: var(--card); border: 3px solid var(--ink); border-radius: 4px; box-shadow: 5px 5px 0 var(--shadow); }
  .qhq-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 16px; }
  .qhq-label { margin-right: 4px; font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .qhq-filters .pchip { font-size: 13px; padding: 4px 11px; }
  .qhq-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .qhq-list li { margin: 0; padding: 10px 14px; background: var(--bg); border: 2px solid var(--ink); border-radius: 3px; }
  .qhq-list li[hidden] { display: none; }
  .qhq-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .qhq-icon { font-size: 20px; line-height: 1; }
  .qhq-head strong { font-family: var(--display); font-size: 16.5px; font-weight: 800; margin-right: auto; }
  .qhq-pills { display: flex; flex-wrap: wrap; gap: 4px; }
  .qhq-pill { font-family: var(--mono); font-size: 11px; padding: 2px 7px; border: 1.5px dashed var(--line); border-radius: 3px; color: var(--muted); opacity: .55; }
  .qhq-pill.on { opacity: 1; color: var(--t); background: var(--c); border: 1.5px solid var(--ink); font-weight: 600; }
  .qhq-list p { margin: 6px 0 0; font-size: 14.5px; line-height: 1.55; color: var(--text-soft); }
  .qhq figcaption { margin-top: 14px; font-size: 13.5px; line-height: 1.55; color: var(--muted); }
</style>
