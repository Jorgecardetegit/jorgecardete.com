---
// Formulario de la newsletter. El alta se envía desde el navegador a Substack en una
// pestaña nueva: Substack bloquea con Cloudflare las altas que llegan desde un servidor.
// La suscripción es la conversión principal: sale como newsletter_signup, con el
// email cifrado para las conversiones mejoradas y cómo nos conoció el lector.
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Dónde está el formulario, para comparar ubicaciones. */
  placement: string;
  title?: string;
  lead?: string;
}
const { lang, placement, title, lead } = Astro.props;
const text = {
  es: {
    title: 'Suscríbete a la newsletter',
    lead: 'Un email cuando publique algo nuevo sobre machine learning, IA o growth. Sin spam; te das de baja con un clic.',
    email: 'Tu email',
    how: '¿Cómo me conociste? (opcional)',
    submit: 'Suscribirme',
    done: '¡Listo! Se ha abierto Substack en otra pestaña; revisa tu correo para confirmar.',
    invalid: 'Ese email no parece válido.',
    options: [['google', 'Google u otro buscador'], ['ai', 'ChatGPT u otra IA'], ['linkedin', 'LinkedIn'], ['x', 'X (Twitter)'], ['community', 'Reddit u otra comunidad'], ['medium', 'Medium / The Deep Hub'], ['friend', 'Me lo recomendaron'], ['other', 'Otro']],
  },
  en: {
    title: 'Subscribe to the newsletter',
    lead: 'An email whenever I publish something new about machine learning, AI or growth. No spam; unsubscribe in one click.',
    email: 'Your email',
    how: 'How did you find me? (optional)',
    submit: 'Subscribe',
    done: 'Done! Substack opened in a new tab; check your inbox to confirm.',
    invalid: "That email doesn't look right.",
    options: [['google', 'Google or another search engine'], ['ai', 'ChatGPT or another AI'], ['linkedin', 'LinkedIn'], ['x', 'X (Twitter)'], ['community', 'Reddit or another community'], ['medium', 'Medium / The Deep Hub'], ['friend', 'Someone recommended it'], ['other', 'Other']],
  },
}[lang];
---
<section class="newsletter" data-placement={placement}>
  <h2 class="newsletter-title">{title ?? text.title}</h2>
  <p class="newsletter-lead">{lead ?? text.lead}</p>
  <form class="newsletter-form" novalidate data-msg-done={text.done} data-msg-invalid={text.invalid}>
    <label class="visually-hidden" for={`nl-email-${placement}`}>{text.email}</label>
    <input id={`nl-email-${placement}`} type="email" name="email" placeholder={text.email} autocomplete="email" required />
    <label class="visually-hidden" for={`nl-how-${placement}`}>{text.how}</label>
    <select id={`nl-how-${placement}`} name="how">
      <option value="">{text.how}</option>
      {text.options.map(([value, label]) => <option value={value}>{label}</option>)}
    </select>
    <input class="visually-hidden" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button type="submit">{text.submit}</button>
    <p class="newsletter-status" role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  import { identify, track } from '../lib/analytics';

  const SUBSTACK = 'https://jorgecardete.substack.com';

  // Mismo envío que el formulario incrustado de Substack, sin JS (`nojs`). Tiene que
  // ir dentro del clic, sin esperas antes, para que el navegador abra la pestaña.
  function subscribe(email: string) {
    const fields = { email, first_url: location.href, first_referrer: document.referrer, current_url: location.href, current_referrer: document.referrer, referral_code: '', source: 'embed' };
    const post = Object.assign(document.createElement('form'), { method: 'POST', action: `${SUBSTACK}/api/v1/free?nojs=true`, target: '_blank', rel: 'noopener' });
    for (const [name, value] of Object.entries(fields)) post.append(Object.assign(document.createElement('input'), { type: 'hidden', name, value }));
    document.body.append(post);
    post.submit();
    post.remove();
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('.newsletter-form')) {
    const status = form.querySelector<HTMLElement>('.newsletter-status')!;
    const placement = form.closest<HTMLElement>('.newsletter')!.dataset.placement!;
    const msg = form.dataset;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    let started = false;

    form.addEventListener('focusin', () => {
      if (started) return;
      started = true;
      track('newsletter_form_start', { form_placement: placement });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = field('email').value.trim();
      const how = field('how').value || undefined;
      if (!field('email').checkValidity()) {
        status.textContent = msg.msgInvalid!;
        return;
      }
      // Campo trampa: los humanos no lo ven, los bots lo rellenan. Al bot se le dice que
      // ha ido bien, pero ni se suscribe ni cuenta como conversión.
      const bot = Boolean(field('website').value);
      if (!bot) subscribe(email);
      form.reset();
      status.textContent = msg.msgDone!;
      if (bot) return;
      await identify(email, { how_found: how });
      // Valor fijo para que las pujas automáticas tengan algo que optimizar.
      track('newsletter_signup', { form_placement: placement, how_found: how, value: 1, currency: 'EUR' }, { email });
    });
  }
</script>

<style>
  .newsletter { margin: 56px 0 0; padding: 22px 24px; background: var(--card); border: 3px solid var(--ink); border-radius: 4px; box-shadow: 5px 5px 0 var(--shadow); max-width: 720px; }
  .newsletter-title { margin: 0 0 6px; font-family: var(--display); font-weight: 800; font-size: 24px; letter-spacing: -0.4px; }
  .newsletter-lead { margin: 0 0 16px; font-size: 15.5px; line-height: 1.55; color: var(--text-soft); }
  .newsletter-form { display: flex; flex-wrap: wrap; gap: 10px; }
  .newsletter-form input[type='email'], .newsletter-form select { flex: 1 1 220px; min-width: 0; padding: 10px 12px; font: inherit; font-size: 15px; color: var(--ink); background: var(--bg); border: 2px solid var(--ink); border-radius: 3px; }
  .newsletter-form select { flex-basis: 100%; order: 1; color: var(--text-soft); }
  .newsletter-form button { flex: 0 0 auto; padding: 10px 18px; font-family: var(--mono); font-size: 14px; font-weight: 500; color: var(--bg); background: var(--green); border: 2px solid var(--ink); border-radius: 3px; cursor: pointer; }
  .newsletter-form button:hover { box-shadow: 3px 3px 0 var(--shadow); }
  .newsletter-form button:disabled { opacity: 0.6; cursor: wait; }
  .newsletter-status { order: 2; flex: 1 0 100%; margin: 0; min-height: 1.2em; font-size: 14px; color: var(--text-soft); }
  .newsletter-status:empty { display: none; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>
