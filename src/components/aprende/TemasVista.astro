---
// Vista de temas: del tema elegido, qué han votado los partidos y, plegado debajo, qué proponen
// (el 29-N cuando se publique y, mientras, 2023) y con quién coincide cada uno. El menú de temas y
// «Quién decide» van en la columna derecha (TemasAside); en pantallas estrechas, donde esa columna
// cae debajo, el tema se elige con un desplegable.
import AfinidadMatriz from './AfinidadMatriz.astro';
import { temas } from '../../data/politica/temas';
import { votosPorTema } from '../../lib/temas';
import { programas2023, propuestas2023, sinPrograma2023 } from '../../data/politica/programas-2023';
import {
  afinidadDe, escanosActuales, fecha, partidoById, partidos, posicion, proponentes, resultadoTexto, siglasCortas, tipos, tituloCorto,
} from '../../lib/politica';

const orden = [...partidos].sort((a, b) => escanosActuales(b.id) - escanosActuales(a.id)).map((p) => p.id).filter((id) => escanosActuales(id) > 0);
// Para 2023 cuentan todos los partidos de la lista, tengan o no escaño hoy.
const orden2023 = [...partidos].sort((a, b) => escanosActuales(b.id) - escanosActuales(a.id)).map((p) => p.id);
const traducidos = Object.values(programas2023).filter((p) => p.idioma).map((p) => p.idioma);
const tipoLabel = (t: string) => tipos[t as keyof typeof tipos]?.label ?? t;

const vistas = temas.map((tema) => {
  const votos = votosPorTema.get(tema.id)!;
  // Afinidad y cohesión solo con las votaciones de este tema.
  const datos = afinidadDe(votos, orden);
  return { tema, votos, datos };
});
---
<div class="tv" data-temas>
  <label class="tv-pick">
    <span>Tema</span>
    <select data-tema-select>
      {vistas.map(({ tema, votos }) => <option value={tema.id}>{tema.icono} {tema.nombre} ({votos.length})</option>)}
    </select>
  </label>

  {vistas.map(({ tema, votos, datos }, i) => {
    const con2023 = orden2023.filter((id) => propuestas2023[tema.id]?.[id]);
    const conPropuesta = orden.filter((id) => tema.propuestas[id]);
    return (
    <section class="tv-panel" data-tema-panel={tema.id} hidden={i !== 0} aria-label={tema.nombre}>
      <h3 class="tv-title"><span aria-hidden="true">{tema.icono}</span> {tema.nombre} <small>{votos.length} votaciones</small></h3>

      <div>
        {votos.length > 0 ? (
          <>
            <div class="tv-grid-scroll">
              <table class="tv-grid">
                <thead>
                  <tr>
                    <th scope="col">Votación</th>
                    {orden.map((id) => <th scope="col" class="tv-p" title={partidoById.get(id)!.siglas}><span style={`--pc: ${partidoById.get(id)!.color}`}>{siglasCortas[id]}</span></th>)}
                  </tr>
                </thead>
                <tbody data-more-list>
                  {votos.map((v, j) => (
                    <tr hidden={j >= 8}>
                      <th scope="row">
                        <span class="tv-meta">{fecha(v.fecha)} · {tipoLabel(v.tipo)}{v.tipo === 'propuesta' ? ` (${proponentes(v).texto})` : ''} · <b class:list={[v.resultado === 'aprobada' ? 'ok' : 'ko']}>{resultadoTexto(v.tipo, v.resultado)}</b></span>
                        <span class="tv-vt">{tituloCorto(v)}</span>
                      </th>
                      {v.partidos ? orden.map((id) => {
                        const r = (v.partidos as Record<string, number[]> | null)?.[id];
                        const p = posicion(r);
                        const div = r && [r[0], r[1], r[2]].filter((x) => x > 0).length > 1;
                        return <td><i class:list={['vt', p ? `vt-${p}` : 'vt-x']} title={`${partidoById.get(id)!.siglas}: ${r ? `${r[0]} sí, ${r[1]} no, ${r[2]} abst.` : 'sin datos'}`}>{p ? (div ? '½' : p) : '·'}</i></td>;
                      }) : (
                        <td colspan={orden.length} class="tv-nodata">Sin voto por partido: el Congreso solo publica el total ({v.totales.si} sí, {v.totales.no} no).</td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {votos.length > 8 && <button type="button" class="tv-more" data-more>Ver las {votos.length}</button>}
            <p class="tv-muted small">S: sí · N: no · A: abstención · ½: el partido se dividió. En una enmienda a la totalidad, «sí» es querer tumbar el texto.</p>
          </>
        ) : (
          <p class="tv-muted">No hay votaciones clave sobre este tema en la legislatura.</p>
        )}
      </div>

      <details class="tv-fold">
        <summary>Qué proponen</summary>
        {conPropuesta.length === 0 ? (
          <p class="tv-pending"><b>29-N:</b> aún no hay programas. Se añadirán todos a la vez cuando se publiquen. Mientras, lo que propuso cada uno en 2023:</p>
        ) : (
          <ul class="tv-props">
            {conPropuesta.map((id) => (
              <li><span class="pt" style={`--pc: ${partidoById.get(id)!.color}`}>{partidoById.get(id)!.siglas}</span> {tema.propuestas[id].texto} <a href={tema.propuestas[id].fuente}>programa</a></li>
            ))}
          </ul>
        )}
        <ul class="tv-h23">
          {con2023.map((id) => {
            const lista = propuestas2023[tema.id][id];
            const item = (x: (typeof lista)[number]) => <li>{x.t} <a href={`${programas2023[id].url}#page=${x.p}`} target="_blank" rel="noopener" title={`${programas2023[id].titulo}, página ${x.p} del PDF`}>p.{x.p}</a></li>;
            return (
              <li class="tv-h23-p">
                <span class="pt" style={`--pc: ${partidoById.get(id)!.color}`}>{partidoById.get(id)!.siglas}</span>
                <ul>{lista.slice(0, 2).map(item)}</ul>
                {lista.length > 2 && (
                  <details class="tv-h23-more"><summary>{lista.length - 2} más</summary><ul>{lista.slice(2).map(item)}</ul></details>
                )}
              </li>
            );
          })}
        </ul>
        <details class="tv-fine">
          <summary>Sobre estos programas</summary>
          <p>
            Programas de las generales de 2023, con la página de cada medida. Si un partido no aparece, no hemos encontrado una propuesta concreta sobre este tema.
            {' '}{programas2023.podemos.nota} {Object.values(sinPrograma2023).join(' ')} Los programas en {[...new Set(traducidos)].join(' y ')} están traducidos. El de Junts enlaza a una copia de Betevé porque el partido ya no lo tiene en su web.
          </p>
        </details>
      </details>

      {votos.length >= 3 && (
        <details class="tv-fold">
          <summary>Con quién coincide cada partido</summary>
          <AfinidadMatriz
            orden={orden}
            datos={datos}
            pie={`En cuántas de las ${votos.length} votaciones de este tema votó lo mismo la mayoría de cada par de partidos (%). «—»: menos de tres comparables.`}
          />
        </details>
      )}
    </section>
    );
  })}
  <details class="tv-fine">
    <summary>Cómo se asignan las votaciones a cada tema</summary>
    <p>Por palabras clave de su título, con una regla fija igual para todas. Algunas encajan en varios temas y otras en ninguno; todas están en la pestaña Votaciones.</p>
  </details>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-temas]')) {
    // El menú está en la columna derecha (fuera de root) y el desplegable, dentro: los dos eligen tema.
    const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-tema]')];
    const select = root.querySelector<HTMLSelectElement>('[data-tema-select]')!;
    const panels = [...root.querySelectorAll<HTMLElement>('[data-tema-panel]')];
    const decide = [...document.querySelectorAll<HTMLElement>('[data-tema-decide]')];
    const elige = (id: string) => {
      for (const b of botones) b.setAttribute('aria-selected', String(b.dataset.tema === id));
      for (const p of panels) p.hidden = p.dataset.temaPanel !== id;
      for (const d of decide) d.hidden = d.dataset.temaDecide !== id;
      select.value = id;
    };
    for (const b of botones) b.addEventListener('click', () => elige(b.dataset.tema!));
    select.addEventListener('change', () => elige(select.value));
    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-more]')) {
      const body = button.previousElementSibling!.querySelector('[data-more-list]')!;
      button.addEventListener('click', () => {
        for (const tr of body.querySelectorAll<HTMLElement>('tr[hidden]')) tr.hidden = false;
        button.remove();
      });
    }
  }
</script>

<style>
  .tv { display: flex; flex-direction: column; gap: 14px; }
  .tv-pick { display: none; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; color: var(--muted); }
  .tv-pick select { flex: 1; min-width: 0; padding: 8px 10px; font: inherit; font-size: 14px; color: var(--ink); background: var(--bg); border: 1px solid var(--panel-line); border-radius: 10px; }
  @media (max-width: 1180px) { .tv-pick { display: flex; } }
  .tv-panel[hidden] { display: none; }
  .tv-panel { display: flex; flex-direction: column; gap: 14px; }
  .tv-title { margin: 0; font-family: var(--display); font-size: 24px; font-weight: 800; letter-spacing: -0.5px; }
  .tv-title small { font-family: var(--mono); font-size: 12px; font-weight: 400; letter-spacing: 0; color: var(--muted); }
  .tv-fold { border-top: 1px solid var(--panel-line); padding-top: 12px; }
  .tv-fold > summary { cursor: pointer; font-family: var(--display); font-size: 17px; font-weight: 800; letter-spacing: -0.2px; list-style: none; }
  .tv-fold > summary::before { content: '+'; display: inline-block; width: 20px; color: var(--accent); }
  .tv-fold[open] > summary::before { content: '−'; }
  .tv-fold[open] > summary { margin-bottom: 12px; }
  .tv-muted { margin: 0; font-size: 14px; line-height: 1.55; color: var(--muted); }
  .tv-muted.small { font-size: 12.5px; margin-top: 6px; }
  .tv-pending { margin: 0 0 10px; font-size: 13.5px; color: var(--muted); }
  .tv-pending b { color: var(--ink); }
  .tv-h23 { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 8px; }
  .tv-h23-p { padding: 10px 12px; background: var(--bg); border: 1px solid var(--panel-line); border-radius: 10px; }
  .tv-h23-p ul { margin: 6px 0 0; padding-left: 16px; font-size: 13.5px; line-height: 1.45; color: var(--text-soft); }
  .tv-h23-p li + li { margin-top: 4px; }
  .tv-h23-p a { font-family: var(--mono); font-size: 10.5px; white-space: nowrap; color: var(--muted); text-decoration: none; }
  .tv-h23-p a:hover { color: var(--accent); }
  .tv-h23-more summary { margin-top: 6px; font-size: 12px; font-weight: 600; color: var(--accent); cursor: pointer; list-style: none; }
  .tv-h23-more summary::before { content: '+ '; }
  .tv-h23-more[open] summary { display: none; }
  .tv-fine { font-size: 12.5px; color: var(--muted); }
  .tv-fine summary { cursor: pointer; font-weight: 600; }
  .tv-fine p { margin: 6px 0 0; line-height: 1.5; max-width: 760px; }
  .tv-props { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 14px; }
  .tv-grid-scroll { overflow-x: auto; }
  .tv-grid { width: 100%; border-collapse: collapse; }
  .tv-grid thead th { position: sticky; top: -18px; z-index: 1; padding: 6px 2px; font-family: var(--mono); font-size: 10.5px; font-weight: 600; color: var(--muted); text-align: left; background: var(--panel); }
  .tv-grid thead th.tv-p { text-align: center; }
  .tv-p span { display: inline-block; padding-bottom: 2px; border-bottom: 2px solid var(--pc); }
  .tv-grid tbody tr { border-top: 1px solid var(--panel-line); }
  .tv-grid tbody tr[hidden] { display: none; }
  .tv-grid tbody th { padding: 7px 10px 7px 0; text-align: left; font-weight: 400; min-width: 260px; }
  .tv-grid td { padding: 0 1px; text-align: center; }
  .tv-grid .vt { min-width: 22px; height: 22px; padding: 0; font-size: 10.5px; }
  .tv-meta { display: block; font-size: 11px; color: var(--muted); }
  .tv-meta b.ok { color: var(--green); }
  .tv-meta b.ko { color: var(--red); }
  .tv-nodata { font-size: 12.5px; color: var(--muted); }
  .tv-vt { display: -webkit-box; font-size: 13.5px; line-height: 1.35; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tv-more { align-self: flex-start; margin-top: 8px; padding: 6px 14px; font: inherit; font-size: 13px; font-weight: 600; color: var(--accent); background: var(--panel-2); border: 0; border-radius: 999px; cursor: pointer; }
</style>
