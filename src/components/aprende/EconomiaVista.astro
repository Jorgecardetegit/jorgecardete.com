---
// Vista de economía: un botón por tema y, del elegido, la pregunta, la respuesta en una frase,
// tres cifras (el primer año, 2018 y hoy) con la UE al lado y una sola gráfica, España frente a
// la UE. Sin colores de partido: 2011 y 2018 se explican como los años del cambio de presidente.
// Qué mide, qué depende del Gobierno, la tabla y la fuente quedan plegados en «Saber más».
import { generado, preguntas, sacudidas, type Pregunta } from '../../data/politica/economia';
import { fecha } from '../../lib/politica';

// Dos lienzos: el ancho y uno estrecho para móvil, con textos que se lean al encogerse.
interface Lienzo { id: string; W: number; H: number; M: { l: number; r: number; t: number; b: number }; anios: number[]; etiquetas: boolean }
const lienzos: Lienzo[] = [
  { id: 'ancho', W: 720, H: 300, M: { l: 58, r: 74, t: 30, b: 28 }, anios: [2011, 2014, 2018, 2022, 2026], etiquetas: true },
  { id: 'movil', W: 360, H: 260, M: { l: 50, r: 62, t: 14, b: 24 }, anios: [2011, 2018, 2026], etiquetas: false },
];
const X0 = 2011;
const X1 = 2026.9;
// '2025' → 2025; '2026-09' → 2026,7; '2026-Q2' → 2026,4.
const momento = (p: string) => (p.includes('Q') ? Number(p.slice(0, 4)) + (Number(p.slice(-1)) - 0.5) / 4 : p.length > 4 ? Number(p.slice(0, 4)) + (Number(p.slice(5)) - 0.5) / 12 : Number(p));
const periodo = (p: string) =>
  p.includes('Q') ? `${p.slice(-1)}.º trim. ${p.slice(0, 4)}` : p.length > 4 ? fecha(`${p}-01`, { month: 'short', year: 'numeric' }) : p;

// Escala vertical con 4 o 5 marcas redondas que incluyen los datos y la línea de referencia.
function escala(valores: number[], { H, M }: Lienzo) {
  let lo = Math.min(...valores);
  let hi = Math.max(...valores);
  if (lo === hi) { lo -= 1; hi += 1; }
  const bruto = (hi - lo) / 4;
  const pot = 10 ** Math.floor(Math.log10(bruto));
  const paso = [1, 2, 2.5, 5, 10].map((k) => k * pot).find((p) => p >= bruto)!;
  const a = Math.floor(lo / paso) * paso;
  const b = Math.ceil(hi / paso) * paso;
  const marcas: number[] = [];
  for (let v = a; v <= b + paso / 2; v += paso) marcas.push(Math.round(v * 1000) / 1000);
  return { y: (v: number) => M.t + (1 - (v - a) / (b - a)) * (H - M.t - M.b), marcas };
}

const ordenada = (s: Record<string, number>) => Object.entries(s).sort(([a], [b]) => a.localeCompare(b)).map(([a, v]) => [Number(a), v] as const);

// Marcas del eje: «175 mil €» en vez de «175.000 €», y «30 %» en vez de «30,0 %».
const marca = (p: Pregunta, v: number) => (Math.abs(v) >= 10000 ? `${(v / 1000).toLocaleString('es-ES')} mil` : p.fmt(v).replace(/,0+(?=\D|$)/, ''));
const fin = (p: Pregunta, v: number) => (Math.abs(v) >= 10000 ? `${Math.round(v / 1000).toLocaleString('es-ES')} mil €` : p.fmt(v));

// Las tres cifras: el primer año, 2018 y hoy.
function cifras(p: Pregunta) {
  const primero = Object.keys(p.es).sort()[0];
  return [
    { etiqueta: primero, valor: p.es[primero], ue: p.ue?.[primero] ?? null, a: Number(primero) },
    { etiqueta: '2018', valor: p.es[2018], ue: p.ue?.[2018] ?? null, a: 2018 },
    { etiqueta: `Hoy · ${periodo(p.hoy.periodo)}`, valor: p.hoy.valor, ue: p.hoy.ue, a: momento(p.hoy.periodo) },
  ];
}

function vista(p: Pregunta, L: Lienzo) {
  const { W, M } = L;
  const x = (a: number) => M.l + ((a - X0) / (X1 - X0)) * (W - M.l - M.r);
  const es = ordenada(p.es);
  const ue = p.ue ? ordenada(p.ue) : [];
  const conHoy = p.hoy.periodo.length > 4;
  const { y, marcas } = escala([...es.map(([, v]) => v), ...ue.map(([, v]) => v), p.hoy.valor, ...(p.linea ? [p.linea.valor] : [])], L);
  const camino = (s: (readonly [number, number])[]) => s.map(([a, v], k) => `${k ? 'L' : 'M'}${x(a).toFixed(1)},${y(v).toFixed(1)}`).join('');
  const [aFin, vFin] = es.at(-1)!;
  const xHoy = conHoy ? x(momento(p.hoy.periodo)) : x(aFin);
  // Valores de la UE al final de su línea y de España en «hoy», separados si se pisan.
  const ueFin = ue.at(-1);
  let yEs = y(p.hoy.valor);
  let yUe = ueFin ? y(ueFin[1]) : 0;
  if (ueFin && Math.abs(yEs - yUe) < 16) {
    const medio = (yEs + yUe) / 2;
    const arriba = p.hoy.valor >= ueFin[1];
    yEs = medio + (arriba ? -8 : 8);
    yUe = medio + (arriba ? 8 : -8);
  }
  const anios = [...new Set([...es.map(([a]) => a), ...ue.map(([a]) => a)])].sort((a, b) => a - b);
  const tips = anios.map((a) => ({
    a,
    html: [`<b>${a}</b>`, p.es[a] != null ? `España: ${p.fmt(p.es[a])}` : '', p.ue?.[a] != null ? `${p.ref}: ${p.fmt(p.ue[a])}` : ''].filter(Boolean).join('<br>'),
  }));
  if (conHoy) tips.push({ a: momento(p.hoy.periodo), html: `<b>${periodo(p.hoy.periodo)}</b><br>España: ${p.fmt(p.hoy.valor)}${p.hoy.ue != null ? `<br>UE: ${p.fmt(p.hoy.ue)}` : ''}` });
  return { x, y, marcas, camino, es, ue, conHoy, aFin, vFin, xHoy, cifras: cifras(p), ueFin, yEs, yUe, tips, anios };
}
---
<div class="ec">
  <div class="ec-temas" role="tablist" aria-label="Temas de economía">
    {preguntas.map((p, k) => (
      <button type="button" class="ec-tema" role="tab" aria-selected={k === 0 ? 'true' : 'false'} aria-controls={`ec-${p.id}`} data-ec-tema={p.id}>{p.tema}</button>
    ))}
  </div>

  {preguntas.map((p, k) => {
    const anios = [...new Set([...Object.keys(p.es), ...Object.keys(p.ue ?? {})])].sort();
    return (
      <section class="ec-panel" id={`ec-${p.id}`} role="tabpanel" aria-label={p.tema} hidden={k > 0} data-ec-panel={p.id}>
        <h3 class="ec-q">{p.pregunta}</h3>
        <p class="ec-a">{p.respuesta}</p>

        <ul class="ec-cifras">
          {cifras(p).map((c, i) => (
            <li class:list={['ec-cifra', { hoy: i === 2 }]}>
              <span class="ec-cifra-t">{c.etiqueta}</span>
              <strong>{c.valor != null ? p.fmt(c.valor) : '—'}</strong>
              {p.ref === 'UE' && <span class="ec-cifra-ue">UE: {c.ue != null ? p.fmt(c.ue) : '—'}</span>}
            </li>
          ))}
        </ul>

        <figure class="ec-fig" data-ec-fig>
          <figcaption class="ec-eje">
            <span>{p.eje}</span>
            <span class="ec-legend">
              <span><i class="ec-k es" />España</span>
              {p.ue && <span><i class="ec-k ue" />{p.ref}</span>}
              {p.linea && <span><i class="ec-k ref" />{p.linea.texto}</span>}
            </span>
          </figcaption>
          {lienzos.map((L) => {
            const { W, H, M } = L;
            const v = vista(p, L);
            const x = v.x;
            return (
              <div class={`ec-plot ec-plot-${L.id}`}>
                <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${p.pregunta} Gráfica de ${v.anios[0]} a hoy. Los datos, en «Saber más».`}>
                  {v.marcas.map((m) => (
                    <g>
                      <line x1={M.l} x2={W - M.r} y1={v.y(m)} y2={v.y(m)} class="ec-grid" />
                      <text x={M.l - 8} y={v.y(m) + 4} class="ec-axis">{marca(p, m)}</text>
                    </g>
                  ))}
                  {sacudidas.map((s) => (
                    <g>
                      <line x1={x(s.anio)} x2={x(s.anio)} y1={M.t - (L.etiquetas ? 8 : 0)} y2={H - M.b} class="ec-shock"><title>{s.texto} ({s.anio})</title></line>
                      {L.etiquetas && <text x={x(s.anio) + (s.anio === 2020 ? -4 : 4)} y={M.t - 14} class:list={['ec-shock-t', { fin: s.anio === 2020 }]}>{s.texto}</text>}
                    </g>
                  ))}
                  {p.linea && <line x1={M.l} x2={W - M.r} y1={v.y(p.linea.valor)} y2={v.y(p.linea.valor)} class="ec-ref" />}
                  {L.anios.map((a) => <text x={x(a)} y={H - 6} class="ec-axis mid">{a}</text>)}
                  {v.ue.length > 0 && <path d={v.camino(v.ue)} class="ec-line ue" />}
                  <path d={v.camino(v.es)} class="ec-line es" />
                  {v.conHoy && <path d={`M${x(v.aFin)},${v.y(v.vFin)}L${v.xHoy},${v.y(p.hoy.valor)}`} class="ec-line es hoy" />}
                  {v.cifras.map((c) => c.valor != null && <circle cx={x(c.a)} cy={v.y(c.valor)} r="5" class="ec-dot" />)}
                  <text x={v.xHoy + 9} y={v.yEs + 4} class="ec-end">{fin(p, p.hoy.valor)}</text>
                  {v.ueFin && <text x={x(v.ueFin[0]) + 9} y={v.yUe + 4} class="ec-end ue">{fin(p, v.ueFin[1])}</text>}
                  <line class="ec-cross" x1="0" x2="0" y1={M.t} y2={H - M.b} data-ec-cross />
                  {v.tips.map((t) => (
                    <rect class="ec-hit" x={x(t.a) - (x(1) - x(0)) / 2} y={M.t} width={x(1) - x(0)} height={H - M.t - M.b} data-x={x(t.a)} data-tip={t.html} />
                  ))}
                </svg>
                <div class="ec-tip" role="status" hidden data-ec-tip />
              </div>
            );
          })}
        </figure>

        <details class="ec-more">
          <summary>Saber más: qué mide y qué depende del Gobierno</summary>
          <p>{p.que}</p>
          <p><b>El Gobierno:</b> {p.gobierno}</p>
          {p.ojo && <p class="ec-ojo"><b>Ojo:</b> {p.ojo}</p>}
          <div class="ec-table-wrap">
            <table class="ec-table">
              <thead><tr><th scope="col">Año</th><th scope="col">España</th>{p.ue && <th scope="col">{p.ref}</th>}</tr></thead>
              <tbody>
                {anios.map((a) => (
                  <tr><th scope="row">{a}</th><td>{p.es[a] != null ? p.fmt(p.es[a]) : '—'}</td>{p.ue && <td>{p.ue[a] != null ? p.fmt(p.ue[a]) : '—'}</td>}</tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="ec-src">Fuente: <a href={p.fuente.url}>{p.fuente.titulo}</a></p>
        </details>
      </section>
    );
  })}

  <p class="ec-note">2011 y 2018 son los años en que cambió el presidente del Gobierno. Un Gobierno influye en la economía, pero no la controla: muchas cifras dependen más de Europa, de los precios de la energía o del Banco Central Europeo, y por eso la UE aparece al lado. Datos de Eurostat, que mide igual a todos los países (por eso algunas cifras difieren unas décimas de las del INE), descargados el {fecha(generado, { day: 'numeric', month: 'long', year: 'numeric' })}. El salario mínimo sale del BOE.</p>
</div>

<script>
  // Temas: muestran su panel.
  const temas = [...document.querySelectorAll<HTMLButtonElement>('[data-ec-tema]')];
  const paneles = [...document.querySelectorAll<HTMLElement>('[data-ec-panel]')];
  for (const t of temas) {
    t.addEventListener('click', () => {
      for (const x of temas) x.setAttribute('aria-selected', String(x === t));
      for (const p of paneles) p.hidden = p.dataset.ecPanel !== t.dataset.ecTema;
    });
  }
  // Al pasar por un año: raya vertical y los valores de ese año.
  for (const fig of document.querySelectorAll<HTMLElement>('.ec-plot')) {
    const svg = fig.querySelector('svg')!;
    const cross = fig.querySelector<SVGLineElement>('[data-ec-cross]')!;
    const tip = fig.querySelector<HTMLElement>('[data-ec-tip]')!;
    for (const r of fig.querySelectorAll<SVGRectElement>('.ec-hit')) {
      r.addEventListener('pointerenter', () => {
        const xv = r.dataset.x!;
        cross.setAttribute('x1', xv);
        cross.setAttribute('x2', xv);
        cross.classList.add('on');
        tip.innerHTML = r.dataset.tip!;
        tip.hidden = false;
        const pct = Number(xv) / svg.viewBox.baseVal.width;
        tip.style.left = `${pct * 100}%`;
        tip.classList.toggle('left', pct > 0.6);
      });
    }
    svg.addEventListener('pointerleave', () => {
      cross.classList.remove('on');
      tip.hidden = true;
    });
  }
</script>

<style>
  .ec { display: flex; flex-direction: column; gap: 16px; }
  .ec-temas { display: flex; flex-wrap: wrap; gap: 6px; }
  .ec-tema { padding: 7px 14px; font: inherit; font-size: 13.5px; font-weight: 600; color: var(--text-soft); background: var(--bg); border: 1px solid var(--panel-line); border-radius: 999px; cursor: pointer; }
  .ec-tema:hover { color: var(--ink); border-color: var(--accent); }
  .ec-tema[aria-selected='true'] { color: var(--bg); background: var(--ink); border-color: var(--ink); }

  .ec-panel { display: flex; flex-direction: column; gap: 14px; }
  .ec-panel[hidden] { display: none; }
  .ec-q { margin: 6px 0 0; font-family: var(--display); font-size: 28px; font-weight: 800; letter-spacing: -0.7px; line-height: 1.15; color: var(--ink); }
  .ec-a { margin: 0; max-width: 62ch; font-size: 17px; line-height: 1.55; color: var(--ink); }

  .ec-cifras { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .ec-cifra { display: flex; flex-direction: column; gap: 2px; padding: 10px 14px; background: var(--bg); border: 1px solid var(--panel-line); border-radius: 12px; }
  .ec-cifra.hoy { border-color: var(--ink); }
  .ec-cifra-t { font-family: var(--mono); font-size: 11.5px; color: var(--muted); }
  .ec-cifra strong { font-family: var(--display); font-size: 26px; font-weight: 800; letter-spacing: -0.6px; color: var(--ink); }
  .ec-cifra-ue { font-family: var(--mono); font-size: 12px; color: var(--text-soft); }

  .ec-fig { margin: 0; padding: 12px 14px 8px; background: var(--bg); border: 1px solid var(--panel-line); border-radius: 12px; }
  .ec-eje { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 14px; margin-bottom: 6px; font-size: 13px; color: var(--text-soft); }
  .ec-legend { display: flex; flex-wrap: wrap; gap: 2px 12px; }
  .ec-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .ec-k { display: inline-block; width: 18px; border-top: 2.5px solid var(--accent); }
  .ec-k.ue { border-top: 2px dashed var(--muted); }
  .ec-k.ref { border-top: 1px dashed var(--muted); }
  .ec-plot { position: relative; }
  .ec-plot-movil { display: none; }
  @media (max-width: 560px) {
    .ec-plot-ancho { display: none; }
    .ec-plot-movil { display: block; }
  }
  .ec-plot svg { display: block; width: 100%; height: auto; overflow: visible; touch-action: pan-y; }
  .ec-grid { stroke: var(--panel-line); }
  .ec-axis { font-family: var(--mono); font-size: 11.5px; fill: var(--muted); text-anchor: end; }
  .ec-axis.mid { text-anchor: middle; }
  .ec-shock { stroke: var(--muted); stroke-dasharray: 2 4; opacity: .7; }
  .ec-shock-t { font-size: 11.5px; fill: var(--muted); }
  .ec-shock-t.fin { text-anchor: end; }
  .ec-ref { stroke: var(--muted); stroke-dasharray: 6 4; opacity: .7; }
  .ec-line { fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .ec-line.es { stroke: var(--accent); stroke-width: 3; }
  .ec-line.es.hoy { stroke-dasharray: 3 5; }
  .ec-line.ue { stroke: var(--muted); stroke-width: 2; stroke-dasharray: 6 5; }
  .ec-dot { fill: var(--accent); stroke: var(--bg); stroke-width: 2.5; }
  .ec-end { font-family: var(--mono); font-size: 13px; font-weight: 700; fill: var(--ink); }
  .ec-end.ue { font-weight: 400; fill: var(--muted); }
  .ec-cross { stroke: var(--ink); opacity: 0; pointer-events: none; }
  .ec-cross.on { opacity: .35; }
  .ec-hit { fill: transparent; }
  .ec-tip { position: absolute; top: 6px; z-index: 2; transform: translateX(12px); padding: 7px 10px; font-size: 13px; line-height: 1.45; white-space: nowrap; color: var(--ink); background: var(--panel); border: 1px solid var(--panel-line); border-radius: 8px; box-shadow: 0 4px 14px rgb(0 0 0 / .12); pointer-events: none; }
  .ec-tip.left { transform: translateX(calc(-100% - 12px)); }
  .ec-tip[hidden] { display: none; }

  .ec-more { font-size: 14px; line-height: 1.55; color: var(--text-soft); }
  .ec-more summary { cursor: pointer; font-size: 13.5px; font-weight: 600; color: var(--accent); }
  .ec-more p { margin: 8px 0 0; max-width: 70ch; }
  .ec-more b { color: var(--ink); }
  .ec-ojo { padding: 8px 12px; background: var(--panel-2); border-radius: 8px; }
  .ec-table-wrap { margin-top: 10px; max-width: 420px; max-height: 260px; overflow-y: auto; }
  .ec-table { width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: 12.5px; }
  .ec-table th, .ec-table td { padding: 3px 8px; text-align: right; border-bottom: 1px solid var(--panel-line); }
  .ec-table th[scope='row'], .ec-table thead th:first-child { text-align: left; font-weight: 400; color: var(--muted); }
  .ec-table thead th { position: sticky; top: 0; background: var(--panel); font-weight: 600; color: var(--muted); }
  .ec-src { font-size: 12.5px; color: var(--muted); }
  .ec-note { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--muted); }

  @media (max-width: 560px) {
    .ec-q { font-size: 23px; }
    .ec-a { font-size: 15.5px; }
    .ec-cifra { padding: 8px 10px; }
    .ec-cifra strong { font-size: 19px; }
  }
</style>
