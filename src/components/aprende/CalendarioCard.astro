---
// Calendario electoral del 29-N: lo ya pasado se tacha y lo siguiente se resalta.
const calendario = [
  { fecha: '2026-10-06', label: 'Convocatoria en el BOE' },
  { fecha: '2026-11-03', label: 'Candidaturas oficiales en el BOE (fecha aproximada)' },
  { fecha: '2026-11-13', label: 'Empieza la campaña' },
  { fecha: '2026-11-19', label: 'Último día para pedir el voto por correo' },
  { fecha: '2026-11-24', label: 'Prohibido publicar encuestas' },
  { fecha: '2026-11-25', label: 'Último día para enviar el voto por correo' },
  { fecha: '2026-11-29', label: 'Votación, de 9 a 20 h' },
  { fecha: '2026-12-23', label: 'Se constituyen las nuevas Cortes' },
];
const dia = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---
<section class="ap-card ap-panel">
  <header class="ap-card-head">
    <h2 class="ap-card-title">Calendario del 29-N</h2>
  </header>
  <ol class="cal" data-calendario>
    {calendario.map((c) => (
      <li data-date={c.fecha}>
        <span class="cal-date">{dia.format(new Date(c.fecha))}</span>
        <span>{c.label}</span>
      </li>
    ))}
  </ol>
</section>

<script>
  const today = new Date().toISOString().slice(0, 10);
  for (const list of document.querySelectorAll('[data-calendario]')) {
    const dates = [...list.querySelectorAll<HTMLElement>('[data-date]')];
    const next = dates.find((d) => d.dataset.date! >= today);
    for (const d of dates) {
      d.classList.toggle('is-past', d.dataset.date! < today);
      d.classList.toggle('is-next', d === next);
    }
  }
</script>

<style>
  .cal { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .cal li { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 8px; padding: 5px 6px; margin: 0 -6px; border-radius: 8px; font-size: 13.5px; line-height: 1.35; }
  .cal-date { font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .cal li.is-past { opacity: .45; }
  .cal li.is-past span:last-child { text-decoration: line-through; }
  .cal li.is-next { background: color-mix(in srgb, var(--accent) 12%, transparent); font-weight: 600; }
  .cal li.is-next .cal-date { color: var(--accent); }
</style>
