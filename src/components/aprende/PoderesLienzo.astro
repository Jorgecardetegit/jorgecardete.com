---
// Esquema de las instituciones sobre un lienzo de 1000×600: las líneas van en SVG y
// las cajas son botones HTML encima. Al pulsar una se resaltan sus conexiones y abajo
// aparece su ficha (bloques `[data-detail="inst:<id>"]` de la página).
import { conexiones, instituciones } from '../../data/politica/poderes';

const W = 1000;
const H = 600;
const NW = 180;
const NH = 64;
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(3)}%`;
---
<div class="pl-wrap">
  <div class="pl-canvas" data-poderes>
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
      <defs>
        <marker id="pl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10z" class="pl-arrow" />
        </marker>
      </defs>
      <rect class="pl-group" x="290" y="150" width="420" height="110" rx="14" />
      <text class="pl-group-label" x="292" y="142">CORTES GENERALES · PODER LEGISLATIVO</text>
      <rect class="pl-group is-dashed" x="505" y="300" width="200" height="262" rx="14" />
      <text class="pl-group-label" x="505" y="584">AUTONÓMICAS Y MUNICIPALES: TAMBIÉN LAS VOTAS</text>
      {conexiones.map((c) => (
        <g class="pl-edge" data-from={c.de} data-to={c.a}>
          <polyline points={c.puntos.map((p) => p.join(',')).join(' ')} marker-end="url(#pl-arrow)" />
          <text x={c.en[0]} y={c.en[1]} text-anchor={c.puntos.length === 2 && c.puntos[0][0] === c.puntos[1][0] ? 'start' : 'middle'}>{c.etiqueta}</text>
        </g>
      ))}
    </svg>
    {instituciones.map((n) => (
      <button
        type="button"
        class="pl-node"
        style={`left: ${pct(n.x - NW / 2, W)}; top: ${pct(n.y - NH / 2, H)}; width: ${pct(NW, W)}; height: ${pct(NH, H)}; --c: var(--${n.color})`}
        data-node={n.id}
        aria-pressed="false"
      >
        <span class="pl-icon" aria-hidden="true">{n.icono}</span>
        <span class="pl-text"><strong>{n.nombre}</strong><small>{n.etiqueta}</small></span>
      </button>
    ))}
  </div>
</div>

<script>
  import { showDetail } from '../../lib/aprende-detail';

  for (const canvas of document.querySelectorAll<HTMLElement>('[data-poderes]')) {
    const nodes = [...canvas.querySelectorAll<HTMLButtonElement>('[data-node]')];
    const edges = [...canvas.querySelectorAll<SVGGElement>('.pl-edge')];

    const select = (id: string | null) => {
      canvas.classList.toggle('has-selection', id !== null);
      const linked = new Set<string>();
      for (const e of edges) {
        const on = id !== null && (e.dataset.from === id || e.dataset.to === id);
        e.classList.toggle('on', on);
        if (on) linked.add(e.dataset.from!).add(e.dataset.to!);
      }
      for (const n of nodes) {
        n.setAttribute('aria-pressed', String(n.dataset.node === id));
        n.classList.toggle('linked', linked.has(n.dataset.node!));
      }
      showDetail(id ? `inst:${id}` : 'intro');
    };

    for (const n of nodes) {
      n.addEventListener('click', () => select(n.getAttribute('aria-pressed') === 'true' ? null : n.dataset.node!));
    }
    document.addEventListener('ap:reset', () => select(null));
  }
</script>

<style>
  /* El lienzo se ajusta al hueco disponible manteniendo la proporción 5:3. */
  .pl-wrap { position: absolute; inset: 60px 12px 10px; display: grid; place-items: center; container-type: size; }
  .pl-canvas { position: relative; width: min(100cqw, calc(100cqh * 5 / 3)); aspect-ratio: 5 / 3; container-type: inline-size; }
  .pl-canvas svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .pl-group { fill: color-mix(in srgb, var(--green) 7%, transparent); stroke: color-mix(in srgb, var(--green) 45%, transparent); stroke-width: 1.5; }
  .pl-group.is-dashed { fill: color-mix(in srgb, var(--purple) 6%, transparent); stroke: color-mix(in srgb, var(--purple) 40%, transparent); stroke-dasharray: 6 5; }
  .pl-group-label { font-family: var(--mono); font-size: 11.5px; font-weight: 600; letter-spacing: .6px; fill: var(--muted); }
  .pl-edge polyline { fill: none; stroke: var(--muted); stroke-width: 1.6; opacity: .55; transition: opacity .2s, stroke .2s; }
  .pl-arrow { fill: var(--muted); }
  .pl-edge text { font-family: var(--mono); font-size: 11px; fill: var(--muted); paint-order: stroke; stroke: var(--panel); stroke-width: 4px; stroke-linejoin: round; transition: opacity .2s; }
  .has-selection .pl-edge { opacity: .25; }
  .has-selection .pl-edge.on { opacity: 1; }
  .pl-edge.on polyline { stroke: var(--accent); stroke-width: 2.4; opacity: 1; }
  .pl-edge.on text { fill: var(--ink); font-weight: 600; }

  .pl-node { position: absolute; display: flex; align-items: center; gap: 0.9cqw; padding: 0 1.1cqw; text-align: left; color: var(--ink); background: var(--panel); border: 1px solid var(--panel-line); border-left: 0.55cqw solid var(--c); border-radius: 1.2cqw; box-shadow: var(--panel-shadow); cursor: pointer; transition: transform .15s, opacity .2s, border-color .2s; }
  .pl-node:hover { transform: translateY(-2px); }
  .pl-node:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pl-icon { flex: none; font-size: 2.2cqw; line-height: 1; }
  .pl-text { display: flex; flex-direction: column; min-width: 0; }
  .pl-text strong { font-family: var(--display); font-size: max(11px, 1.7cqw); font-weight: 800; line-height: 1.15; letter-spacing: -0.2px; }
  .pl-text small { font-size: max(10px, 1.25cqw); line-height: 1.2; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .has-selection .pl-node { opacity: .45; }
  .has-selection .pl-node.linked { opacity: 1; }
  .pl-node[aria-pressed='true'] { opacity: 1 !important; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent), var(--panel-shadow); }

  /* En pantallas estrechas el esquema no se lee: las instituciones pasan a ser una
     cuadrícula de tarjetas pulsables, sin las flechas. */
  @media (max-width: 820px) {
    .pl-wrap { position: static; display: block; padding: 12px 14px 16px; container-type: normal; }
    .pl-canvas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; width: auto; aspect-ratio: auto; container-type: normal; }
    .pl-canvas svg { display: none; }
    .pl-node { position: static; width: auto !important; height: auto !important; gap: 8px; padding: 10px; border-left-width: 5px; border-radius: 10px; }
    .pl-icon { font-size: 20px; }
    .pl-text strong { font-size: 14px; }
    .pl-text small { font-size: 11.5px; }
    .has-selection .pl-node { opacity: 1; }
  }
</style>
