---
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<div class="post-list">
  {posts.map((post) => (
    <div class="post-row">
      <div class="post-main">
        <div class="post-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></div>
        <time class="post-date" datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
      </div>
      <div class="tags">
        {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
    </div>
  ))}
</div>
