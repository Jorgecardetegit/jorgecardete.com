---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  sidebar?: boolean;
}

const {
  title,
  description = 'Diseñador y desarrollador. Notas, proyectos y cosas a medio terminar.',
  type = 'website',
  sidebar = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Inicio' ? 'tunombre.dev' : `${title} · tunombre.dev`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Karla:wght@400;500;700&family=JetBrains+Mono:wght@400;500&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    {sidebar ? (
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/">
          <div class="avatar" aria-hidden="true">
            <div style="left:3px;top:0;width:24px;height:9px;background:#8b5a2b;border-radius:8px 8px 0 0;"></div>
            <div style="left:6px;top:7px;width:18px;height:13px;background:#f7d3ae;"></div>
            <div style="left:10px;top:12px;width:3px;height:3px;background:#1f1d1a;border:0;"></div>
            <div style="left:18px;top:12px;width:3px;height:3px;background:#1f1d1a;border:0;"></div>
            <div style="left:5px;top:19px;width:20px;height:11px;background:#b5553f;"></div>
          </div>
          <span class="brand-name">tunombre.dev</span>
        </a>

        <p class="intro">Soy <a href="/#about">[Tu nombre]</a>, diseñador y desarrollador. Esto es mi jardín digital: notas, proyectos y cosas a medio terminar.</p>

        <nav class="nav" aria-label="Principal">
          <a href="/blog/"><span class="tri" style="background:#b5623c;"></span>Blog</a>
          <a href="/#projects"><span class="tri" style="background:#3f6f52;"></span>Proyectos</a>
          <a href="/#interests"><span class="tri" style="background:#c9a227;"></span>Intereses</a>
          <a href="/#about"><span class="tri" style="background:#6b5ea8;"></span>Sobre mí</a>
        </nav>

        <div>
          <div class="label-pixel">EL MAPA</div>
          <div class="map">
            <div class="island"></div>
            <div class="grass"></div>
            <a class="house" href="/#about" title="Sobre mí" style="left:19%;top:26%;"><div style="background:#6b5ea8;"></div></a>
            <a class="house" href="/blog/" title="Blog" style="left:58%;top:22%;"><div style="background:#b5623c;"></div></a>
            <a class="house" href="/#projects" title="Proyectos" style="left:24%;top:58%;"><div style="background:#3f6f52;"></div></a>
            <a class="house" href="/#interests" title="Intereses" style="left:63%;top:56%;"><div style="background:#c9a227;"></div></a>
            <div class="plaza"></div>
          </div>
          <div class="map-hint">Pulsa una casa · o <a href="/quest/">juega el mapa entero</a></div>
        </div>

        <div class="side-foot">
          <div class="side-links">
            <a href="mailto:hola@tunombre.dev" aria-label="Email" title="Email">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </a>
            <a href="https://github.com/Jorgecardetegit" aria-label="GitHub" title="GitHub" rel="me">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
            </a>
            <a href="/rss.xml" aria-label="RSS" title="RSS">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none"/></svg>
            </a>
          </div>
        </div>
      </aside>

      <main class="main">
        <slot />
      </main>
    </div>
    ) : (
    <div class="wide">
      <a class="wide-brand" href="/">← tunombre.dev</a>
      <main class="wide-main">
        <slot />
      </main>
    </div>
    )}
  </body>
</html>
