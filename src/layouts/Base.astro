---
import PixelIcon from '../components/PixelIcon.astro';
import SideMap from '../components/SideMap.astro';
import { getLang, languages, path, translatePath, useTranslations, type Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  sidebar?: boolean;
}

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = t('site.description'),
  type = 'website',
  sidebar = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: new URL(translatePath(Astro.url.pathname, code), Astro.site).href,
}));
// Currículum, Temas y Código: bajo los iconos de redes de la barra lateral.
const morePages = [
  { href: path('resume', lang), label: t('footer.resume') },
  { href: path('topics', lang), label: t('footer.topics') },
  { href: 'https://github.com/Jorgecardetegit/Jorgecardetegit.github.io', label: t('footer.source') },
].map((p) => ({ ...p, current: p.href === Astro.url.pathname }));
const fullTitle = title === 'Inicio' || title === 'Home' ? 'tunombre.dev' : `${title} · tunombre.dev`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Tema claro/oscuro antes de pintar (sin destello): lo elegido, o si no, lo del sistema.
      (() => {
        const key = 'jorge.dev:theme';
        let theme = null;
        try { theme = localStorage.getItem(key); } catch {}
        if (theme !== 'dark' && theme !== 'light') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.addEventListener('click', (e) => {
          if (!e.target.closest('.theme-toggle')) return;
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem(key, next); } catch {}
        });
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.code === 'es')!.href} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@400;500;600;700&family=Google+Sans+Code:wght@300..800&family=Outfit:wght@100..900&family=JetBrains+Mono:wght@400;500&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    {sidebar ? (
    <div class="shell">
      <aside class="sidebar">
        <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="sidebar-menu" aria-label={t('sidebar.menu')}>
          <span></span><span></span><span></span>
        </button>
        <a class="brand" href={path('home', lang)}>
          <div class="avatar" aria-hidden="true">
            <div style="left:3px;top:0;width:24px;height:9px;background:#8b5a2b;border-radius:8px 8px 0 0;"></div>
            <div style="left:6px;top:7px;width:18px;height:13px;background:#f7d3ae;"></div>
            <div style="left:10px;top:12px;width:3px;height:3px;background:#1f1d1a;border:0;"></div>
            <div style="left:18px;top:12px;width:3px;height:3px;background:#1f1d1a;border:0;"></div>
            <div style="left:5px;top:19px;width:20px;height:11px;background:#b5553f;"></div>
          </div>
          <span class="brand-name">tunombre.dev</span>
        </a>

        <div class="sidebar-menu" id="sidebar-menu">
        <p class="intro" set:html={t('sidebar.intro').replace('{name}', `<a href="${path('about', lang)}">Jorge</a>`)} />

        <nav class="nav" aria-label={t('nav.label')}>
          <a href={path('blog', lang)}><PixelIcon name="blog" />{t('nav.blog')}</a>
          <a href={path('projects', lang)}><PixelIcon name="proyectos" />{t('nav.projects')}</a>
          <a href={path('startups', lang)}><PixelIcon name="startups" />{t('nav.startups')}</a>
          <a href={path('academic', lang)}><PixelIcon name="academico" />{t('nav.academic')}</a>
          <a href={path('about', lang)}><PixelIcon name="sobre-mi" />{t('nav.about')}</a>
        </nav>

        <div class="side-map">
          <div class="label-pixel">{t('sidebar.map')}</div>
          <SideMap lang={lang} pathname={Astro.url.pathname} />
        </div>

        <div class="side-foot">
          <button type="button" class="theme-toggle" aria-label={t('sidebar.theme')} title={t('sidebar.theme')}>
            <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          </button>
          <nav class="lang-switch" aria-label={t('sidebar.language')}>
            {alternates.map((a) => (
              <a href={a.href.replace(Astro.site!.origin, '')} hreflang={a.code} lang={a.code} aria-current={a.code === lang ? 'true' : undefined}>
                {a.code.toUpperCase()}
              </a>
            ))}
          </nav>
          <div class="side-links">
            <a href="mailto:jorgecardete@gmail.com" aria-label="Email" title="Email">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
            <a href="https://github.com/Jorgecardetegit" aria-label="GitHub" title="GitHub" rel="me">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/jorgecardetellamas/" aria-label="LinkedIn" title="LinkedIn" rel="me">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://x.com/JorgeCardete" aria-label="X (Twitter)" title="X (Twitter)" rel="me">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41Z"/></svg>
            </a>
            <a href="https://medium.com/@jorgecardete" aria-label="Medium" title="Medium" rel="me">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12Zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42ZM24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12Z"/></svg>
            </a>
          </div>
          <nav class="footer-pages" aria-label={t('footer.pages')}>
            {morePages.map((p) => <a href={p.href} aria-current={p.current ? 'page' : undefined}>{p.label}</a>)}
          </nav>
        </div>
        </div>
      </aside>
      <script>
        // Menú hamburguesa de móvil: abre y cierra el resto de la barra.
        const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
        const sidebar = toggle?.closest('.sidebar');
        const setOpen = (open: boolean) => {
          sidebar?.classList.toggle('is-open', open);
          toggle?.setAttribute('aria-expanded', String(open));
        };
        toggle?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('is-open')));
        document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
      </script>

      <div class="main-col">
        <main class="main">
          <slot />
        </main>
        <footer class="footer">
          <nav class="footer-menu" aria-label={t('footer.social')}>
            <a class="footer-link" href="mailto:jorgecardete@gmail.com">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>Email
            </a>
            <a class="footer-link" href="https://www.linkedin.com/in/jorgecardetellamas/" rel="me">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>LinkedIn
            </a>
            <a class="footer-link" href="https://x.com/JorgeCardete" rel="me">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41Z"/></svg>Twitter
            </a>
          </nav>
          <nav class="footer-buttons" aria-label={t('footer.builtWith')}>
            <a class="footer-button" href="https://github.com/Jorgecardetegit" rel="me">
              <img src="/icons/github.png" alt="" width="20" height="20" />GitHub
            </a>
            <a class="footer-button" href="https://astro.build/">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#bc52ee" d="M8.358 20.162c-1.186-1.07-1.532-3.316-1.038-4.944.856 1.026 2.043 1.352 3.272 1.535 1.897.283 3.76.177 5.522-.678.202-.098.388-.229.608-.36.166.473.209.95.151 1.437-.14 1.185-.738 2.1-1.688 2.794-.38.277-.782.525-1.175.787-1.205.804-1.531 1.747-1.078 3.119l.044.148a3.158 3.158 0 0 1-1.407-1.188 3.31 3.31 0 0 1-.544-1.815c-.004-.32-.004-.642-.048-.958-.106-.769-.472-1.113-1.161-1.133-.707-.02-1.267.411-1.415 1.09-.012.053-.028.104-.045.165h.002z"/><path fill="#1f1d1a" d="M2.397 15.717s3.24-1.575 6.49-1.575l2.451-7.565c.092-.366.36-.614.662-.614.302 0 .57.248.662.614l2.45 7.565c3.85 0 6.491 1.575 6.491 1.575L16.088.727C15.93.285 15.663 0 15.303 0H8.697c-.36 0-.615.285-.784.727l-5.516 14.99z"/></svg>Astro
            </a>
          </nav>
          <div class="footer-made-by" set:html={t('footer.madeWith').replace('{heart}', `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`)} />
        </footer>
      </div>
    </div>
    ) : (
    <div class="wide">
      <a class="wide-brand" href={path('home', lang)}>← tunombre.dev</a>
      <main class="wide-main">
        <slot />
      </main>
    </div>
    )}
  </body>
</html>
