---
import PixelIcon from '../components/PixelIcon.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  sidebar?: boolean;
}

const {
  title,
  description = 'Diseñador y desarrollador. Notas, proyectos y cosas a medio terminar.',
  type = 'website',
  sidebar = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Inicio' ? 'tunombre.dev' : `${title} · tunombre.dev`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Google+Sans+Flex:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    {sidebar ? (
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/">
          <div class="avatar" aria-hidden="true">
            <div style="left:3px;top:0;width:24px;height:9px;background:#8b5a2b;border-radius:8px 8px 0 0;"></div>
            <div style="left:6px;top:7px;width:18px;height:13px;background:#f7d3ae;"></div>
            <div style="left:10px;top:12px;width:3px;height:3px;background:#1f1d1a;border:0;"></div>
            <div style="left:18px;top:12px;width:3px;height:3px;background:#1f1d1a;border:0;"></div>
            <div style="left:5px;top:19px;width:20px;height:11px;background:#b5553f;"></div>
          </div>
          <span class="brand-name">tunombre.dev</span>
        </a>

        <p class="intro">Soy <a href="/sobre-mi/">Jorge</a>, programador y Growth Engineer. Esto es mi jardín digital: notas, proyectos y cosas a medio terminar.</p>

        <nav class="nav" aria-label="Principal">
          <a href="/blog/"><PixelIcon name="blog" />Blog</a>
          <a href="/proyectos/"><PixelIcon name="proyectos" />Proyectos</a>
          <a href="/startups/"><PixelIcon name="startups" />Startups</a>
          <a href="/academico/"><PixelIcon name="academico" />Académico</a>
          <a href="/sobre-mi/"><PixelIcon name="sobre-mi" />Sobre mí</a>
        </nav>

        <div class="side-map">
          <div class="label-pixel">EL MAPA</div>
          <div class="map">
            <div class="island"></div>
            <div class="grass"></div>
            <a class="house" href="/sobre-mi/" title="Sobre mí" style="left:19%;top:26%;"><div style="background:#6b5ea8;"></div></a>
            <a class="house" href="/blog/" title="Blog" style="left:58%;top:22%;"><div style="background:#b5623c;"></div></a>
            <a class="house" href="/proyectos/" title="Proyectos" style="left:24%;top:58%;"><div style="background:#3f6f52;"></div></a>
            <a class="house" href="/startups/" title="Startups" style="left:63%;top:56%;"><div style="background:#c9a227;"></div></a>
            <a class="house" href="/academico/" title="Académico" style="left:43%;top:68%;"><div style="background:#b5553f;"></div></a>
            <div class="plaza"></div>
          </div>
          <div class="map-hint">Pulsa una casa · o <a href="/quest/">juega el mapa entero</a></div>
        </div>

        <div class="side-foot">
          <div class="side-links">
            <a href="mailto:jorgecardete@gmail.com" aria-label="Email" title="Email">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </a>
            <a href="https://github.com/Jorgecardetegit" aria-label="GitHub" title="GitHub" rel="me">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/jorgecardetellamas/" aria-label="LinkedIn" title="LinkedIn" rel="me">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
            </a>
            <a href="https://x.com/JorgeCardete" aria-label="X (Twitter)" title="X (Twitter)" rel="me">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41Z"/></svg>
            </a>
            <a href="https://medium.com/@jorgecardete" aria-label="Medium" title="Medium" rel="me">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12Zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42ZM24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12Z"/></svg>
            </a>
          </div>
        </div>
      </aside>

      <main class="main">
        <slot />
      </main>
    </div>
    ) : (
    <div class="wide">
      <a class="wide-brand" href="/">← tunombre.dev</a>
      <main class="wide-main">
        <slot />
      </main>
    </div>
    )}
  </body>
</html>
