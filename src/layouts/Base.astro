---
import PixelIcon from '../components/PixelIcon.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  sidebar?: boolean;
}

const {
  title,
  description = 'Diseñador y desarrollador. Notas, proyectos y cosas a medio terminar.',
  type = 'website',
  sidebar = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Inicio' ? 'tunombre.dev' : `${title} · tunombre.dev`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Google+Sans+Flex:wght@400;500;600;700&family=Google+Sans+Code:wght@400;500&family=Outfit:wght@600;700&family=JetBrains+Mono:wght@400;500&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    {sidebar ? (
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/">
          <div class="avatar" aria-hidden="true">
            <div style="left:3px;top:0;width:24px;height:9px;background:#8b5a2b;border-radius:8px 8px 0 0;"></div>
            <div style="left:6px;top:7px;width:18px;height:13px;background:#f7d3ae;"></div>
            <div style="left:10px;top:12px;width:3px;height:3px;background:#1f1d1a;border:0;"></div>
            <div style="left:18px;top:12px;width:3px;height:3px;background:#1f1d1a;border:0;"></div>
            <div style="left:5px;top:19px;width:20px;height:11px;background:#b5553f;"></div>
          </div>
          <span class="brand-name">tunombre.dev</span>
        </a>

        <p class="intro">Soy <a href="/sobre-mi/">Jorge</a>, programador y Growth Engineer. Esto es mi jardín digital: notas, proyectos y cosas a medio terminar.</p>

        <nav class="nav" aria-label="Principal">
          <a href="/blog/"><PixelIcon name="blog" />Blog</a>
          <a href="/proyectos/"><PixelIcon name="proyectos" />Proyectos</a>
          <a href="/startups/"><PixelIcon name="startups" />Startups</a>
          <a href="/academico/"><PixelIcon name="academico" />Académico</a>
          <a href="/sobre-mi/"><PixelIcon name="sobre-mi" />Sobre mí</a>
        </nav>

        <div class="side-map">
          <div class="label-pixel">EL MAPA</div>
          <div class="map">
            <div class="island"></div>
            <div class="grass"></div>
            <a class="house" href="/sobre-mi/" title="Sobre mí" style="left:19%;top:26%;"><div style="background:#6b5ea8;"></div></a>
            <a class="house" href="/blog/" title="Blog" style="left:58%;top:22%;"><div style="background:#b5623c;"></div></a>
            <a class="house" href="/proyectos/" title="Proyectos" style="left:24%;top:58%;"><div style="background:#2b9476;"></div></a>
            <a class="house" href="/startups/" title="Startups" style="left:63%;top:56%;"><div style="background:#c9a227;"></div></a>
            <a class="house" href="/academico/" title="Académico" style="left:43%;top:68%;"><div style="background:#b5553f;"></div></a>
            <div class="plaza"></div>
          </div>
          <div class="map-hint">Pulsa una casa · o <a href="/quest/">juega el mapa entero</a></div>
        </div>

        <div class="side-foot">
          <div class="side-links">
            <a href="mailto:jorgecardete@gmail.com" aria-label="Email" title="Email">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
            <a href="https://github.com/Jorgecardetegit" aria-label="GitHub" title="GitHub" rel="me">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/jorgecardetellamas/" aria-label="LinkedIn" title="LinkedIn" rel="me">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://x.com/JorgeCardete" aria-label="X (Twitter)" title="X (Twitter)" rel="me">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41Z"/></svg>
            </a>
            <a href="https://medium.com/@jorgecardete" aria-label="Medium" title="Medium" rel="me">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12Zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42ZM24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12Z"/></svg>
            </a>
          </div>
        </div>
      </aside>

      <div class="main-col">
        <main class="main">
          <slot />
        </main>
        <footer class="footer">
          <nav class="footer-menu">
            <a class="footer-link" href="mailto:jorgecardete@gmail.com"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>Email</a>
            <a class="footer-link" href="https://www.linkedin.com/in/jorgecardetellamas/">LinkedIn</a>
            <a class="footer-link" href="https://x.com/JorgeCardete">X</a>
            <a class="footer-link" href="https://medium.com/@jorgecardete">Medium</a>
            <a class="footer-link" href="https://github.com/Jorgecardetegit">GitHub</a>
          </nav>
          <div class="footer-made-by">Hecho con <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg> por Jorge Cardete</div>
        </footer>
      </div>
    </div>
    ) : (
    <div class="wide">
      <a class="wide-brand" href="/">← tunombre.dev</a>
      <main class="wide-main">
        <slot />
      </main>
    </div>
    )}
  </body>
</html>
