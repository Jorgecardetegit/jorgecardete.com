---
// Panel de Política en España: navegación a la izquierda, contenido en el centro y datos a la
// derecha (slot «aside»). El eje son las elecciones (partidos, diputados, votaciones); la
// teoría («Cómo funciona») queda como referencia plegada.
//
// `view` indica qué pestaña está activa. En la portada las tres primeras son botones que
// cambian de vista sin recargar.
import Base from './Base.astro';
import type { LearnArea } from '../data/learn';
import diputadosData from '../data/politica/diputados.json';
import { partidos } from '../data/politica/partidos';
import { areaPath, lessonPath, readingMinutes, type Lesson } from '../lib/learn';
import { diputadoPath, partidoPath } from '../lib/politica';
import '../styles/aprende.css';

type Mode = 'elecciones' | 'como-funciona' | 'pagina';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  area: LearnArea;
  lessons: Lesson[];
  mode?: Mode;
  /** Pestaña principal activa en páginas de detalle (partido, diputado, lección). */
  section?: 'partidos' | 'temas' | 'historia' | 'gobiernos' | 'economia' | 'diputados' | 'votaciones' | 'votar' | 'como-funciona';
  /** Lección o partido abiertos, para resaltarlos en la navegación. */
  current?: string;
}

const { title, description, jsonLd, area, lessons, mode = 'pagina', section, current } = Astro.props;
const base = areaPath(area.id);
const comoFunciona = `${base}como-funciona/`;

const tabs = [
  { id: 'partidos', label: 'Partidos' },
  { id: 'temas', label: 'Temas' },
  { id: 'historia', label: 'Qué ha pasado' },
  { id: 'gobiernos', label: 'Gobiernos' },
  { id: 'economia', label: 'Economía' },
  { id: 'diputados', label: 'Diputados' },
  { id: 'votaciones', label: 'Votaciones' },
  { id: 'votar', label: 'Cómo votar' },
] as const;

const escanos = new Map<string, number>();
for (const d of diputadosData.diputados) if (d.partido) escanos.set(d.partido, (escanos.get(d.partido) ?? 0) + 1);
const navPartidos = [...partidos].sort((a, b) => (escanos.get(b.id) ?? 0) - (escanos.get(a.id) ?? 0));
const searchLesson = (l: Lesson) => [l.data.title, l.data.description, l.data.summary, ...l.data.keyPoints].join(' ');
const leccionAbierta = lessons.some((l) => l.id === current) || mode === 'como-funciona';
---
<Base title={title} description={description} jsonLd={jsonLd} translated={false} bare>
  <div class="ap" style={`--accent: ${area.color}`}>
    <aside class="ap-left ap-panel" data-ap-left>
      <header class="ap-brand">
        <a class="ap-logo" href={base} aria-hidden="true" tabindex="-1">{area.icon}</a>
        <div class="ap-brand-text">
          <a class="ap-title" href={base}>{area.title}</a>
          <a class="ap-home" href="/">jorge.dev · aprende</a>
        </div>
        <button type="button" class="ap-menu" aria-expanded="false" data-ap-menu>Menú</button>
      </header>
      <p class="ap-desc">Todo lo que necesitas para votar el 29 de noviembre: quién es quién, qué ha votado cada uno y cómo funciona el sistema.</p>
      <label class="ap-search">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" placeholder="Busca un partido, diputado o tema" aria-label="Buscar" data-ap-search />
      </label>

      <div class="ap-left-scroll">
        <nav aria-label="Secciones">
          <div class="ap-sec" data-sec>
            <div class="ap-sec-title">Partidos <span class="ap-count">{partidos.length}</span></div>
            <ol class="ap-list ap-list-parties">
              {navPartidos.map((p) => (
                <li data-search={`${p.siglas} ${p.nombre} ${p.lider.nombre} ${p.ambito}`}>
                  <a href={partidoPath(p.id)} aria-current={p.id === current ? 'page' : undefined}>
                    <span class="ap-swatch" style={`background: ${p.color}`} aria-hidden="true" />
                    <span class="ap-lt">{p.siglas === p.nombre ? p.nombre : `${p.siglas} · ${p.nombre}`}</span>
                    <span class="ap-min" title="Diputados al disolverse las Cortes">{escanos.get(p.id) ?? '—'}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>

          <div class="ap-sec ap-sec-results" data-sec hidden data-ap-deputies>
            <div class="ap-sec-title">Diputados</div>
            <ol class="ap-list ap-list-parties">
              {diputadosData.diputados.map((d) => (
                <li data-search={`${d.nombre} ${d.provincia}`} hidden>
                  <a href={diputadoPath(d.id)}>
                    <span class="ap-swatch" style={`background: ${partidos.find((p) => p.id === d.partido)?.color ?? 'var(--muted)'}`} aria-hidden="true" />
                    <span class="ap-lt">{d.nombre}</span>
                    <span class="ap-min">{d.provincia}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>


          <details class="ap-sec ap-theory" data-sec open={leccionAbierta}>
            <summary class="ap-sec-title">Cómo funciona <span class="ap-count">{lessons.length} lecciones</span></summary>
            <ol class="ap-list">
              <li data-search="quien elige a quien esquema poderes instituciones como funciona">
                <a href={comoFunciona} aria-current={mode === 'como-funciona' ? 'page' : undefined}>
                  <span class="ap-dot" aria-hidden="true" />
                  <span class="ap-num" aria-hidden="true">🧭</span>
                  <span class="ap-lt">Quién elige a quién (esquema)</span>
                </a>
              </li>
              {lessons.map((lesson, i) => (
                <li data-search={searchLesson(lesson)}>
                  <a href={lessonPath(lesson)} aria-current={lesson.id === current ? 'page' : undefined} data-lesson-link={lesson.id}>
                    <span class="ap-dot" aria-hidden="true" />
                    <span class="ap-num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="ap-lt">{lesson.data.title}</span>
                    <span class="ap-min">{readingMinutes(lesson)}′</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
          <p class="ap-noresults" hidden data-ap-noresults>Nada coincide con eso.</p>
        </nav>
      </div>

      <footer class="ap-foot">
        <div class="ap-progress">
          <span><strong data-ap-read>0</strong> de {lessons.length} lecciones leídas</span>
          <span class="ap-bar"><i data-ap-bar /></span>
        </div>
        <div class="ap-foot-row">
          <a href="/">← jorge.dev</a>
          <button type="button" class="theme-toggle" aria-label="Cambiar entre modo claro y oscuro" title="Cambiar entre modo claro y oscuro">
            <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          </button>
        </div>
      </footer>
    </aside>

    <main class="ap-main">
      <nav class="ap-top" aria-label="Vistas">
        {tabs.map((t, i) =>
          mode === 'elecciones' ? (
            <button type="button" class="ap-tab" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-view-tab={t.id}>{t.label}</button>
          ) : (
            <a class="ap-tab" href={`${base}#${t.id}`} aria-current={section === t.id ? 'page' : undefined}>{t.label}</a>
          ),
        )}
        <a class="ap-countdown" href={`${base}#votar`} data-ap-countdown>Elecciones generales: <strong>29 de noviembre de 2026</strong> · cómo votar</a>
      </nav>
      <slot />
    </main>

    <aside class="ap-right" aria-label="Datos">
      <slot name="aside" />
    </aside>
  </div>
</Base>

<script>
  import { readLessons } from '../lib/learn-progress';

  // Lecciones leídas: punto verde en la lista, contador y barra.
  const read = readLessons();
  const links = [...document.querySelectorAll<HTMLElement>('[data-lesson-link]')];
  for (const a of links) a.classList.toggle('is-read', read.has(a.dataset.lessonLink!));
  for (const chip of document.querySelectorAll<HTMLElement>('[data-lesson-chip]')) {
    chip.classList.toggle('is-read', read.has(chip.dataset.lessonChip!));
  }
  const done = links.filter((a) => a.classList.contains('is-read')).length;
  document.querySelector('[data-ap-read]')!.textContent = String(done);
  document.querySelector<HTMLElement>('[data-ap-bar]')!.style.width = `${links.length ? (done / links.length) * 100 : 0}%`;

  // Buscador: filtra partidos y lecciones, y muestra los diputados que coinciden.
  const search = document.querySelector<HTMLInputElement>('[data-ap-search]')!;
  const sections = [...document.querySelectorAll<HTMLElement>('[data-sec]')];
  const deputies = document.querySelector<HTMLElement>('[data-ap-deputies]')!;
  const empty = document.querySelector<HTMLElement>('[data-ap-noresults]')!;
  const normalize = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();
  const theory = document.querySelector<HTMLDetailsElement>('.ap-theory');
  const theoryOpen = theory?.open ?? false;
  search.addEventListener('input', () => {
    const q = normalize(search.value);
    let shown = 0;
    for (const sec of sections) {
      const items = [...sec.querySelectorAll<HTMLElement>('[data-search]')];
      let visible = 0;
      for (const li of items) {
        const match = q !== '' && normalize(li.dataset.search!).includes(q);
        // Los diputados solo aparecen al buscar; el resto se ve siempre que no haya búsqueda.
        li.hidden = sec === deputies ? !match || visible >= 12 : q !== '' && !match;
        if (!li.hidden) visible++;
      }
      sec.hidden = q !== '' && (items.length === 0 || visible === 0);
      if (sec === deputies && q === '') sec.hidden = true;
      shown += visible;
    }
    if (theory) theory.open = q !== '' ? true : theoryOpen;
    empty.hidden = q === '' || shown > 0;
  });

  // Cuenta atrás hasta el 29 de noviembre de 2026 (hora peninsular).
  const countdown = document.querySelector('[data-ap-countdown]')!;
  const days = Math.ceil((new Date('2026-11-29T09:00:00+01:00').getTime() - Date.now()) / 86_400_000);
  if (days > 1) countdown.innerHTML = `29-N: faltan <strong>${days} días</strong> · cómo votar`;
  else if (days === 1) countdown.innerHTML = '29-N: <strong>mañana</strong> · cómo votar';
  else if (days === 0) countdown.innerHTML = '29-N: <strong>hoy</strong> · cómo votar';

  // Móvil: la navegación se abre y cierra con un botón.
  const left = document.querySelector<HTMLElement>('[data-ap-left]')!;
  const menu = document.querySelector<HTMLButtonElement>('[data-ap-menu]')!;
  menu.addEventListener('click', () => {
    const open = !left.classList.contains('is-open');
    left.classList.toggle('is-open', open);
    menu.setAttribute('aria-expanded', String(open));
  });
</script>
